// studio.matrix
// AppStudio CLI entry — routes subcommands to focused modules in cli/.

import "frameworks/studio/ClientJS" as clientjs;
import "core/tools/FlatKit" as flatkit;
import "core/cli/Args" as args_cli;
import "core/cli/Fs" as fs;
import "core/cli/Exec" as ex;
import "core/cli/Manifest" as man;
import "core/cli/New" as c_new;
import "core/cli/RunDev" as c_run;
import "core/cli/Doctor" as c_doc;
import "core/cli/Dx" as c_dx;
import "core/cli/DevWeb" as c_dev_web;
import "core/cli/IosToolchain" as c_ios;
import "core/cli/BuildWeb" as b_web;
import "core/cli/BuildDesktop" as b_desk;
import "core/cli/BuildAndroid" as b_and;
import "core/cli/BuildIos" as b_ios;

fn cmd_build(appdir: string, target: string, outdir: string, release: bool = false) -> int {
    let entry = man.find_entry(appdir);
    if entry == "" {
        println("error: no app entry found in " + appdir);
        return 2;
    }
    let t = target;
    if t == "" {
        t = "web";
    }
    let out = outdir;
    if out == "" {
        out = fs.join_dir(appdir, "build");
    } else {
        out = fs.trim_slash(out);
    }
    fs.ensure_dir(out);

    if t == "desktop" {
        return b_desk.build(appdir, entry, out + "/desktop", release);
    }
    if t != "web" and t != "wasm" and t != "android" and t != "ios" {
        println("error: unknown target '" + t + "' (web | android | ios | desktop)");
        return 2;
    }

    let flat = flatkit.bundle(appdir);
    if flat == "" {
        let ferr = flatkit.last_error();
        if ferr != "" {
            println("error: flattening the app failed: " + ferr);
        } else {
            println("error: flattening the app failed (is studio/ complete?)");
        }
        return 1;
    }
    let lmap = flatkit.line_map();
    let cjs = clientjs.runtime_js();

    if t == "web" or t == "wasm" {
        let rc = b_web.build(appdir, out + "/web", flat, cjs, release);
        if rc == 0 and not release {
            let _lm = b_web.emit_line_map(out + "/web", lmap);
        }
        return rc;
    }
    if t == "android" {
        return b_and.build(appdir, out + "/android", flat, cjs, release);
    }
    return b_ios.build(appdir, out + "/ios", flat, cjs, release);
}

fn main() -> int {
    let cli = args();
    if cli.len() == 0 {
        args_cli.usage();
        return 0;
    }
    let cmd = string(cli[0]);
    let rest = [];
    let i = 1;
    while i < cli.len() {
        rest.push(cli[i]);
        i += 1;
    }

    if cmd == "help" or cmd == "--help" or cmd == "-h" {
        args_cli.usage();
        return 0;
    }
    if cmd == "gui" {
        fs.setup_import_path();
        let g_root = fs.abs_path(fs.fw_root());
        let g_entry = fs.abs_path(fs.join_dir(fs.fw_root(), "core/gui/main.matrix"));
        let g_host = fs.abs_path(fs.join_dir(fs.fw_root(), "core/gui/host.html"));
        let extra = if rest.len() > 0 {
            string(rest[0]).trim()
        } else {
            ""
        };
        if fs.is_windows() {
            let ps_args = "@('gui','" + g_entry.replace("'", "''") + "','--html','"
            + g_host.replace("'", "''") + "'";
            if extra != "" {
                ps_args += ",'" + extra.replace("'", "''") + "'";
            }
            ps_args += ")";
            let ps_cmd = "Start-Process -FilePath 'spid3r' -ArgumentList " + ps_args
            + " -WorkingDirectory '" + g_root.replace("'", "''") + "' -WindowStyle Hidden";
            let gr = exec_capture("powershell", ["-NoProfile", "-Command", ps_cmd], null);
            if gr.is_err() or int(gr.unwrap()["code"]) != 0 {
                if gr.is_ok() {
                    ex.flush_child_output(gr.unwrap());
                }
                println("error: failed to launch AppStudio Control Center");
                return 1;
            }
            println("AppStudio Control Center launched.");
            return 0;
        }
        let sh_cmd = "nohup spid3r gui " + fs.sh_quote(g_entry) + " --html " + fs.sh_quote(g_host);
        if extra != "" {
            sh_cmd += " " + fs.sh_quote(extra);
        }
        sh_cmd += " >/dev/null 2>&1 &";
        exec_capture("bash", ["-lc", sh_cmd], g_root);
        println("AppStudio Control Center launched.");
        return 0;
    }
    if cmd == "new" {
        let name = "";
        let outdir = "";
        if rest.len() > 0 {
            name = string(rest[0]);
        }
        if rest.len() > 1 {
            outdir = string(rest[1]);
        }
        return c_new.cmd_new(name, outdir);
    }
    if cmd == "run" {
        if rest.len() == 0 {
            println("error: run requires an app directory");
            return 2;
        }
        return c_run.cmd_run(
            string(rest[0]),
            args_cli.arg_value(rest, "--engine"),
            args_cli.has_flag(rest, "--devtools")
        );
    }
    if cmd == "dev" {
        if rest.len() == 0 {
            println("error: dev requires an app directory");
            return 2;
        }
        let appdir = string(rest[0]);
        let dev_target = args_cli.arg_value(rest, "--target");
        if dev_target == "web" or dev_target == "wasm" {
            let host = args_cli.arg_value(rest, "--host");
            let port = args_cli.arg_value(rest, "--port");
            let once = args_cli.has_flag(rest, "--once");
            return c_dev_web.cmd_dev_web(
                appdir,
                host,
                port,
                once,
                () => cmd_build(appdir, "web", "")
            );
        }
        if dev_target == "ios" {
            return c_ios.cmd_ios_run(appdir, () => cmd_build(appdir, "ios", ""));
        }
        return c_run.cmd_dev(
            appdir,
            args_cli.arg_value(rest, "--engine"),
            args_cli.has_flag(rest, "--devtools")
        );
    }
    if cmd == "ios" {
        return c_ios.cmd_ios(rest, (ad) => cmd_build(ad, "ios", ""));
    }
    if cmd == "test" {
        return c_dx.cmd_test(rest);
    }
    if cmd == "clean" {
        return c_dx.cmd_clean(rest);
    }
    if cmd == "upgrade" {
        if rest.len() == 0 {
            println("error: upgrade requires an app directory");
            return 2;
        }
        return c_dx.cmd_upgrade(string(rest[0]));
    }
    if cmd == "check" {
        if rest.len() == 0 {
            println("error: check requires an app directory");
            return 2;
        }
        return c_run.cmd_check(string(rest[0]));
    }
    if cmd == "doctor" {
        return c_doc.cmd_doctor();
    }
    if cmd == "build" {
        if rest.len() == 0 {
            println("error: build requires an app directory");
            return 2;
        }
        return cmd_build(
            string(rest[0]),
            args_cli.arg_value(rest, "--target"),
            args_cli.arg_value(rest, "-o"),
            args_cli.has_flag(rest, "--release")
        );
    }
    println("error: unknown command '" + cmd + "'");
    args_cli.usage();
    return 2;
}
