// cli/IosToolchain.matrix
// Managed xtool (1.24.0) toolchain installer, WSL2 bridge, and iOS device commands.

import "Fs" as fs;
import "Exec" as ex;
import "Manifest" as man;

const XTOOL_VERSION = "1.24.0";
const XTOOL_URL_X64 = "https://github.com/xtool-org/xtool/releases/download/1.24.0/xtool-x86_64.AppImage";
const XTOOL_URL_ARM64 = "https://github.com/xtool-org/xtool/releases/download/1.24.0/xtool-aarch64.AppImage";

public fn win_to_wsl_path(p: string) -> string {
    let ap = fs.abs_path(p);
    if fs.is_windows() and ap.len() >= 2 and ap[1] == ":" {
        let drv = string(ap[0]).lower();
        let rest = "";
        if ap.len() > 2 {
            if ap[2] == "/" {
                rest = ap.slice(3, ap.len());
            } else {
                rest = ap.slice(2, ap.len());
            }
        }
        return "/mnt/" + drv + "/" + rest;
    }
    return ap;
}

fn sh_quote(s: string) -> string {
    return "'" + string(s).replace("'", "'\"'\"'") + "'";
}

public fn managed_dir() -> string {
    return fs.join_dir(fs.abs_path(fs.fw_root()), ".studio-cache/xtool/" + XTOOL_VERSION);
}

public fn managed_apprun() -> string {
    return fs.join_dir(managed_dir(), "squashfs-root/AppRun");
}

public fn managed_appimage() -> string {
    return fs.join_dir(managed_dir(), "xtool.AppImage");
}

public fn has_wsl() -> bool {
    if not fs.is_windows() {
        return false;
    }
    let r = exec_capture("wsl", ["-e", "true"], null);
    if r.is_err() {
        return false;
    }
    return int(r.unwrap()["code"]) == 0;
}

fn run_bash(cmd: string) -> map {
    let prefix = "if [ -d \"$HOME/.local/share/swiftly/bin\" ]; then PATH=\"$HOME/.local/share/swiftly/bin:$PATH\"; fi; "
    + "if [ -d \"$HOME/.local/bin\" ]; then PATH=\"$HOME/.local/bin:$PATH\"; fi; export PATH; ";
    let full = prefix + cmd;
    let r = null;
    if fs.is_windows() {
        r = exec_capture("wsl", ["-e", "bash", "-lc", full], null);
    } else {
        r = exec_capture("bash", ["-lc", full], null);
    }
    if r.is_err() {
        return {
            "code": 1, "stdout": "", "stderr": string(r.unwrap_err())
        };
    }
    return r.unwrap();
}

fn resolve_xtool_cmd() -> string {
    if ex.probe_version("xtool", ["--version"]) != "" {
        return "native:xtool";
    }
    let apprun = managed_apprun();
    if file_exists(apprun) {
        if fs.is_windows() {
            if has_wsl() {
                return "wsl:" + win_to_wsl_path(apprun);
            }
        } else {
            return "local:" + apprun;
        }
    }
    let appimg = managed_appimage();
    if file_exists(appimg) {
        if fs.is_windows() {
            if has_wsl() {
                return "wsl-appimage:" + win_to_wsl_path(appimg);
            }
        } else {
            return "local-appimage:" + appimg;
        }
    }
    if fs.is_windows() and has_wsl() {
        let rm = run_bash("command -v xtool || command -v \"$HOME/.local/bin/xtool\" || true");
        if int(rm["code"]) == 0 {
            let found = string(rm["stdout"]).trim();
            if found != "" {
                return "wsl:" + found;
            }
        }
    }
    return "";
}

fn exec_xtool_capture(cwd_win: string, x_args: list) -> map {
    let spec = resolve_xtool_cmd();
    if spec == "" {
        return {
            "code": 127, "stdout": "", "stderr": "xtool not found"
        };
    }
    if spec == "native:xtool" {
        let r = exec_capture("xtool", x_args, cwd_win);
        if r.is_err() {
            return {
                "code": 1, "stdout": "", "stderr": string(r.unwrap_err())
            };
        }
        return r.unwrap();
    }
    if spec.starts_with("local:") {
        let bin = spec.slice(6, spec.len());
        let r2 = exec_capture(bin, x_args, cwd_win);
        if r2.is_err() {
            return {
                "code": 1, "stdout": "", "stderr": string(r2.unwrap_err())
            };
        }
        return r2.unwrap();
    }
    let args_s = "";
    for a in x_args {
        args_s += " " + sh_quote(string(a));
    }
    let dir_s = if fs.is_windows() {
        win_to_wsl_path(cwd_win)
    } else {
        fs.abs_path(cwd_win)
    };
    if spec.starts_with("wsl-appimage:") {
        let wbin = spec.slice(13, spec.len());
        return run_bash(
            "cd " + sh_quote(dir_s) + " && APPIMAGE_EXTRACT_AND_RUN=1 " + sh_quote(wbin) + args_s
        );
    }
    if spec.starts_with("local-appimage:") {
        let lbin = spec.slice(15, spec.len());
        return run_bash(
            "cd " + sh_quote(dir_s) + " && APPIMAGE_EXTRACT_AND_RUN=1 " + sh_quote(lbin) + args_s
        );
    }
    let cmd_path = spec.slice(4, spec.len());
    return run_bash("cd " + sh_quote(dir_s) + " && " + sh_quote(cmd_path) + args_s);
}

fn run_xtool(cwd_win: string, x_args: list) -> int {
    let spec = resolve_xtool_cmd();
    if spec == "" {
        println(
            "error: xtool not found. Install it with: spid3r run studio.matrix ios install-tools"
        );
        return 1;
    }
    let m = exec_xtool_capture(cwd_win, x_args);
    ex.flush_child_output(m);
    return int(m["code"]);
}

fn first_non_empty_line(s: string) -> string {
    for row in string(s).split("\n") {
        let t = string(row).trim();
        if t != "" {
            return t;
        }
    }
    return "";
}

public fn probe_xtool_status() -> string {
    let spec = resolve_xtool_cmd();
    if spec == "" {
        return "";
    }
    let m = exec_xtool_capture(".", ["--version"]);
    if int(m["code"]) != 0 {
        return "";
    }
    let ver = first_non_empty_line(string(m["stdout"]));
    if ver == "" {
        ver = first_non_empty_line(string(m["stderr"]));
    }
    if ver == "" {
        ver = XTOOL_VERSION;
    }
    if spec.contains(".studio-cache/xtool/") {
        return ver + " (managed .studio-cache/xtool)";
    }
    if spec.starts_with("wsl") {
        return ver + " (WSL)";
    }
    return ver;
}

public fn probe_swift_wsl_status() -> string {
    let sw = run_bash("swift --version 2>/dev/null | head -n 1 || true");
    return first_non_empty_line(string(sw["stdout"]));
}

public fn probe_darwin_sdk_status() -> string {
    let sdks = run_bash("swift sdk list 2>/dev/null || true");
    let sdk_s = string(sdks["stdout"]).trim();
    if sdk_s == "" or sdk_s.contains("No Swift SDKs") {
        return "";
    }
    return first_non_empty_line(sdk_s);
}

public fn usage() {
    println("AppStudio iOS Toolchain Manager (xtool " + XTOOL_VERSION + ")");
    println("");
    println("Usage: spid3r run studio.matrix ios <subcommand>");
    println("");
    println("Subcommands:");
    println("  install-tools               Download & cache xtool AppImage into .studio-cache/xtool");
    println("  sdk-install <Xcode.xip>     Install Darwin iOS Swift SDK from Xcode.xip");
    println("  status                      Check xtool, WSL, Swift SDK, usbmuxd, and USB status");
    println("  setup [path/to/Xcode.xip]   Show/prepare interactive xtool setup command");
    println("  devices                     List connected iOS devices (and Windows usbipd)");
    println("  run <appdir>                Build, sign & install .ipa onto connected iPhone");
    println("  install <appdir>            Build, sign & install .ipa onto connected iPhone");
    println("  uninstall <appdir>          Uninstall app by bundleID from connected iPhone");
    println("  launch <appdir>             Launch installed app on connected iPhone");
    println("  help                        This message");
}

public fn cmd_install_tools() -> int {
    if fs.is_windows() and not has_wsl() {
        println("error: WSL2 is required on Windows to run xtool.");
        println("Install Ubuntu on WSL first:  wsl --install -d Ubuntu");
        return 1;
    }

    let arch_m = run_bash("uname -m");
    let arch = first_non_empty_line(string(arch_m["stdout"]));
    let url = if arch == "aarch64" or arch == "arm64" {
        XTOOL_URL_ARM64
    } else {
        XTOOL_URL_X64
    };

    let mdir = managed_dir();
    fs.ensure_dir(fs.join_dir(fs.abs_path(fs.fw_root()), ".studio-cache"));
    fs.ensure_dir(fs.join_dir(fs.abs_path(fs.fw_root()), ".studio-cache/xtool"));
    fs.ensure_dir(mdir);

    let appimg = managed_appimage();
    let wdir = if fs.is_windows() {
        win_to_wsl_path(mdir)
    } else {
        fs.abs_path(mdir)
    };
    let wapp = if fs.is_windows() {
        win_to_wsl_path(appimg)
    } else {
        fs.abs_path(appimg)
    };

    if not file_exists(appimg) or file_size(appimg) < 1000000 {
        println("downloading xtool " + XTOOL_VERSION + " (" + arch + ") -> " + appimg);
        let dl = run_bash("curl -fL " + sh_quote(url) + " -o " + sh_quote(wapp));
        if int(dl["code"]) != 0 {
            ex.flush_child_output(dl);
            println("error: failed to download xtool " + XTOOL_VERSION);
            return 1;
        }
    } else {
        println("using cached xtool AppImage: " + appimg);
    }

    let apprun = managed_apprun();
    if not file_exists(apprun) {
        println("extracting AppImage for FUSE-free execution...");
        let ex_r = run_bash(
            "chmod +x " + sh_quote(wapp) + " && cd " + sh_quote(wdir) + " && ./xtool.AppImage --appimage-extract >/dev/null"
        );
        if int(ex_r["code"]) != 0 {
            ex.flush_child_output(ex_r);
            println("warning: --appimage-extract failed; will run via APPIMAGE_EXTRACT_AND_RUN=1");
        }
    }

    let st = probe_xtool_status();
    if st == "" {
        println("error: xtool installed in cache but failed --version probe.");
        return 1;
    }
    println("[ok] xtool ready: " + st);
    println("");
    return cmd_status();
}

public fn cmd_status() -> int {
    println("AppStudio iOS Toolchain Status");
    println("------------------------------");

    let win = fs.is_windows();
    if win {
        if has_wsl() {
            println("[ok] WSL2         available");
        } else {
            println("[x] WSL2          not found (run: wsl --install -d Ubuntu)");
            return 0;
        }
    }

    let xt = probe_xtool_status();
    if xt == "" {
        println("[!] xtool         not installed");
        println("    run: spid3r run studio.matrix ios install-tools");
    } else {
        println("[ok] xtool        " + xt);
    }

    let sw_v = probe_swift_wsl_status();
    if sw_v == "" {
        println(
            "[!] swift (WSL)   not found (install via swiftly: https://www.swift.org/install/linux/)"
        );
    } else {
        println("[ok] swift (WSL)  " + sw_v);
        let sdk_v = probe_darwin_sdk_status();
        if sdk_v == "" {
            println("[!] Darwin SDK    not configured yet (run: spid3r run studio.matrix ios setup)");
        } else {
            println("[ok] Swift SDKs   " + sdk_v);
        }
    }

    let um = run_bash("command -v usbmuxd || true");
    if first_non_empty_line(string(um["stdout"])) == "" {
        println(
            "[!] usbmuxd       not found in WSL (install: sudo apt install -y usbmuxd libimobiledevice-utils)"
        );
    } else {
        println("[ok] usbmuxd      " + first_non_empty_line(string(um["stdout"])));
    }

    if win {
        let uip = ex.probe_version("usbipd", ["--version"]);
        if uip == "" {
            println(
                "[!] usbipd (Win)  not found (install: winget install --exact dorssel.usbipd-win)"
            );
        } else {
            println("[ok] usbipd (Win) " + uip);
        }
    }
    return 0;
}

public fn cmd_devices() -> int {
    if fs.is_windows() {
        let u = exec_capture("usbipd", ["list"], null);
        if u.is_ok() and int(u.unwrap()["code"]) == 0 {
            println("=== Windows USB Devices (usbipd list) ===");
            ex.flush_child_output(u.unwrap());
            println("");
        }
    }
    println("=== Connected iOS Devices (xtool devices) ===");
    let xt = resolve_xtool_cmd();
    if xt != "" and xt != "native:xtool" {
        let sock = run_bash("test -S /var/run/usbmuxd && echo ok || true");
        if first_non_empty_line(string(sock["stdout"])) != "ok" {
            if fs.is_windows() {
                println(
                    "usbmuxd daemon is not running in WSL yet. Start it with: wsl -u root usbmuxd"
                );
            } else {
                println("usbmuxd daemon is not running yet. Start it with: sudo usbmuxd");
            }
            return 0;
        }
    }
    return run_xtool(".", ["devices"]);
}

public fn cmd_setup(rest: list) -> int {
    let xt = resolve_xtool_cmd();
    if xt == "" {
        println("xtool is not installed yet. Run first:");
        println("  spid3r run studio.matrix ios install-tools");
        return 1;
    }
    let prefix_env = "";
    let raw_bin = managed_apprun();
    if xt == "native:xtool" {
        raw_bin = "xtool";
    } elif xt.starts_with("wsl:") {
        raw_bin = xt.slice(4, xt.len());
    } elif xt.starts_with("wsl-appimage:") {
        prefix_env = "APPIMAGE_EXTRACT_AND_RUN=1 ";
        raw_bin = xt.slice(13, xt.len());
    } elif xt.starts_with("local:") {
        let lp = xt.slice(6, xt.len());
        raw_bin = if fs.is_windows() {
            win_to_wsl_path(lp)
        } else {
            lp
        };
    } elif xt.starts_with("local-appimage:") {
        prefix_env = "APPIMAGE_EXTRACT_AND_RUN=1 ";
        let la = xt.slice(15, xt.len());
        raw_bin = if fs.is_windows() {
            win_to_wsl_path(la)
        } else {
            la
        };
    }
    let bin = prefix_env + (if raw_bin.contains(" ") {
        sh_quote(raw_bin)
    } else {
        raw_bin
    });
    println("Interactive Apple ID + Xcode.xip setup must run in a live terminal prompt.");
    if fs.is_windows() {
        println("Run inside WSL Ubuntu:");
        if rest.len() > 0 and string(rest[0]).trim() != "" {
            println("  Xcode.xip WSL path: " + win_to_wsl_path(string(rest[0])));
        } else {
            println("  (Download Xcode.xip from https://developer.apple.com/download/all/?q=Xcode)");
        }
        println("  wsl -e bash -lc " + sh_quote(bin + " setup"));
    } else {
        println("Run in your shell:");
        println("  " + bin + " setup");
    }
    return 0;
}

fn ios_pkg_dir(appdir: string) -> string {
    let clean = fs.trim_slash(appdir);
    let name = man.app_name_of(clean);
    let swift_name = fs.sanitize_swift_ident(name);
    return fs.join_dir(clean, "build/ios/" + swift_name);
}

public fn cmd_sdk_install(rest: list) -> int {
    if rest.len() == 0 or string(rest[0]).trim() == "" {
        println("error: ios sdk-install requires <path/to/Xcode.xip>");
        return 2;
    }
    let raw_p = string(rest[0]).trim();
    if not file_exists(raw_p) and not is_dir(raw_p) {
        println("error: path not found: " + raw_p);
        return 2;
    }
    let wpath = if fs.is_windows() {
        win_to_wsl_path(raw_p)
    } else {
        fs.abs_path(raw_p)
    };
    println("installing Darwin SDK from " + raw_p + "...");
    let rc = run_xtool(".", ["sdk", "install", wpath]);
    if rc == 0 {
        let sdk_v = probe_darwin_sdk_status();
        if sdk_v != "" {
            println("[ok] Swift SDK ready: " + sdk_v);
        }
    }
    return rc;
}

public fn cmd_ios_run(appdir: string, build_ios_fn) -> int {
    let clean = fs.trim_slash(appdir);
    let rc = build_ios_fn();
    if rc != 0 {
        return rc;
    }
    let pkg = ios_pkg_dir(clean);
    if not is_dir(pkg) {
        println("error: expected iOS package not found at " + pkg);
        return 1;
    }
    if fs.is_windows() {
        let name = man.app_name_of(clean);
        let swift_name = fs.sanitize_swift_ident(name);
        let installer = fs.join_dir(fs.abs_path(fs.fw_root()), "tools/ios_install_ipa.py");
        println("building & signing " + swift_name + ".ipa via xtool...");
        let brc = run_xtool(pkg, ["dev", "build", "--sign", "--ipa"]);
        if brc != 0 {
            return brc;
        }
        let ipa = fs.join_dir(fs.abs_path(pkg), "xtool/" + swift_name + ".ipa");
        if file_exists(ipa) and file_exists(installer) {
            let sock = run_bash("test -S /var/run/usbmuxd && echo ok || true");
            if first_non_empty_line(string(sock["stdout"])) != "ok" {
                exec_capture("wsl", ["-u", "root", "usbmuxd"], null);
                sleep_ms(1000);
            }
            let inst_r = run_bash(
                "python3 " + sh_quote(win_to_wsl_path(installer)) + " " + sh_quote(win_to_wsl_path(ipa))
            );
            ex.flush_child_output(inst_r);
            return int(inst_r["code"]);
        }
    }
    println("deploying " + man.app_name_of(clean) + " to connected iPhone via xtool dev...");
    return run_xtool(pkg, ["dev"]);
}

public fn cmd_ios(rest: list, build_ios_fn_for_dir) -> int {
    if rest.len() == 0 {
        usage();
        return 0;
    }
    let sub = string(rest[0]);
    let sub_rest = [];
    let i = 1;
    while i < rest.len() {
        sub_rest.push(rest[i]);
        i += 1;
    }

    if sub == "help" or sub == "--help" or sub == "-h" {
        usage();
        return 0;
    }
    if sub == "install-tools" {
        return cmd_install_tools();
    }
    if sub == "sdk-install" {
        return cmd_sdk_install(sub_rest);
    }
    if sub == "status" {
        return cmd_status();
    }
    if sub == "devices" {
        return cmd_devices();
    }
    if sub == "setup" {
        return cmd_setup(sub_rest);
    }
    if sub == "run" or sub == "dev" {
        if sub_rest.len() == 0 {
            println("error: ios " + sub + " requires <appdir>");
            return 2;
        }
        let ad = string(sub_rest[0]);
        return cmd_ios_run(ad, () => build_ios_fn_for_dir(ad));
    }
    if sub == "install" {
        if sub_rest.len() == 0 {
            println("error: ios install requires <appdir>");
            return 2;
        }
        let ad = string(sub_rest[0]);
        return cmd_ios_run(ad, () => build_ios_fn_for_dir(ad));
    }
    if sub == "uninstall" or sub == "launch" {
        if sub_rest.len() == 0 {
            println("error: ios " + sub + " requires <appdir>");
            return 2;
        }
        let ad = string(sub_rest[0]);
        let bid = man.app_bundle_id_of(fs.trim_slash(ad));
        return run_xtool(".", [sub, bid]);
    }

    println("error: unknown ios subcommand '" + sub + "'");
    usage();
    return 2;
}
