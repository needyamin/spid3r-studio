// cli/Fs.matrix
// Cross-platform filesystem, path, escaping, template, and source-signature helpers.

public fn is_windows() -> bool {
    let wd = env("WINDIR");
    if string(wd) != "none" {
        return true;
    }
    let os_v = env("OS");
    if string(os_v) != "none" and string(os_v.unwrap()).lower().contains("windows") {
        return true;
    }
    return false;
}

public fn trim_slash(p: string) -> string {
    let t = string(p).replace("\\", "/");
    while t.len() > 1 and t.ends_with("/") {
        t = t.slice(0, t.len() - 1);
    }
    return t;
}

public fn is_abs_path(p: string) -> bool {
    let t = trim_slash(p);
    if t.starts_with("/") {
        return true;
    }
    if t.len() >= 2 and t[1] == ":" {
        return true;
    }
    return false;
}

public fn base_name(p: string) -> string {
    let t = trim_slash(p);
    let parts = t.split("/");
    if parts.len() == 0 {
        return t;
    }
    return parts[parts.len() - 1];
}

public fn dir_name(p: string) -> string {
    let t = trim_slash(p);
    let b = string(base_name(t));
    if t.len() <= b.len() + 1 {
        if t.starts_with("/") {
            return "/";
        }
        return ".";
    }
    return t.slice(0, t.len() - b.len() - 1);
}

public fn join_dir(a: string, b: string) -> string {
    let ta = trim_slash(a);
    if ta == "" or ta == "." {
        return trim_slash(b);
    }
    if ta == "/" {
        return "/" + b;
    }
    return ta + "/" + b;
}

public fn str_find_from(s: string, needle: string, from: int) -> int {
    let n = s.len();
    let nl = needle.len();
    if nl == 0 or nl > n {
        return -1;
    }
    let i = from;
    while i <= n - nl {
        if s.slice(i, i + nl) == needle {
            return i;
        }
        i += 1;
    }
    return -1;
}

/// Framework root: APPSTUDIO_HOME env var, or nearest directory containing studio/App.matrix.
public fn fw_root() -> string {
    let eh = env("APPSTUDIO_HOME");
    if string(eh) != "none" {
        let hp = trim_slash(string(eh.unwrap()));
        if file_exists(join_dir(hp, "studio/App.matrix")) {
            return hp;
        }
    }
    for cand in [".", "..", "../.."] {
        if file_exists(join_dir(cand, "studio/App.matrix")) {
            return cand;
        }
    }
    return ".";
}

public fn abs_path(p: string) -> string {
    let t = trim_slash(p);
    if is_abs_path(t) {
        return t;
    }
    let c = cwd();
    if string(c) == "none" {
        return t;
    }
    let base = trim_slash(string(c.unwrap()));
    if t == "." or t == "" {
        return base;
    }
    return join_dir(base, t);
}

public fn file_ext(path: string) -> string {
    let b = string(base_name(path));
    let dot = -1;
    let i = b.len() - 1;
    while i >= 0 {
        if b[i] == "." {
            dot = i;
            break;
        }
        i -= 1;
    }
    if dot <= 0 or dot + 1 >= b.len() {
        return "";
    }
    return b.slice(dot + 1, b.len()).lower();
}

public fn ensure_dir(d: string) {
    if not is_dir(d) {
        dir_create(d);
    }
}

public fn copy_dir_recursive(src: string, dst: string) -> bool {
    let ld = list_dir(src);
    if ld.is_err() {
        return false;
    }
    ensure_dir(dst);
    for item in ld.unwrap() {
        let name = string(item);
        if name == ".git" or name == ".DS_Store" or name == "Thumbs.db" {
            continue;
        }
        let sp = join_dir(src, name);
        let dp = join_dir(dst, name);
        if is_dir(sp) {
            if not copy_dir_recursive(sp, dp) {
                return false;
            }
        } elif is_file(sp) {
            let cp = copy_file(sp, dp);
            if cp.is_err() {
                println("error: copying asset " + sp + " failed: " + string(cp.unwrap_err()));
                return false;
            }
        }
    }
    return true;
}

public fn copy_app_assets(appdir: string, dest_root: string) -> bool {
    let src = join_dir(trim_slash(appdir), "assets");
    if not is_dir(src) {
        return true;
    }
    return copy_dir_recursive(src, join_dir(trim_slash(dest_root), "assets"));
}

public fn write_checked(path: string, content: string) -> bool {
    let wr = write_file(path, content);
    if wr.is_err() {
        println("error: writing " + path + " failed: " + string(wr.unwrap_err()));
        return false;
    }
    return true;
}

fn is_alnum_ascii(c: string) -> bool {
    return (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9");
}

fn is_digit_ascii(c: string) -> bool {
    return c >= "0" and c <= "9";
}

public fn sanitize_swift_ident(raw: string) -> string {
    let out = "";
    let i = 0;
    let s = string(raw);
    while i < s.len() {
        let c = s[i];
        if is_alnum_ascii(c) or c == "_" {
            out += c;
        }
        i += 1;
    }
    if out == "" or is_digit_ascii(out[0]) {
        out = "App" + out;
    }
    return out;
}

public fn sanitize_android_pkg(bundle_id: string) -> string {
    let raw_parts = string(bundle_id).lower().split(".");
    let clean_parts = [];
    for rp in raw_parts {
        let seg = "";
        let s = string(rp);
        let i = 0;
        while i < s.len() {
            let c = s[i];
            if (c >= "a" and c <= "z") or is_digit_ascii(c) or c == "_" {
                seg += c;
            }
            i += 1;
        }
        if seg == "" {
            continue;
        }
        if is_digit_ascii(seg[0]) {
            seg = "a" + seg;
        }
        clean_parts.push(seg);
    }
    if clean_parts.len() == 0 {
        return "com.example.app";
    }
    if clean_parts.len() == 1 {
        return "com.example." + clean_parts[0];
    }
    return clean_parts.join(".");
}

public fn html_escape(s: string) -> string {
    let t = string(s);
    t = t.replace("&", "&amp;");
    t = t.replace("<", "&lt;");
    t = t.replace(">", "&gt;");
    t = t.replace("\"", "&quot;");
    t = t.replace("'", "&#39;");
    return t;
}

public fn kotlin_str_escape(s: string) -> string {
    return string(s).replace("\\", "\\\\").replace("\"", "\\\"");
}

public fn safe_script_json(v) -> string {
    let s = json_write(v);
    s = s.replace("</", "<\\/");
    s = s.replace("<!--", "<\\!--");
    return s;
}

public fn render_template(rel_path: string, vars: map) -> string {
    let r = read_file(join_dir(fw_root(), rel_path));
    if r.is_err() {
        println("error: missing template " + rel_path);
        return "";
    }
    let out = string(r.unwrap());
    for (k, v) in vars {
        let pat = "\{\{" + string(k) + "\}\}";
        out = out.replace(pat, string(v));
    }
    return out;
}

/// Make "studio/..." imports resolve across Windows (';') and Unix (':').
public fn setup_import_path() {
    let root = abs_path(fw_root());
    let sep = if is_windows() {
        ";" } else {
        ":"
    };
    let existing = "";
    let cur = env("SPID3R_PATH");
    if string(cur) != "none" {
        existing = string(cur.unwrap());
    }
    if existing == "" {
        env_set("SPID3R_PATH", root);
        return;
    }
    let found = false;
    for part in existing.split(sep) {
        if abs_path(string(part).trim()) == root {
            found = true;
            break;
        }
    }
    if not found {
        env_set("SPID3R_PATH", root + sep + existing);
    }
}

/// Resolve the host page: app-local targets/host.html wins, else framework one.
public fn host_page(appdir: string) -> string {
    let local = join_dir(appdir, "targets/host.html");
    if file_exists(local) {
        return local;
    }
    return join_dir(fw_root(), "targets/host.html");
}

public fn walk_sources(dir: string, out: list) {
    let ld = list_dir(dir);
    if ld.is_err() {
        return;
    }
    for name in ld.unwrap() {
        let p = join_dir(dir, string(name));
        if is_dir(p) {
            let b = string(name);
            if b != "build" and b != ".git" and b != "storage" and b != "dist" {
                walk_sources(p, out);
            }
        } elif is_file(p) {
            let f = string(name);
            if f.ends_with(".matrix") or f == "studio.json" or f.ends_with(".html") or f.ends_with(".toml") {
                out.push(p);
            }
        }
    }
}

public fn source_signature(appdir: string) -> string {
    let files = [];
    walk_sources(trim_slash(appdir), files);
    let fw = join_dir(fw_root(), "studio");
    if not is_dir(join_dir(appdir, "vendor/studio")) {
        walk_sources(fw, files);
    }
    files.sort();
    let sig = "";
    for f in files {
        let mt = file_mtime(f);
        let sz = file_size(f);
        sig += f + ":" + string(mt) + ":" + string(sz) + ";";
    }
    return sig;
}
