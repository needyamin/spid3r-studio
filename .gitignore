**/storage/
.studio-*
_test_*/

# Python, IDE & OS files
__pycache__/
*.py[cod]
.mimosa/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local agent memory & local-only Spid3r bug tracker (never push to GitHub)
AGENTS.md
bugs.html
