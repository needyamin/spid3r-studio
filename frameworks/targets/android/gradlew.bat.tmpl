@echo off
@rem Generated by AppStudio — reproducible Gradle wrapper entrypoint (A-47)
setlocal

set APP_HOME=%~dp0
set WRAPPER_JAR=%APP_HOME%gradle\wrapper\gradle-wrapper.jar

if exist "%WRAPPER_JAR%" (
    if defined JAVA_HOME (
        "%JAVA_HOME%\bin\java.exe" -classpath "%WRAPPER_JAR%" org.gradle.wrapper.GradleWrapperMain %*
    ) else (
        java -classpath "%WRAPPER_JAR%" org.gradle.wrapper.GradleWrapperMain %*
    )
    exit /b %ERRORLEVEL%
)

where gradle >nul 2>&1
if %ERRORLEVEL%==0 (
    echo bootstrapping gradle-wrapper.jar via local gradle (pinned to 8.5)...
    call gradle wrapper --gradle-version 8.5 --distribution-type bin --project-dir "%APP_HOME%"
    if exist "%WRAPPER_JAR%" (
        if defined JAVA_HOME (
            "%JAVA_HOME%\bin\java.exe" -classpath "%WRAPPER_JAR%" org.gradle.wrapper.GradleWrapperMain %*
        ) else (
            java -classpath "%WRAPPER_JAR%" org.gradle.wrapper.GradleWrapperMain %*
        )
        exit /b %ERRORLEVEL%
    )
)

echo error: gradle\wrapper\gradle-wrapper.jar missing and 'gradle' is not on PATH. 1>&2
echo hint: install Gradle 8.5+ or open this project in Android Studio to bootstrap the wrapper. 1>&2
exit /b 1
