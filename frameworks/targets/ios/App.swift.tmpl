// durable Application Support storage (A-46), native capabilities (A-05), and deep links (A-53).
import Foundation
import Security
import SwiftUI
import UIKit
import WebKit

@main struct StudioApp: App {
    var body: some Scene {
        WindowGroup {
            StudioWebView()
                .ignoresSafeArea()
                .onOpenURL { url in
                    StudioNativeBridge.shared.deliverDeepLink(url)
                }
        }
    }
}

private struct StudioWebView: UIViewRepresentable {
    private let schemeHandler = StudioSchemeHandler()

    func makeCoordinator() -> StudioNativeBridge {
        return StudioNativeBridge.shared
    }

    func makeUIView(context: Context) -> WKWebView {
        let cfg = WKWebViewConfiguration()
        cfg.allowsInlineMediaPlayback = true
        cfg.setURLSchemeHandler(schemeHandler, forURLScheme: "appstudio")
        cfg.userContentController.add(context.coordinator, name: "studioNative")

        let wv = WKWebView(frame: .zero, configuration: cfg)
        wv.navigationDelegate = context.coordinator
        wv.uiDelegate = context.coordinator
        wv.isOpaque = false
        wv.backgroundColor = .systemBackground
        wv.scrollView.isScrollEnabled = false
        context.coordinator.attach(webView: wv)

        if let url = URL(string: "appstudio://app/index.html") {
            wv.load(URLRequest(url: url))
        }
        return wv
    }

    func updateUIView(_ uiView: WKWebView, context: Context) {}
}

@MainActor
private final class StudioNativeBridge: NSObject, WKNavigationDelegate, WKUIDelegate, WKScriptMessageHandler {
    static let shared = StudioNativeBridge()

    private weak var webView: WKWebView?
    private var pageLoaded = false
    private var pendingDeepLinks: [String] = []
    private let serviceId: String = Bundle.main.bundleIdentifier ?? "appstudio.default"

    func attach(webView: WKWebView) {
        self.webView = webView
        self.pageLoaded = false
    }

    func deliverDeepLink(_ url: URL) {
        let raw = url.absoluteString
        if raw.isEmpty {
            return
        }
        if pageLoaded {
            dispatchDeepLinkJS(raw)
        } else {
            pendingDeepLinks.append(raw)
        }
    }

    private func dispatchDeepLinkJS(_ raw: String) {
        guard let wv = webView,
              let data = try? JSONSerialization.data(withJSONObject: [raw]),
              let arr = String(data: data, encoding: .utf8),
              arr.count >= 2 else {
            return
        }
        let lit = String(arr.dropFirst().dropLast())
        wv.evaluateJavaScript("window.__studioDeepLink && window.__studioDeepLink(\(lit));", completionHandler: nil)
    }

    private func sendCallback(id: String, payload: [String: Any]) {
        guard !id.isEmpty,
              let wv = webView,
              let idData = try? JSONSerialization.data(withJSONObject: [id]),
              let idArr = String(data: idData, encoding: .utf8),
              idArr.count >= 2,
              let bodyData = try? JSONSerialization.data(withJSONObject: payload),
              let bodyStr = String(data: bodyData, encoding: .utf8) else {
            return
        }
        let idLit = String(idArr.dropFirst().dropLast())
        wv.evaluateJavaScript("window.__studioNativeCallback && window.__studioNativeCallback(\(idLit), \(bodyStr));", completionHandler: nil)
    }

    // MARK: - WKNavigationDelegate

    func webView(_ webView: WKWebView, didFinish navigation: WKNavigation!) {
        pageLoaded = true
        let queued = pendingDeepLinks
        pendingDeepLinks.removeAll()
        for u in queued {
            dispatchDeepLinkJS(u)
        }
    }

    func webView(
        _ webView: WKWebView,
        decidePolicyFor navigationAction: WKNavigationAction,
        decisionHandler: @escaping @MainActor (WKNavigationActionPolicy) -> Void
    ) {
        guard let url = navigationAction.request.url else {
            decisionHandler(.cancel)
            return
        }
        let scheme = (url.scheme ?? "").lowercased()
        if scheme == "appstudio" {
            decisionHandler(.allow)
            return
        }
        if scheme == "https" || scheme == "http" || scheme == "mailto" || scheme == "tel" {
            UIApplication.shared.open(url, options: [:], completionHandler: nil)
        }
        decisionHandler(.cancel)
    }

    // MARK: - WKUIDelegate (window.open target=_blank support)

    func webView(
        _ webView: WKWebView,
        createWebViewWith configuration: WKWebViewConfiguration,
        for navigationAction: WKNavigationAction,
        windowFeatures: WKWindowFeatures
    ) -> WKWebView? {
        if let url = navigationAction.request.url {
            openSafeExternalURL(url)
        }
        return nil
    }

    private func openSafeExternalURL(_ url: URL) {
        let scheme = (url.scheme ?? "").lowercased()
        if scheme == "https" || scheme == "http" || scheme == "mailto" || scheme == "tel" {
            UIApplication.shared.open(url, options: [:], completionHandler: nil)
        }
    }

    // MARK: - WKScriptMessageHandler (Keychain A-04, Durable Storage A-46, Native Caps A-05)

    func userContentController(_ userContentController: WKUserContentController, didReceive message: WKScriptMessage) {
        guard message.name == "studioNative",
              let body = message.body as? [String: Any],
              let action = body["action"] as? String else {
            return
        }
        let reqId = (body["id"] as? String) ?? ""
        let payload = (body["payload"] as? [String: Any]) ?? [:]

        switch action {
        case "secure_set":
            let key = (payload["key"] as? String) ?? ""
            let val = (payload["value"] as? String) ?? ""
            let ok = keychainSet(key: key, value: val)
            sendCallback(id: reqId, payload: ["ok": ok, "error": ok ? "" : "keychain write failed"])
        case "secure_get":
            let key = (payload["key"] as? String) ?? ""
            let val = keychainGet(key: key)
            var out: [String: Any] = ["ok": true]
            if let v = val {
                out["value"] = v
            }
            sendCallback(id: reqId, payload: out)
        case "secure_remove":
            let key = (payload["key"] as? String) ?? ""
            let ok = keychainRemove(key: key)
            sendCallback(id: reqId, payload: ["ok": ok])
        case "storage_read":
            let key = (payload["key"] as? String) ?? "default"
            let val = durableRead(key: key)
            var out: [String: Any] = ["ok": true]
            if let v = val {
                out["value"] = v
            }
            sendCallback(id: reqId, payload: out)
        case "storage_write":
            let key = (payload["key"] as? String) ?? "default"
            let val = (payload["value"] as? String) ?? "{}"
            let ok = durableWrite(key: key, value: val)
            sendCallback(id: reqId, payload: ["ok": ok])
        case "haptic":
            let styleStr = ((payload["style"] as? String) ?? "light").lowercased()
            let style: UIImpactFeedbackGenerator.FeedbackStyle =
                styleStr == "heavy" ? .heavy : (styleStr == "medium" ? .medium : .light)
            let gen = UIImpactFeedbackGenerator(style: style)
            gen.prepare()
            gen.impactOccurred()
        case "open_url":
            let rawUrl = ((payload["url"] as? String) ?? "").trimmingCharacters(in: .whitespacesAndNewlines)
            if let u = URL(string: rawUrl) {
                openSafeExternalURL(u)
            }
        case "share":
            let title = (payload["title"] as? String) ?? ""
            let text = (payload["text"] as? String) ?? ""
            let urlStr = (payload["url"] as? String) ?? ""
            presentShareSheet(title: title, text: text, urlStr: urlStr)
        default:
            sendCallback(id: reqId, payload: ["ok": false, "error": "unknown native action"])
        }
    }

    // MARK: - Keychain (A-04)

    private func keychainSet(key: String, value: String) -> Bool {
        guard !key.isEmpty, let data = value.data(using: .utf8) else { return false }
        let query: [String: Any] = [
            kSecClass as String: kSecClassGenericPassword,
            kSecAttrService as String: serviceId,
            kSecAttrAccount as String: key,
        ]
        SecItemDelete(query as CFDictionary)
        var addQuery = query
        addQuery[kSecValueData as String] = data
        addQuery[kSecAttrAccessible as String] = kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly
        return SecItemAdd(addQuery as CFDictionary, nil) == errSecSuccess
    }

    private func keychainGet(key: String) -> String? {
        guard !key.isEmpty else { return nil }
        let query: [String: Any] = [
            kSecClass as String: kSecClassGenericPassword,
            kSecAttrService as String: serviceId,
            kSecAttrAccount as String: key,
            kSecReturnData as String: true,
            kSecMatchLimit as String: kSecMatchLimitOne,
        ]
        var item: CFTypeRef?
        let status = SecItemCopyMatching(query as CFDictionary, &item)
        guard status == errSecSuccess, let data = item as? Data else { return nil }
        return String(data: data, encoding: .utf8)
    }

    private func keychainRemove(key: String) -> Bool {
        guard !key.isEmpty else { return false }
        let query: [String: Any] = [
            kSecClass as String: kSecClassGenericPassword,
            kSecAttrService as String: serviceId,
            kSecAttrAccount as String: key,
        ]
        let status = SecItemDelete(query as CFDictionary)
        return status == errSecSuccess || status == errSecItemNotFound
    }

    // MARK: - Durable Application Support Storage (A-46)

    private func durableFileURL(for key: String) -> URL? {
        guard let base = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first else {
            return nil
        }
        let dir = base.appendingPathComponent("AppStudioStorage", isDirectory: true)
        try? FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
        let safeName = key.unicodeScalars.map { ch -> String in
            let v = ch.value
            if (v >= 48 && v <= 57) || (v >= 65 && v <= 90) || (v >= 97 && v <= 122) || v == 95 || v == 45 {
                return String(ch)
            }
            return "_"
        }.joined()
        let fname = safeName.isEmpty ? "default.json" : "\(safeName).json"
        return dir.appendingPathComponent(fname)
    }

    private func durableRead(key: String) -> String? {
        guard let url = durableFileURL(for: key),
              let data = try? Data(contentsOf: url) else {
            return nil
        }
        return String(data: data, encoding: .utf8)
    }

    private func durableWrite(key: String, value: String) -> Bool {
        guard let url = durableFileURL(for: key),
              let data = value.data(using: .utf8) else {
            return false
        }
        do {
            try data.write(to: url, options: .atomic)
            return true
        } catch {
            return false
        }
    }

    // MARK: - Share Sheet (A-05)

    private func presentShareSheet(title: String, text: String, urlStr: String) {
        var items: [Any] = []
        if !title.isEmpty && !text.isEmpty {
            items.append("\(title)\n\(text)")
        } else if !text.isEmpty {
            items.append(text)
        } else if !title.isEmpty {
            items.append(title)
        }
        if !urlStr.isEmpty, let u = URL(string: urlStr) {
            items.append(u)
        }
        guard !items.isEmpty else { return }
        guard let scene = UIApplication.shared.connectedScenes.first as? UIWindowScene,
              let root = scene.windows.first?.rootViewController else {
            return
        }
        let vc = UIActivityViewController(activityItems: items, applicationActivities: nil)
        if let pop = vc.popoverPresentationController {
            pop.sourceView = root.view
            pop.sourceRect = CGRect(x: root.view.bounds.midX, y: root.view.bounds.midY, width: 1, height: 1)
            pop.permittedArrowDirections = []
        }
        root.present(vc, animated: true, completion: nil)
    }
}

private final class StudioSchemeHandler: NSObject, WKURLSchemeHandler {
    private static func mimeType(for ext: String) -> String {
        switch ext.lowercased() {
        case "html", "htm":
            return "text/html; charset=utf-8"
        case "js", "mjs":
            return "application/javascript; charset=utf-8"
        case "wasm":
            return "application/wasm"
        case "matrix":
            return "text/plain; charset=utf-8"
        case "css":
            return "text/css; charset=utf-8"
        case "json":
            return "application/json; charset=utf-8"
        case "png":
            return "image/png"
        case "jpg", "jpeg":
            return "image/jpeg"
        case "svg":
            return "image/svg+xml"
        default:
            return "application/octet-stream"
        }
    }

    private static func resolveAssetURL(relativePath: String) -> URL? {
        let clean = relativePath.trimmingCharacters(in: CharacterSet(charactersIn: "/"))
        if clean.isEmpty || clean.contains("..") {
            return nil
        }
        guard let root = Bundle.module.resourceURL else {
            return nil
        }
        let candidates = [
            root.appendingPathComponent("app").appendingPathComponent(clean),
            root.appendingPathComponent("Resources/app").appendingPathComponent(clean),
            root.appendingPathComponent(clean),
        ]
        for url in candidates {
            if FileManager.default.fileExists(atPath: url.path) {
                return url
            }
        }
        return nil
    }

    func webView(_ webView: WKWebView, start urlSchemeTask: any WKURLSchemeTask) {
        guard let reqURL = urlSchemeTask.request.url else {
            urlSchemeTask.didFailWithError(URLError(.badURL))
            return
        }
        var rel = reqURL.path
        if rel.isEmpty || rel == "/" {
            rel = "index.html"
        }
        guard let fileURL = Self.resolveAssetURL(relativePath: rel),
              let data = try? Data(contentsOf: fileURL) else {
            let notFound = HTTPURLResponse(
                url: reqURL,
                statusCode: 404,
                httpVersion: "HTTP/1.1",
                headerFields: ["Content-Type": "text/plain; charset=utf-8"]
            )!
            urlSchemeTask.didReceive(notFound)
            urlSchemeTask.didReceive(Data("Not found".utf8))
            urlSchemeTask.didFinish()
            return
        }
        let mime = Self.mimeType(for: fileURL.pathExtension)
        let resp = HTTPURLResponse(
            url: reqURL,
            statusCode: 200,
            httpVersion: "HTTP/1.1",
            headerFields: [
                "Content-Type": mime,
                "Content-Length": "\(data.count)",
            ]
        )!
        urlSchemeTask.didReceive(resp)
        urlSchemeTask.didReceive(data)
        urlSchemeTask.didFinish()
    }

    func webView(_ webView: WKWebView, stop urlSchemeTask: any WKURLSchemeTask) {}
}
