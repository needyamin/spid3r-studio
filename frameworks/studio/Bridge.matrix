// studio/Bridge.matrix
// GUI bridge glue: webview natives + the event registry + dispatch.
// One global gui_on("ui", ...) subscription routes every UI event:
//   JS:  window.ipc.postMessage(JSON.stringify({event:"ui", payload:{sid,kind,value,arg}}))
//   program: gui_on("ui", cb) receives the payload -> Bridge.dispatch looks up the handler.

import "Util" as U;

let named = {
};  // handler name (as passed to App.handler) -> fn(ev)
let slots = {
};  // "f_<nonce>_<epoch>_<n>" -> fn(ev); closure slots, rebuilt on every render
let slot_seq = 0;
let slot_nonce = "";
let slot_epoch = 1;
let nonce_gen_seq = 0;
let pending_effects = [];
let host_caps = {
    "platform": "native",
    "prefers_dark": false,
    "viewport_width": 0,
    "capabilities": {
        "clipboard": true,
        "open_url": true,
        "haptic": true,
        "secure_store": true,
        "files": true,
        "share": true,
        "auth": true,
        "deep_link": true,
        "geolocation": true,
        "biometrics": true,
        "camera": true,
        "notifications": true,
        "contacts": true,
        "bluetooth": true,
        "background_task": true
    }
    ,
};

// GUI bridge natives (gui_title, gui_set_html, gui_eval, gui_on, gui_emit) only
// link inside the ENTRY file of a `spid3r gui` program — in imported modules they
// resolve to null. The entry therefore defines five one-line shims and installs
// them here via App.bridge(...); every framework call below delegates to them.

let shim_title = null;
let shim_html = null;
let shim_eval = null;
let shim_on = null;
let shim_emit = null;
let window_api = {
};

/// Install entry-provided GUI shims:
/// title(t), html(s), eval(js), on(name, cb), emit(name, payload).
public fn install(f_title, f_html, f_eval, f_on, f_emit) {
    shim_title = f_title;
    shim_html = f_html;
    shim_eval = f_eval;
    shim_on = f_on;
    shim_emit = f_emit;
}

/// Install optional Spid3r v1.5.0 native window control shims from the entry file.
/// Supported keys: "size", "min_size", "theme", "bg_color", "icon",
/// "devtools", "maximize", "fullscreen", "resizable", "decorations", "close", "cancel_close".
public fn install_window_api(api: map) {
    if api == null or type_of(api) != "map" {
        return;
    }
    for (k, v) in api {
        window_api[string(k)] = v;
    }
}

// ---------- webview natives (delegating wrappers) ----------

public fn set_title(t: string) {
    if shim_title != null {
        shim_title(t);
    }
}

public fn set_html(html: string) {
    if shim_html != null {
        shim_html(html);
    }
}

public fn eval(js: string) {
    if shim_eval != null {
        shim_eval(js);
    }
}

/// Subscribe to a bridge event channel (delegates to gui_on in the entry).
public fn on(name: string, cb) {
    if shim_on != null {
        shim_on(name, cb);
    }
}

/// Push an event to the client runtime.
public fn emit(name: string, payload: string) {
    if shim_emit != null {
        shim_emit(name, payload);
    }
}

/// Set logical desktop window size (no-op on web/WASM or when window_api is uninstalled).
public fn set_window_size(w: int, h: int) {
    if window_api.has("size") and window_api["size"] != null {
        let f = window_api["size"];
        f(w, h);
    }
}

/// Set minimum logical desktop window size.
public fn set_window_min_size(w: int, h: int) {
    if window_api.has("min_size") and window_api["min_size"] != null {
        let f = window_api["min_size"];
        f(w, h);
    }
}

/// Set native titlebar theme ("light", "dark", or "system").
public fn set_window_theme(mode: string) {
    if window_api.has("theme") and window_api["theme"] != null {
        let f = window_api["theme"];
        f(mode);
    }
}

/// Set webview startup/backdrop background color (#RGB, #RRGGBB, or #RRGGBBAA).
public fn set_window_bg_color(hex: string) {
    if window_api.has("bg_color") and window_api["bg_color"] != null {
        let f = window_api["bg_color"];
        f(hex);
    }
}

/// Set desktop window and taskbar icon (.ico or .png path).
public fn set_window_icon(path: string) {
    if window_api.has("icon") and window_api["icon"] != null {
        let f = window_api["icon"];
        f(path);
    }
}

/// Toggle or open WebView DevTools on desktop.
public fn set_devtools(enabled: bool) {
    if window_api.has("devtools") and window_api["devtools"] != null {
        let f = window_api["devtools"];
        f(enabled);
    }
}

/// Maximize or unmaximize the desktop window.
public fn set_window_maximized(flag: bool = true) {
    if window_api.has("maximize") and window_api["maximize"] != null {
        let f = window_api["maximize"];
        f(flag);
    }
}

/// Enter or exit borderless fullscreen mode.
public fn set_window_fullscreen(flag: bool) {
    if window_api.has("fullscreen") and window_api["fullscreen"] != null {
        let f = window_api["fullscreen"];
        f(flag);
    }
}

/// Enable or disable user window resizing.
public fn set_window_resizable(flag: bool) {
    if window_api.has("resizable") and window_api["resizable"] != null {
        let f = window_api["resizable"];
        f(flag);
    }
}

/// Show or hide native window decorations/titlebar.
public fn set_window_decorations(flag: bool) {
    if window_api.has("decorations") and window_api["decorations"] != null {
        let f = window_api["decorations"];
        f(flag);
    }
}

/// Programmatically close the desktop window.
public fn close_window() {
    if window_api.has("close") and window_api["close"] != null {
        let f = window_api["close"];
        f();
    }
}

/// Cancel a pending close inside a before_close/close handler.
public fn cancel_close() {
    if window_api.has("cancel_close") and window_api["cancel_close"] != null {
        let f = window_api["cancel_close"];
        f();
    }
}

// ---------- handler registry ----------

fn fresh_nonce() -> string {
    nonce_gen_seq += 1;
    try {
        let rb = random_bytes(8);
        if rb.is_ok() {
            return string(rb.unwrap().to_hex());
        }
    } catch (_e0) {
        let _skip0 = _e0;
    }
    let um = 0;
    let nm = 0;
    try {
        um = unix_ms();
    } catch (_e1) {
        um = 0;
    }
    try {
        nm = now_ms();
    } catch (_e2) {
        nm = 0;
    }
    let seed = string(um) + ":" + string(nm) + ":" + string(nonce_gen_seq);
    try {
        return string(sha256(seed)).slice(0, 16);
    } catch (_e3) {
        return U.fnv_hex(seed);
    }
}

fn ensure_nonce() -> string {
    if slot_nonce == "" {
        slot_nonce = fresh_nonce();
    }
    return slot_nonce;
}

/// Return the active per-session random slot prefix (A-13).
public fn session_nonce() -> string {
    return ensure_nonce();
}

/// Return the active per-frame slot epoch (A-13).
public fn slot_epoch_id() -> int {
    return slot_epoch;
}

/// Configure slot session nonce + frame epoch (used by wasm REPL host handshake).
public fn set_slot_context(nonce: string, epoch: int) {
    let clean = string(nonce).trim();
    if clean != "" {
        slot_nonce = clean;
    } else {
        ensure_nonce();
    }
    if epoch > 0 {
        slot_epoch = epoch;
    }
}

/// Register a named handler (referenced by string in components).
public fn named_handler(name: string, h) {
    named[name] = h;
}

/// Register a closure handler for one render pass; returns an authenticated slot id (A-13).
public fn slot(h) -> string {
    slot_seq += 1;
    let id = "f_" + ensure_nonce() + "_" + string(slot_epoch) + "_" + string(slot_seq);
    slots[id] = h;
    return id;
}

/// Drop closure slots and advance frame epoch (call at the start of every render).
public fn clear_slots() {
    slots = {
    };
    slot_seq = 0;
    slot_epoch += 1;
}

/// Drop closure slots without advancing the frame epoch (used for same-frame error fallback).
public fn clear_slots_keep_epoch() {
    slots = {
    };
    slot_seq = 0;
}

/// Validate inbound UI event payload shape (A-13).
public fn is_valid_event(p) -> bool {
    if p == null or type_of(p) != "map" {
        return false;
    }
    if not p.has("sid") or type_of(p["sid"]) != "string" {
        return false;
    }
    let sid = string(p["sid"]);
    if sid == "" or sid.len() > 128 {
        return false;
    }
    if p.has("kind") and p["kind"] != null and type_of(p["kind"]) != "string" {
        return false;
    }
    return true;
}

/// Normalize an inbound event payload: may be a map, a JSON string, or an
/// {event, payload} envelope.
public fn normalize(data) -> map ? {
    let p = data;
    if type_of(p) == "string" {
        let parsed = null;
        try {
            parsed = json_parse(string(p));
        } catch (_e) {
            return null;
        }
        p = parsed;
    }
    if type_of(p) != "map" {
        return null;
    }
    // unwrap an {event, payload} envelope if we got the whole thing
    if p.has("payload") and p.has("event") {
        let inner = p["payload"];
        if type_of(inner) == "string" {
            let parsed2 = null;
            try {
                parsed2 = json_parse(string(inner));
            } catch (_e) {
                parsed2 = null;
            }
            if type_of(parsed2) == "map" {
                p = parsed2;
            }
        } elif type_of(inner) == "map" {
            p = inner;
        }
    }
    return p;
}

/// Route an event payload (plus any same-frame flushed inputs) to its handler(s).
public fn dispatch(data) {
    let p = normalize(data);
    if not is_valid_event(p) {
        return;
    }
    if p.has("flushed") and type_of(p["flushed"]) == "list" {
        for fev in p["flushed"] {
            if is_valid_event(fev) {
                let fh = lookup(string(fev["sid"]));
                if fh != null {
                    fh(fev);
                }
            }
        }
    }
    let sid = string(p["sid"]);
    let h = lookup(sid);
    if h == null {
        return;
    }
    h(p);
}

/// Find a handler by slot id across named + closure registries.
public fn lookup(sid: string) {
    if named.has(sid) {
        return named[sid];
    }
    if slots.has(sid) {
        return slots[sid];
    }
    return null;
}

/// Whether sid is registered as a persistent named handler.
public fn has_named(sid: string) -> bool {
    return named.has(sid);
}

/// Reset handler registries, effects, and host capabilities.
public fn reset() {
    named = {
    };
    slots = {
    };
    slot_seq = 0;
    slot_nonce = "";
    slot_epoch = 1;
    pending_effects = [];
    host_caps = {
        "platform": "native",
        "prefers_dark": false,
        "viewport_width": 0,
        "capabilities": {
            "clipboard": true, "open_url": true, "haptic": true, "secure_store": true, "files": true, "share": true, "auth": true, "deep_link": true
        }
        ,
    };
}

// ---------- unified host effects & capabilities ----------

/// Queue a host side-effect descriptor delivered to the client runtime after render.
public fn enqueue_effect(ef: map) {
    if ef != null and type_of(ef) == "map" {
        pending_effects.push(ef);
    }
}

/// Return and clear all queued host side-effects.
public fn drain_effects() -> list {
    let out = pending_effects;
    pending_effects = [];
    return out;
}

/// Record host runtime capabilities reported by the client envelope.
public fn set_host_caps(c: map) {
    if c == null or type_of(c) != "map" {
        return;
    }
    if c.has("platform") and c["platform"] != null {
        host_caps["platform"] = string(c["platform"]);
    }
    if c.has("prefers_dark") {
        host_caps["prefers_dark"] = c["prefers_dark"] == true;
    }
    if c.has("viewport_width") and c["viewport_width"] != null {
        host_caps["viewport_width"] = U.ival(c, "viewport_width", 0);
    }
    if c.has("capabilities") and type_of(c["capabilities"]) == "map" {
        let merged = {
        };
        if host_caps.has("capabilities") and type_of(host_caps["capabilities"]) == "map" {
            for (ek, ev) in host_caps["capabilities"] {
                merged[ek] = ev;
            }
        }
        for (nk, nv) in c["capabilities"] {
            merged[string(nk)] = nv == true;
        }
        host_caps["capabilities"] = merged;
    }
}

/// Check whether a named native/host capability is supported (A-05).
public fn has_cap(name: string) -> bool {
    let k = name.trim().lower();
    if k == "" {
        return false;
    }
    if host_caps.has("capabilities") and type_of(host_caps["capabilities"]) == "map" {
        let caps_m = host_caps["capabilities"];
        if caps_m.has(k) {
            return caps_m[k] == true;
        }
    }
    return false;
}

/// Return a shallow copy of current host capability metadata.
public fn caps() -> map {
    return U.deep_copy(host_caps);
}

/// Current host platform identifier ("native", "web", "android", "ios").
public fn platform() -> string {
    return U.s(host_caps, "platform");
}

/// Whether the host prefers dark color scheme.
public fn prefers_dark() -> bool {
    return U.prop(host_caps, "prefers_dark") == true;
}

/// Copy text to the host clipboard via the effects protocol.
public fn copy_text(text: string) {
    enqueue_effect({
        "kind": "clipboard.copy", "text": text
    });
}

fn is_safe_open_url(raw: string) -> bool {
    let t = raw.trim();
    if t == "" {
        return false;
    }
    let low = t.lower();
    if low.starts_with("https://") or low.starts_with("http://") {
        return U.safe_url(t) != "";
    }
    return low.starts_with("mailto:") or low.starts_with("tel:");
}

/// Open a safe external URL via the host browser/webview.
public fn open_url(url: string) -> bool {
    if not is_safe_open_url(url) {
        return false;
    }
    enqueue_effect({
        "kind": "open_url", "url": url.trim()
    });
    return true;
}

/// Trigger lightweight haptic feedback on mobile/web hosts.
public fn haptic(style: string = "light") {
    let s = style.trim().lower();
    if s == "" {
        s = "light";
    }
    enqueue_effect({
        "kind": "haptic", "style": s
    });
}

fn is_safe_sec_key(k: string) -> bool {
    let s = k.trim();
    if s == "" or s.len() > 128 {
        return false;
    }
    let i = 0;
    while i < s.len() {
        let c = s[i];
        let ok = (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9") or c == "_" or c == "-" or c == "." or c == ":";
        if not ok {
            return false;
        }
        i += 1;
    }
    return true;
}

/// Store a secret in platform encrypted storage (Keychain / Android Keystore / WebCrypto AES-GCM) (A-04).
public fn secure_set(key: string, value: string, cb: string = "") -> bool {
    if not is_safe_sec_key(key) {
        return false;
    }
    enqueue_effect({
        "kind": "secure_store.set",
        "key": key.trim(),
        "value": value,
        "cb": cb.trim(),
    });
    return true;
}

/// Read a secret from platform encrypted storage; result delivered to named handler cb (A-04).
public fn secure_get(key: string, cb: string) -> bool {
    if not is_safe_sec_key(key) or cb.trim() == "" {
        return false;
    }
    enqueue_effect({
        "kind": "secure_store.get",
        "key": key.trim(),
        "cb": cb.trim(),
    });
    return true;
}

/// Delete a secret from platform encrypted storage (A-04).
public fn secure_remove(key: string, cb: string = "") -> bool {
    if not is_safe_sec_key(key) {
        return false;
    }
    enqueue_effect({
        "kind": "secure_store.remove",
        "key": key.trim(),
        "cb": cb.trim(),
    });
    return true;
}

/// Invoke host native share sheet (UIActivityViewController / Android Intent.ACTION_SEND / Web Share) (A-05).
public fn share(title: string, text: string, url: string = "") -> bool {
    let clean_url = url.trim();
    if clean_url != "" and not is_safe_open_url(clean_url) {
        return false;
    }
    enqueue_effect({
        "kind": "share",
        "title": title,
        "text": text,
        "url": clean_url,
    });
    return true;
}

/// Request host file picker; selected file metadata/content delivered to named handler cb (A-05).
public fn pick_file(accept: string, cb: string) -> bool {
    if cb.trim() == "" {
        return false;
    }
    let acc = accept.trim();
    if acc == "" {
        acc = "*/*";
    }
    enqueue_effect({
        "kind": "files.pick",
        "accept": acc,
        "cb": cb.trim(),
    });
    return true;
}

fn is_safe_url_scheme(scheme: string) -> bool {
    let s = scheme.trim().lower();
    if s == "" or s.len() > 40 {
        return false;
    }
    if s == "http" or s == "https" or s == "javascript" or s == "data" or s == "file" or s == "vbscript" {
        return false;
    }
    let c0 = s[0];
    if not (c0 >= "a" and c0 <= "z") {
        return false;
    }
    let i = 1;
    while i < s.len() {
        let c = s[i];
        let ok = (c >= "a" and c <= "z") or (c >= "0" and c <= "9") or c == "+" or c == "-" or c == ".";
        if not ok {
            return false;
        }
        i += 1;
    }
    return true;
}

/// Launch external HTTPS OAuth/SSO flow expecting a redirect back on redirect_scheme (A-53).
public fn start_auth(url: string, redirect_scheme: string, cb: string) -> bool {
    let u = url.trim();
    if not u.lower().starts_with("https://") or U.safe_url(u) == "" {
        return false;
    }
    if not is_safe_url_scheme(redirect_scheme) or cb.trim() == "" {
        return false;
    }
    enqueue_effect({
        "kind": "auth.open",
        "url": u,
        "redirect_scheme": redirect_scheme.trim().lower(),
        "cb": cb.trim(),
    });
    return true;
}

/// Request current device geolocation coordinates via named callback cb (A-05).
public fn request_geolocation(cb: string) -> bool {
    if cb.trim() == "" {
        return false;
    }
    enqueue_effect({
        "kind": "geo.get", "cb": cb.trim()
    });
    return true;
}

/// Request biometric authentication (Face ID / Touch ID / Android Biometric / WebAuthn) (A-05).
public fn authenticate_biometrics(reason: string, cb: string) -> bool {
    if cb.trim() == "" {
        return false;
    }
    enqueue_effect({
        "kind": "biometrics.auth", "reason": reason.trim(), "cb": cb.trim()
    });
    return true;
}

/// Request camera capture via named callback cb (A-05).
public fn capture_camera(cb: string, facing: string = "environment") -> bool {
    if cb.trim() == "" {
        return false;
    }
    let f = if facing.trim().lower() == "user" {
        "user"
    } else {
        "environment"
    };
    enqueue_effect({
        "kind": "camera.capture", "facing": f, "cb": cb.trim()
    });
    return true;
}

/// Show a local notification via host notification center (A-05).
public fn notify(title: string, body: string, cb: string = "") -> bool {
    if title.trim() == "" and body.trim() == "" {
        return false;
    }
    enqueue_effect({
        "kind": "notifications.show", "title": title, "body": body, "cb": cb.trim()
    });
    return true;
}

/// Pick a contact from the device contacts picker via named callback cb (A-05).
public fn pick_contact(cb: string) -> bool {
    if cb.trim() == "" {
        return false;
    }
    enqueue_effect({
        "kind": "contacts.pick", "cb": cb.trim()
    });
    return true;
}

/// Scan nearby Bluetooth Low Energy peripherals via named callback cb (A-05).
public fn ble_scan(service_uuid: string, cb: string) -> bool {
    if cb.trim() == "" {
        return false;
    }
    enqueue_effect({
        "kind": "ble.scan", "service_uuid": service_uuid.trim(), "cb": cb.trim()
    });
    return true;
}

/// Schedule a periodic background task on supported hosts (A-05).
public fn schedule_background_task(
    task_id: string,
    interval_sec: int,
    cb: string = ""
) -> bool {
    if task_id.trim() == "" or interval_sec <= 0 {
        return false;
    }
    enqueue_effect({
        "kind": "background.schedule",
        "task_id": task_id.trim(),
        "interval_sec": interval_sec,
        "cb": cb.trim(),
    });
    return true;
}

/// Register the application deep-link / auth redirect callback handler (A-53).
public fn on_deep_link(cb) {
    if cb != null {
        named_handler("__studio_deep_link__", cb);
    }
}

/// Parse an inbound deep-link URL into {url, scheme, host, path, query} (A-53).
/// Returns an empty map for unsafe/malformed URLs.
public fn parse_deep_link(raw_url: string) -> map {
    let u = raw_url.trim();
    if u == "" {
        return {
        };
    }
    let colon = u.index_of("://");
    if colon <= 0 {
        return {
        };
    }
    let scheme = u.slice(0, colon).lower();
    if scheme == "javascript" or scheme == "data" or scheme == "vbscript" or scheme == "file" {
        return {
        };
    }
    let rest = u.slice(colon + 3, u.len());
    let frag = rest.index_of("#");
    if frag >= 0 {
        rest = rest.slice(0, frag);
    }
    let query_str = "";
    let qpos = rest.index_of("?");
    if qpos >= 0 {
        query_str = rest.slice(qpos + 1, rest.len());
        rest = rest.slice(0, qpos);
    }
    let host = rest;
    let path = "";
    let slash = rest.index_of("/");
    if slash >= 0 {
        host = rest.slice(0, slash);
        path = rest.slice(slash, rest.len());
    }
    let query = {
    };
    if query_str != "" {
        for pair in query_str.split("&") {
            let p = string(pair);
            if p == "" {
                continue;
            }
            let eq = p.index_of("=");
            if eq >= 0 {
                let k = p.slice(0, eq);
                let v = p.slice(eq + 1, p.len());
                query[k] = v;
            } else {
                query[p] = "";
            }
        }
    }
    return {
        "url": u,
        "scheme": scheme,
        "host": host,
        "path": path,
        "query": query,
    };
}

/// Normalize, dispatch (including same-frame flushed inputs), and return "" on success or formatted error.
public fn dispatch_safe(data) -> string {
    let p = normalize(data);
    if not is_valid_event(p) {
        return "";
    }
    if p.has("flushed") and type_of(p["flushed"]) == "list" {
        for fev in p["flushed"] {
            if is_valid_event(fev) {
                let fsid = string(fev["sid"]);
                let fh = lookup(fsid);
                if fh != null {
                    try {
                        fh(fev);
                    } catch (fe) {
                        return fsid + ": " + string(fe);
                    }
                }
            }
        }
    }
    let sid = string(p["sid"]);
    let h = lookup(sid);
    if h != null {
        try {
            h(p);
        } catch (e) {
            return sid + ": " + string(e);
        }
    }
    return "";
}

/// Dispatch + re-render: the single subscription installed by App.run.
/// After any handler mutates state/navigation, the visible page re-renders.
public fn dispatch_and_render(data, app) {
    let err = dispatch_safe(data);
    if err != "" {
        set_html(
            "<div class=\"page\"><div class=\"card\"><div class=\"title\" style=\"color:var(--danger)\">Handler error</div><div class=\"mono\">" + U.esc(err) + "</div></div></div>"
        );
        return;
    }
    try {
        app.render();
    } catch (e) {
        set_html(
            "<div class=\"page\"><div class=\"card\"><div class=\"title\" style=\"color:var(--danger)\">Render error</div><div class=\"mono\">" + U.esc(string(e)) + "</div></div></div>"
        );
    }
}
