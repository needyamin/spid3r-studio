// studio/Render.matrix
// Component tree -> HTML string. Components are plain maps (see Components.matrix).
// Event handlers resolve to slot ids emitted as data-tap / data-input / data-change
// attributes; the client runtime posts them back over the bridge.
//
// NOTE: missing map keys throw in spid3r — all optional prop reads use Util.prop.

import "Bridge" as br;
import "Router" as nav;
import "I18n" as i18n;
import "Util" as U;

let allow_raw_html = false;
let comp_cache = {
};
let comp_cache_hits = 0;
let comp_cache_misses = 0;

/// Explicitly opt in to unsanitized ui.html() passthrough (disabled by default — A-12).
public fn set_allow_raw_html(flag: bool) {
    allow_raw_html = flag;
}

/// Clear the ui.component() memoization cache and reset hit/miss counters (A-08).
public fn clear_component_cache() {
    comp_cache = {
    };
    comp_cache_hits = 0;
    comp_cache_misses = 0;
}

/// Return component memoization hit/miss statistics (A-08).
public fn component_cache_stats() -> map {
    return {
        "hits": comp_cache_hits, "misses": comp_cache_misses, "entries": comp_cache.len()
    };
}

// ---------- props -> attributes ----------

fn css_dim(v) -> string {
    let t = type_of(v);
    if t == "int" or t == "float" {
        return string(v) + "px";
    }
    return U.esc_css_val(string(v));
}

fn style_of(p: map) -> string {
    let s = "";
    if U.prop(p, "gap") != null {
        s += "gap:" + U.esc_css_val(string(p["gap"])) + "px;";
    }
    if U.prop(p, "align") != null {
        let av = U.esc_css_val(string(p["align"]));
        if av != "" {
            s += "align-items:" + av + ";";
        }
    }
    if U.prop(p, "justify") != null {
        let jv = U.esc_css_val(string(p["justify"]));
        if jv != "" {
            s += "justify-content:" + jv + ";";
        }
    }
    if U.prop(p, "pad") != null {
        s += "padding:" + U.esc_css_val(string(p["pad"])) + "px;";
    }
    if U.prop(p, "wrap") == true {
        s += "flex-wrap:wrap;";
    }
    if U.prop(p, "width") != null {
        let wv = css_dim(p["width"]);
        if wv != "" {
            s += "width:" + wv + ";";
        }
    }
    if U.prop(p, "height") != null {
        let hv = css_dim(p["height"]);
        if hv != "" {
            s += "height:" + hv + ";";
        }
    }
    if U.prop(p, "flex") != null {
        let fv = U.esc_css_val(string(p["flex"]));
        if fv != "" {
            s += "flex:" + fv + ";";
        }
    }
    if U.prop(p, "cols") != null {
        let cols = U.ival(p, "cols", 2);
        if cols < 1 {
            cols = 1;
        }
        s += "grid-template-columns:repeat(" + string(cols) + ",minmax(0,1fr));";
    }
    if U.prop(p, "style") != null {
        s += U.esc_style(string(p["style"]));
    }
    return s;
}

fn is_disabled(p: map) -> bool {
    return U.prop(p, "disabled") == true;
}

fn disabled_attr(p: map) -> string {
    if is_disabled(p) {
        return " disabled";
    }
    return "";
}

fn cls_of(p: map, base: string) -> string {
    let c = base;
    if U.prop(p, "cls") != null {
        if c == "" {
            c = string(p["cls"]);
        } else {
            c += " " + string(p["cls"]);
        }
    }
    if is_disabled(p) {
        if c == "" {
            c = "disabled";
        } else {
            c += " disabled";
        }
    }
    return c;
}

fn attrs(p: map, base_cls: string) -> string {
    let a = " class=\"" + U.esc_attr(cls_of(p, base_cls)) + "\"";
    let st = style_of(p);
    if st != "" {
        a += " style=\"" + U.esc_attr(st) + "\"";
    }
    if U.prop(p, "id") != null {
        a += " id=\"" + U.esc_attr(string(p["id"])) + "\"";
    }
    if U.prop(p, "key") != null {
        a += " data-key=\"" + U.esc_attr(string(p["key"])) + "\"";
    }
    if U.prop(p, "arg") != null {
        a += " data-arg=\"" + U.esc_attr(string(p["arg"])) + "\"";
    }
    if U.prop(p, "role") != null {
        a += " role=\"" + U.esc_attr(string(p["role"])) + "\"";
    }
    if U.prop(p, "aria_label") != null {
        a += " aria-label=\"" + U.esc_attr(string(p["aria_label"])) + "\"";
    }
    if is_disabled(p) {
        a += " aria-disabled=\"true\"";
    }
    if U.prop(p, "tabindex") != null {
        a += " tabindex=\"" + U.esc_attr(string(p["tabindex"])) + "\"";
    }
    if U.prop(p, "dir") != null {
        let dv = string(p["dir"]).trim().lower();
        if dv == "rtl" or dv == "ltr" or dv == "auto" {
            a += " dir=\"" + dv + "\"";
        }
    }
    return a;
}

/// data-tap / data-input / data-change / data-submit attribute for an event prop.
/// Handlers are handler names (string) or closures (auto slot).
fn ev_attr(p: map, key: string, attr: string) -> string {
    let h = U.prop(p, key);
    if h == null {
        return "";
    }
    let sid = "";
    if type_of(h) == "string" {
        sid = string(h);
    } else {
        sid = br.slot(h);
    }
    return " data-" + attr + "=\"" + U.esc_attr(sid) + "\"";
}

fn ev_attr_if(p: map, key: string, attr: string) -> string {
    if is_disabled(p) {
        return "";
    }
    return ev_attr(p, key, attr);
}

fn kids(n: map) -> list {
    let c = U.prop(n, "children");
    if c == null or type_of(c) != "list" {
        return [];
    }
    return c;
}

fn kids_html(n: map) -> string {
    let out = "";
    for c in kids(n) {
        out += node_html(c);
    }
    return out;
}

// ---------- element renderers ----------

fn text_html(n: map) -> string {
    let base = "";
    if U.s(n, "cls") == "" {
        base = "body";
    }
    return "<div" + attrs(n, base) + ">" + U.esc(U.s(n, "text")) + "</div>";
}

fn dir_attr_auto(n: map) -> string {
    if U.prop(n, "dir") != null {
        return "";
    }
    if i18n.is_rtl() {
        return " dir=\"rtl\"";
    }
    return "";
}

fn navbar_html(n: map) -> string {
    let h = "<div class=\"navbar\" role=\"banner\"" + dir_attr_auto(n) + ">";
    if nav.can_pop() {
        h += "<button type=\"button\" class=\"nav-back\" aria-label=\"Back\" data-tap=\"" + br.slot((_ev) => nav.pop()) + "\">&#8249;</button>";
    }
    h += "<div class=\"navbar-title\">" + U.esc(U.s(n, "title")) + "</div>";
    h += "<div class=\"navbar-actions\">" + kids_html(n) + "</div></div>";
    return h;
}

fn tabbar_html(n: map) -> string {
    let tabs = U.prop(n, "tabs");
    if tabs == null or type_of(tabs) != "list" {
        return "";
    }
    let active = U.ival(n, "active", 0);
    let h = "<div class=\"tabbar\" role=\"tablist\"" + dir_attr_auto(n) + ">";
    let i = 0;
    for t in tabs {
        let label = "";
        let icon = "&#9633;";
        if type_of(t) == "map" {
            label = U.s(t, "label");
            if U.prop(t, "icon") != null {
                icon = string(t["icon"]);
            }
        } else {
            label = string(t);
        }
        let c = "tab";
        let sel = "false";
        let tidx = "-1";
        if i == active {
            c += " active";
            sel = "true";
            tidx = "0";
        }
        let idx = i;
        h += "<button type=\"button\" class=\"" + c + "\" role=\"tab\" aria-selected=\"" + sel + "\" tabindex=\"" + tidx + "\" data-tap=\"" + br.slot((_ev) => nav.switch_tab(idx)) + "\">"
        + "<span class=\"icon\">" + U.esc_icon(icon) + "</span><span>" + U.esc(label) + "</span></button>";
        i += 1;
    }
    return h + "</div>";
}

fn tile_html(n: map) -> string {
    let tappable = U.prop(n, "onTap") != null;
    let cls = "tile";
    if tappable {
        cls += " pressable";
    }
    let h = "<div" + attrs(n, cls) + ev_attr(n, "onTap", "tap") + ">";
    if U.prop(n, "leading") != null {
        h += node_html(n["leading"]);
    }
    h += "<div class=\"tile-main\">"
    + "<div class=\"tile-title\">" + U.esc(U.s(n, "title")) + "</div>";
    if U.s(n, "subtitle") != "" {
        h += "<div class=\"tile-sub\">" + U.esc(U.s(n, "subtitle")) + "</div>";
    }
    h += "</div>";
    if U.prop(n, "trailing") != null {
        h += node_html(n["trailing"]);
    } elif tappable {
        h += "<span class=\"tile-chev\">&#8250;</span>";
    }
    return h + "</div>";
}

fn list_html(n: map) -> string {
    let h = "<div" + attrs(n, "list") + ">";
    let items = U.prop(n, "items");
    if items == null or type_of(items) != "list" {
        return h + "</div>";
    }
    let rf = U.prop(n, "renderItem");
    let i = 0;
    for item in items {
        if rf != null {
            h += node_html(rf(item, i));
        } elif type_of(item) == "map" {
            let tile = {
                "el": "listtile", "title": U.s(item, "title")
            };
            if item.has("subtitle") {
                tile["subtitle"] = item["subtitle"];
            }
            if item.has("onTap") {
                tile["onTap"] = item["onTap"];
            }
            if item.has("key") {
                tile["key"] = item["key"];
            }
            h += tile_html(tile);
        } else {
            let tile2 = {
                "el": "listtile", "title": string(item)
            };
            h += tile_html(tile2);
        }
        i += 1;
    }
    return h + "</div>";
}

fn toggle_html(n: map) -> string {
    let on = U.prop(n, "value") == true;
    let c = "toggle";
    let aria_chk = "false";
    if on {
        c += " on";
        aria_chk = "true";
    }
    let arg = "0";
    let next_val = "false";
    if not on {
        arg = "1";
        next_val = "true";
    }
    let n2 = {
        "el": "toggle", "arg": arg, "role": "switch", "tabindex": "0"
    };
    for (k, v) in n {
        if k != "el" and k != "arg" {
            n2[k] = v;
        }
    }
    return "<div" + attrs(n2, c) + " aria-checked=\"" + aria_chk + "\" data-val=\"" + next_val + "\"" + ev_attr_if(n2, "onTap", "tap") + "><div class=\"knob\"></div></div>";
}

fn opt_pair(item) -> list {
    if type_of(item) == "map" {
        let lbl = U.s(item, "label");
        let val = if U.prop(item, "value") != null {
            string(item["value"])
        } else {
            lbl
        };
        if lbl == "" {
            lbl = val;
        }
        return [val, lbl];
    }
    let s = string(item);
    return [s, s];
}

fn checkbox_html(n: map) -> string {
    let on = U.prop(n, "value") == true;
    let aria_chk = if on {
        "true"
    } else {
        "false"
    };
    let cattr = if on {
        " checked"
    } else {
        ""
    };
    let lbl = U.s(n, "label");
    let h = "<label" + attrs(n, "checkbox-row") + "><input type=\"checkbox\" class=\"checkbox-input\" aria-checked=\"" + aria_chk + "\"" + cattr + disabled_attr(n) + ev_attr_if(n, "onChange", "change") + ">";
    if lbl != "" {
        h += "<span>" + U.esc(lbl) + "</span>";
    }
    return h + "</label>";
}

fn select_html(n: map) -> string {
    let opts = U.prop(n, "options");
    let cur = U.s(n, "value");
    let h = "<select" + attrs(n, "field select") + disabled_attr(n) + ev_attr_if(n, "onChange", "change") + ">";
    if opts != null and type_of(opts) == "list" {
        for item in opts {
            let pair = opt_pair(item);
            let ov = string(pair[0]);
            let ol = string(pair[1]);
            let sel = if ov == cur {
                " selected"
            } else {
                ""
            };
            h += "<option value=\"" + U.esc_attr(ov) + "\"" + sel + ">" + U.esc(ol) + "</option>";
        }
    }
    return h + "</select>";
}

fn segmented_html(n: map) -> string {
    let opts = U.prop(n, "options");
    let active = U.ival(n, "active", 0);
    let dis = is_disabled(n);
    let h = "<div" + attrs(n, "segmented") + dir_attr_auto(n) + " role=\"tablist\">";
    if opts != null and type_of(opts) == "list" {
        let idx = 0;
        for item in opts {
            let pair = opt_pair(item);
            let ov = string(pair[0]);
            let ol = string(pair[1]);
            let sc = "seg-btn";
            let sel = "false";
            let tidx = "-1";
            if idx == active {
                sc += " active";
                sel = "true";
                tidx = "0";
            }
            h += "<button type=\"button\" class=\"" + sc + "\" role=\"tab\" aria-selected=\"" + sel + "\" tabindex=\"" + tidx + "\"" + disabled_attr(n);
            if not dis {
                h += " data-arg=\"" + string(idx) + "\" data-val=\"" + U.esc_attr(ov) + "\"" + ev_attr(n, "onChange", "tap");
            }
            h += ">" + U.esc(ol) + "</button>";
            idx += 1;
        }
    }
    return h + "</div>";
}

fn spinner_html(n: map) -> string {
    let sz = U.ival(n, "size", 24);
    if sz < 12 {
        sz = 12;
    }
    let lbl = U.s(n, "label");
    if lbl == "" {
        lbl = "Loading";
    }
    return "<div" + attrs(n, "spinner") + " role=\"status\" aria-label=\"" + U.esc_attr(lbl) + "\"><div class=\"spinner-ring\" style=\"width:" + string(sz) + "px;height:" + string(sz) + "px;\"></div></div>";
}

fn dialog_html(n: map) -> string {
    let wrap = {
        "el": "dialogwrap"
    };
    let role_a = if U.prop(n, "role") == null {
        " role=\"dialog\""
    } else {
        ""
    };
    let tab_a = if U.prop(n, "tabindex") == null {
        " tabindex=\"-1\""
    } else {
        ""
    };
    let h = "<div" + attrs(wrap, "dialog-wrap") + ev_attr(n, "onDismiss", "tap") + ">"
    + "<div" + attrs(n, "dialog") + dir_attr_auto(n) + role_a + " aria-modal=\"true\"" + tab_a + " data-stop-tap=\"1\">";
    let t = U.s(n, "title");
    if t != "" {
        h += "<div class=\"dialog-title\">" + U.esc(t) + "</div>";
    }
    let b = U.s(n, "body");
    if b != "" {
        h += "<div class=\"dialog-body\">" + U.esc(b) + "</div>";
    }
    return h + "<div class=\"dialog-actions\">" + kids_html(n) + "</div></div></div>";
}

fn chip_html(n: map) -> string {
    let sel = U.prop(n, "selected") == true;
    let c = "chip";
    if sel {
        c += " selected";
    }
    if U.prop(n, "onTap") != null {
        let ap = if sel {
            "true"
        } else {
            "false"
        };
        return "<button type=\"button\"" + attrs(n, c) + " aria-pressed=\"" + ap + "\"" + disabled_attr(n) + ev_attr_if(n, "onTap", "tap") + "><span>" + U.esc(U.s(n, "text")) + "</span></button>";
    }
    return "<span" + attrs(n, c) + ">" + U.esc(U.s(n, "text")) + "</span>";
}

fn page_html(n: map) -> string {
    let nav_h = "";
    let body_h = "";
    for c in kids(n) {
        if type_of(c) == "map" and U.s(c, "el") == "navbar" {
            nav_h += navbar_html(c);
        } else {
            body_h += node_html(c);
        }
    }
    let cls = "page";
    if nav_h != "" {
        cls += " has-nav";
    }
    if U.prop(n, "flush") == true {
        cls += " flush";
    }
    let key = "";
    if U.prop(n, "pagekey") != null {
        key = " data-pagekey=\"" + U.esc_attr(string(n["pagekey"])) + "\"";
    }
    return nav_h + "<div" + attrs(n, cls) + dir_attr_auto(n) + key + ">" + body_h + "</div>";
}

fn container_html(n: map) -> string {
    let el = string(n["el"]);
    return "<div" + attrs(n, el) + ev_attr_if(n, "onTap", "tap") + ">" + kids_html(n) + "</div>";
}

fn form_html(n: map) -> string {
    return "<form" + attrs(n, "form") + ev_attr_if(n, "onSubmit", "submit") + ">" + kids_html(n) + "</form>";
}

fn spacer_html(n: map) -> string {
    let sz = U.ival(n, "size", 8);
    if sz <= 0 or U.prop(n, "flex") != null {
        return "<div class=\"spacer grow\"></div>";
    }
    let px = string(sz);
    return "<div class=\"spacer\" style=\"width:" + px + "px;height:" + px + "px;\"></div>";
}

fn divider_html(_n: map) -> string {
    return "<hr class=\"divider\">";
}

fn button_html(n: map) -> string {
    let btype = if U.s(n, "btn_type") == "submit" {
        "submit"
    } else {
        "button"
    };
    return "<button type=\"" + btype + "\"" + attrs(n, "btn " + U.s(n, "variant")) + disabled_attr(n) + ev_attr_if(n, "onTap", "tap")
    + "><span>" + U.esc(U.s(n, "text")) + "</span></button>";
}

fn iconbutton_html(n: map) -> string {
    return "<button type=\"button\"" + attrs(n, "iconbtn " + U.s(n, "variant")) + disabled_attr(n) + ev_attr_if(n, "onTap", "tap")
    + ">" + U.esc_icon(U.s(n, "icon")) + "</button>";
}

fn fab_html(n: map) -> string {
    return "<button type=\"button\"" + attrs(n, "fab") + disabled_attr(n) + ev_attr_if(n, "onTap", "tap") + ">" + U.esc_icon(U.s(n, "icon")) + "</button>";
}

fn input_html(n: map) -> string {
    return "<input" + attrs(n, "field") + " type=\"" + U.esc_attr(U.s(n, "kind"))
    + "\" placeholder=\"" + U.esc_attr(U.s(n, "placeholder"))
    + "\" value=\"" + U.esc_attr(U.s(n, "value")) + "\"" + disabled_attr(n)
    + ev_attr_if(n, "onInput", "input")
    + ev_attr_if(n, "onChange", "change")
    + ev_attr_if(n, "onSubmit", "submit") + ">";
}

fn textarea_html(n: map) -> string {
    return "<textarea" + attrs(n, "field") + " placeholder=\"" + U.esc_attr(U.s(n, "placeholder"))
    + "\"" + disabled_attr(n) + ev_attr_if(n, "onInput", "input") + ev_attr_if(n, "onChange", "change") + ">" + U.esc(U.s(n, "value")) + "</textarea>";
}

fn slider_html(n: map) -> string {
    return "<input" + attrs(n, "slider") + " type=\"range\" min=\"" + U.esc_attr(U.s(n, "min"))
    + "\" max=\"" + U.esc_attr(U.s(n, "max")) + "\" value=\"" + U.esc_attr(U.s(n, "value"))
    + "\"" + disabled_attr(n) + ev_attr_if(n, "onInput", "input") + ev_attr_if(n, "onChange", "change") + ">";
}

fn progress_html(n: map) -> string {
    let fv = U.fval(n, "value", 0.0);
    if fv < 0.0 {
        fv = 0.0;
    } elif fv > 1.0 {
        fv = 1.0;
    }
    let pct = int(fv * 100.0 + 0.5);
    return "<div" + attrs(n, "progress") + " role=\"progressbar\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"" + string(pct) + "\"><div class=\"fill\" style=\"width:" + string(pct) + "%\"></div></div>";
}

fn image_html(n: map) -> string {
    return "<img" + attrs(n, "img") + " src=\"" + U.esc_attr(U.safe_url(U.s(n, "src"))) + "\" alt=\"" + U.esc_attr(U.s(n, "alt")) + "\">";
}

fn avatar_html(n: map) -> string {
    let safe_src = U.safe_url(U.s(n, "src"));
    if safe_src != "" {
        return "<div class=\"avatar\"><img src=\"" + U.esc_attr(safe_src) + "\" alt=\"\"></div>";
    }
    return "<div class=\"avatar\">" + U.esc(U.s(n, "label")) + "</div>";
}

fn badge_html(n: map) -> string {
    return "<span" + attrs(n, "badge " + U.s(n, "color")) + ">" + U.esc(U.s(n, "text")) + "</span>";
}

fn card_html(n: map) -> string {
    return "<div" + attrs(n, "card") + ev_attr(n, "onTap", "tap") + ">" + kids_html(n) + "</div>";
}

fn sheet_html(n: map) -> string {
    let wrap = {
        "el": "sheetwrap"
    };
    return "<div" + attrs(wrap, "sheet-wrap") + ev_attr(n, "onDismiss", "tap") + ">"
    + "<div class=\"sheet\"" + dir_attr_auto(n) + " role=\"dialog\" aria-modal=\"true\" tabindex=\"-1\" data-stop-tap=\"1\">" + kids_html(n) + "</div></div>";
}

fn toast_html(n: map) -> string {
    let tv = U.s(n, "variant");
    if tv == "" {
        tv = "info";
    }
    return "<div" + attrs(n, "toast " + tv) + " role=\"status\" aria-live=\"polite\"" + ev_attr_if(n, "onDismiss", "tap") + "><span>" + U.esc(U.s(n, "text")) + "</span></div>";
}

fn raw_html_node(n: map) -> string {
    let raw_h = U.s(n, "raw");
    if allow_raw_html {
        return raw_h;
    }
    return U.sanitize_html(raw_h);
}

// ---------- main O(1) table dispatcher (A-25) ----------

let render_table = null;

fn dispatch_table() -> map {
    if render_table == null {
        render_table = {
            "page": page_html,
            "column": container_html,
            "row": container_html,
            "center": container_html,
            "scroll": container_html,
            "empty": container_html,
            "grid": container_html,
            "form": form_html,
            "spacer": spacer_html,
            "divider": divider_html,
            "text": text_html,
            "navbar": navbar_html,
            "tabbar": tabbar_html,
            "button": button_html,
            "iconbutton": iconbutton_html,
            "fab": fab_html,
            "chip": chip_html,
            "input": input_html,
            "textarea": textarea_html,
            "checkbox": checkbox_html,
            "select": select_html,
            "picker": select_html,
            "segmented": segmented_html,
            "spinner": spinner_html,
            "slider": slider_html,
            "toggle": toggle_html,
            "progress": progress_html,
            "image": image_html,
            "avatar": avatar_html,
            "badge": badge_html,
            "card": card_html,
            "listtile": tile_html,
            "list": list_html,
            "sheet": sheet_html,
            "dialog": dialog_html,
            "toast": toast_html,
            "component": component_html,
            "html": raw_html_node,
        };
    }
    return render_table;
}

public fn node_html(n: map) -> string {
    let el = string(n["el"]);
    let tbl = dispatch_table();
    if tbl.has(el) {
        let f = tbl[el];
        return f(n);
    }
    // unknown element: plain div passthrough
    return "<div" + attrs(n, "") + ">" + kids_html(n) + "</div>";
}

fn has_callable_val(v) -> bool {
    let t = type_of(v);
    if t == "function" or t == "closure" {
        return true;
    }
    if t == "list" {
        for item in v {
            if has_callable_val(item) {
                return true;
            }
        }
    } elif t == "map" {
        for (_k, mv) in v {
            if has_callable_val(mv) {
                return true;
            }
        }
    }
    return false;
}

fn has_ephemeral_slot_html(h: string) -> bool {
    return h.contains("data-tap=\"f_") or h.contains("data-input=\"f_") or h.contains(
        "data-change=\"f_"
    ) or h.contains("data-submit=\"f_");
}

fn component_html(n: map) -> string {
    let rfn = U.prop(n, "render");
    if rfn == null {
        return "";
    }
    let cname = U.s(n, "name");
    let ckey = U.s(n, "key");
    if ckey == "" {
        ckey = cname;
    }
    let props = U.prop(n, "props");
    if props == null or type_of(props) != "map" {
        props = {
        };
    }
    let use_memo = U.prop(n, "memo") == true;
    let sig = "";
    if use_memo and not has_callable_val(props) {
        try {
            sig = cname + "|" + ckey + "|" + i18n.locale() + "|" + json_write(props);
        } catch (_e) {
            sig = "";
        }
    }
    if sig != "" and comp_cache.has(ckey) {
        let ent = comp_cache[ckey];
        if string(ent["sig"]) == sig {
            comp_cache_hits += 1;
            return string(ent["html"]);
        }
    }
    comp_cache_misses += 1;
    let child = rfn(U.deep_copy(props));
    if child == null or type_of(child) != "map" {
        return "";
    }
    let keyed_child = child;
    if ckey != "" and (not child.has("key") or string(child["key"]) == "") {
        let copy_c = {
        };
        for (ck, cv) in child {
            copy_c[ck] = cv;
        }
        copy_c["key"] = ckey;
        keyed_child = copy_c;
    }
    let html = node_html(keyed_child);
    if sig != "" and not has_ephemeral_slot_html(html) {
        if comp_cache.len() >= 256 {
            comp_cache = {
            };
        }
        comp_cache[ckey] = {
            "sig": sig, "html": html
        };
    }
    return html;
}

/// Render a full document body: page node + optional bottom tab bar chrome.
/// The tab bar appears only on tab roots (stack depth 1).
public fn document(n: map, tabs: list, tab_index: int) -> string {
    let h = node_html(n);
    if tabs.len() > 1 and nav.depth() == 1 {
        let bar = {
            "el": "tabbar", "tabs": tabs, "active": tab_index
        };
        h += node_html(bar);
    }
    return h;
}
