// studio/CSS.matrix
// AppStudio mobile design system — generates the full stylesheet from Theme tokens.
// Rules reference CSS variables so Theme.mode()/primary()/custom() restyle everything.

import "Theme" as Theme;
import "Util" as U;

/// :root variables built from the token table.
fn css_vars() -> string {
    let T = Theme.tokens();
    return ":root{"
    + "--primary:" + U.esc_css_val(U.s(T, "primary")) + ";"
    + "--on-primary:" + U.esc_css_val(U.s(T, "on_primary")) + ";"
    + "--secondary:" + U.esc_css_val(U.s(T, "secondary")) + ";"
    + "--accent:" + U.esc_css_val(U.s(T, "accent")) + ";"
    + "--danger:" + U.esc_css_val(U.s(T, "danger")) + ";"
    + "--success:" + U.esc_css_val(U.s(T, "success")) + ";"
    + "--bg:" + U.esc_css_val(U.s(T, "bg")) + ";"
    + "--surface:" + U.esc_css_val(U.s(T, "surface")) + ";"
    + "--surface2:" + U.esc_css_val(U.s(T, "surface2")) + ";"
    + "--text:" + U.esc_css_val(U.s(T, "text")) + ";"
    + "--text2:" + U.esc_css_val(U.s(T, "text2")) + ";"
    + "--border:" + U.esc_css_val(U.s(T, "border")) + ";"
    + "--nav-bg:" + U.esc_css_val(U.s(T, "nav_bg")) + ";"
    + "--radius:" + U.esc_css_val(U.s(T, "radius")) + "px;"
    + "--radius-sm:" + U.esc_css_val(U.s(T, "radius_sm")) + "px;"
    + "--font:" + U.esc_css_val(U.s(T, "font")) + ";"
    + "--mono:" + U.esc_css_val(U.s(T, "mono")) + ";"
    + "}";
}

fn css_base() -> string {
    return r"*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}"
    + r"html,body{margin:0;padding:0;height:100%;overflow:hidden;background:var(--bg);color:var(--text);font-family:var(--font);-webkit-font-smoothing:antialiased;}"
    + r"#spid3r-root{height:100%;display:flex;flex-direction:column;touch-action:manipulation;user-select:none;-webkit-user-select:none;}"
    + r"#spid3r-root input,#spid3r-root textarea{user-select:text;-webkit-user-select:text;}"
    + r"button{font-family:inherit;border:none;background:none;color:inherit;cursor:pointer;padding:0;}"
    + r".page{flex:1;display:flex;flex-direction:column;overflow-y:auto;overflow-x:hidden;padding-block:16px 24px;padding-inline:16px;padding-top:calc(16px + env(safe-area-inset-top));padding-bottom:calc(24px + env(safe-area-inset-bottom));gap:4px;}"
    + r".page.has-nav{padding-top:14px;}"
    + r".page.page-enter{animation:page-in .22s ease both;}"
    + r".page.flush{padding:0;}"
    + r"[dir=rtl]{direction:rtl;text-align:start;}"
    + r"@keyframes page-in{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:none;}}"
    + r"@keyframes fade-in{from{opacity:0;}to{opacity:1;}}";
}

fn css_layout() -> string {
    return r".col,.column{display:flex;flex-direction:column;min-width:0;}"
    + r".row{display:flex;flex-direction:row;align-items:center;min-width:0;}"
    + r".center{display:flex;align-items:center;justify-content:center;min-width:0;}"
    + r".wrap{flex-wrap:wrap;}"
    + r".grow{flex:1;}"
    + r".spacer{flex:none;}"
    + r".divider{height:1px;background:var(--border);margin:10px 0;border:none;}"
    + r".scroll{flex:1;overflow-y:auto;min-height:0;}"
    // typography
    + r".h1{font-size:28px;font-weight:800;letter-spacing:-.5px;margin:8px 0;}"
    + r".h2{font-size:22px;font-weight:700;margin:8px 0 4px;}"
    + r".h3{font-size:17px;font-weight:650;margin:6px 0 2px;}"
    + r".title{font-size:16px;font-weight:650;}"
    + r".subtitle{font-size:14px;font-weight:500;color:var(--text);}"
    + r".body{font-size:15px;line-height:1.45;}"
    + r".caption{font-size:12px;color:var(--text2);}"
    + r".muted{font-size:14px;color:var(--text2);line-height:1.45;}"
    + r".mono{font-family:var(--mono);font-size:13px;}"
    + r".bold{font-weight:700;}";
}

fn css_chrome() -> string {
    return r".navbar{flex:none;display:flex;align-items:center;gap:8px;padding:12px 16px;padding-top:calc(12px + env(safe-area-inset-top));background:var(--nav-bg);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:20;}"
    + r".navbar-title{flex:1;font-size:17px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}"
    + r".navbar-actions{display:flex;align-items:center;gap:4px;}"
    + r".nav-back{display:flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:50%;background:var(--surface2);font-size:18px;color:var(--text);}"
    + r".tabbar{display:flex;background:var(--nav-bg);border-top:1px solid var(--border);padding-bottom:env(safe-area-inset-bottom);z-index:20;}"
    + r".tab{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;padding:9px 0 7px;color:var(--text2);font-size:11px;font-weight:600;background:none;}"
    + r".tab .icon{font-size:20px;line-height:1;}"
    + r".tab.active{color:var(--primary);}"
    + r".fab{position:fixed;inset-inline-end:18px;bottom:calc(24px + env(safe-area-inset-bottom));width:56px;height:56px;border-radius:50%;background:var(--primary);color:var(--on-primary);font-size:26px;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 18px rgba(0,0,0,.28);z-index:30;}"
    + r".fab:active{transform:scale(.94);}"
    + r"[dir=rtl] .nav-back,[dir=rtl] .tile-chev{transform:scaleX(-1);}";
}

fn css_controls() -> string {
    return r".btn{display:flex;align-items:center;justify-content:center;gap:6px;min-height:46px;padding:10px 18px;border-radius:var(--radius);font-size:15px;font-weight:650;transition:transform .06s ease,opacity .15s ease;}"
    + r".btn:active{transform:scale(.97);opacity:.9;}"
    + r".btn.primary{background:var(--primary);color:var(--on-primary);}"
    + r".btn.secondary{background:var(--surface2);color:var(--text);}"
    + r".btn.danger{background:var(--danger);color:#fff;}"
    + r".btn.outline{border:1.5px solid var(--primary);color:var(--primary);background:transparent;}"
    + r".btn.ghost{background:transparent;color:var(--primary);}"
    + r".btn.block{width:100%;}"
    + r".iconbtn{display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:50%;font-size:19px;background:transparent;color:var(--text);}"
    + r".iconbtn.primary{background:var(--primary);color:var(--on-primary);}"
    + r".iconbtn.surface{background:var(--surface2);}"
    + r".field{width:100%;min-height:46px;padding:12px 14px;border-radius:var(--radius-sm);border:1.5px solid var(--border);background:var(--surface);color:var(--text);font-size:15px;font-family:inherit;outline:none;}"
    + r".field:focus{border-color:var(--primary);}"
    + r"textarea.field{min-height:96px;resize:none;line-height:1.4;}"
    + r".toggle{position:relative;width:50px;height:30px;border-radius:15px;background:var(--border);transition:background .18s ease;flex:none;}"
    + r".toggle.on{background:var(--success);}"
    + r".toggle .knob{position:absolute;top:3px;inset-inline-start:3px;width:24px;height:24px;border-radius:50%;background:#fff;transition:inset-inline-start .18s ease;box-shadow:0 1px 4px rgba(0,0,0,.3);}"
    + r".toggle.on .knob{inset-inline-start:23px;}"
    + r".progress{height:8px;border-radius:4px;background:var(--surface2);overflow:hidden;}"
    + r".progress .fill{height:100%;background:var(--primary);border-radius:4px;transition:width .25s ease;}"
    + r"input[type=range].slider{width:100%;accent-color:var(--primary);height:32px;}";
}

fn css_surfaces() -> string {
    return r".card{background:var(--surface);border-radius:var(--radius);padding:14px;border:1px solid var(--border);box-shadow:0 1px 4px rgba(0,0,0,.06);display:flex;flex-direction:column;gap:2px;min-width:0;}"
    + r".tile{display:flex;align-items:center;gap:12px;padding:13px 14px;border-radius:var(--radius-sm);background:var(--surface);border:1px solid var(--border);min-width:0;}"
    + r".tile.pressable:active{background:var(--surface2);}"
    + r".tile-main{flex:1;display:flex;flex-direction:column;gap:2px;min-width:0;}"
    + r".tile-sub{font-size:13px;color:var(--text2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}"
    + r".tile-title{font-size:15px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}"
    + r".tile-title.done{text-decoration:line-through;color:var(--text2);}"
    + r".tile-chev{color:var(--text2);font-size:16px;}"
    + r".list{display:flex;flex-direction:column;gap:8px;}"
    + r".badge{display:inline-flex;align-items:center;padding:3px 10px;border-radius:999px;font-size:12px;font-weight:700;width:fit-content;}"
    + r".badge.primary{background:var(--primary);color:var(--on-primary);}"
    + r".badge.success{background:var(--success);color:#fff;}"
    + r".badge.danger{background:var(--danger);color:#fff;}"
    + r".badge.accent{background:var(--accent);color:#1f2937;}"
    + r".avatar{width:42px;height:42px;border-radius:50%;background:var(--primary);color:var(--on-primary);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:16px;overflow:hidden;flex:none;}"
    + r".avatar img{width:100%;height:100%;object-fit:cover;}"
    + r".img{max-width:100%;border-radius:var(--radius-sm);display:block;}"
    + r".sheet-wrap{position:fixed;inset:0;background:rgba(0,0,0,.45);display:flex;align-items:flex-end;z-index:50;animation:fade-in .18s ease both;}"
    + r".sheet{width:100%;background:var(--surface);border-radius:20px 20px 0 0;padding:18px 18px calc(22px + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:10px;animation:sheet-up .22s ease both;}"
    + r"@keyframes sheet-up{from{transform:translateY(60%);}to{transform:none;}}"
    + r".empty{display:flex;flex-direction:column;align-items:center;gap:6px;padding:36px 16px;color:var(--text2);}"
    + r".empty .big{font-size:40px;}"
    + r".check{width:26px;height:26px;border-radius:50%;border:2px solid var(--border);display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;flex:none;}"
    + r".check.on{background:var(--success);border-color:var(--success);}"
    + r".kv{display:flex;justify-content:space-between;padding:6px 0;font-size:14px;}"
    + r".kv .k{color:var(--text2);}"
    + r".disabled,[disabled]{opacity:.52;pointer-events:none;cursor:not-allowed;}"
    + r":focus-visible{outline:2px solid var(--primary);outline-offset:2px;}"
    + r".form{display:flex;flex-direction:column;gap:8px;min-width:0;}"
    + r".grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;min-width:0;}"
    + r".checkbox-row{display:flex;align-items:center;gap:10px;min-height:40px;cursor:pointer;font-size:15px;}"
    + r".checkbox-input{width:20px;height:20px;accent-color:var(--primary);margin:0;flex:none;}"
    + r"select.field{appearance:auto;cursor:pointer;}"
    + r".segmented{display:flex;padding:3px;border-radius:var(--radius-sm);background:var(--surface2);border:1px solid var(--border);gap:3px;}"
    + r".seg-btn{flex:1;min-height:36px;padding:6px 10px;border-radius:calc(var(--radius-sm) - 2px);font-size:13px;font-weight:600;color:var(--text2);transition:background .15s ease,color .15s ease;}"
    + r".seg-btn.active{background:var(--surface);color:var(--text);box-shadow:0 1px 3px rgba(0,0,0,.1);}"
    + r".spinner{display:inline-flex;align-items:center;justify-content:center;}"
    + r".spinner-ring{width:24px;height:24px;border:3px solid var(--surface2);border-top-color:var(--primary);border-radius:50%;animation:spin .8s linear infinite;}"
    + r"@keyframes spin{to{transform:rotate(360deg);}}"
    + r".dialog-wrap{position:fixed;inset:0;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;padding:20px;z-index:60;animation:fade-in .16s ease both;}"
    + r".dialog{width:100%;max-width:360px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:18px;display:flex;flex-direction:column;gap:10px;box-shadow:0 16px 40px rgba(0,0,0,.28);}"
    + r".dialog-title{font-size:17px;font-weight:700;}"
    + r".dialog-body{font-size:14px;color:var(--text2);line-height:1.45;}"
    + r".dialog-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:6px;}"
    + r".toast{position:fixed;left:16px;right:16px;bottom:calc(74px + env(safe-area-inset-bottom));max-width:460px;margin:0 auto;padding:12px 16px;border-radius:var(--radius-sm);font-size:14px;font-weight:600;color:#fff;background:#1f2937;box-shadow:0 10px 26px rgba(0,0,0,.24);z-index:55;display:flex;align-items:center;justify-content:space-between;animation:fade-in .18s ease both;}"
    + r".toast.info{background:var(--primary);}"
    + r".toast.success{background:var(--success);}"
    + r".toast.danger{background:var(--danger);}"
    + r".toast.accent{background:var(--accent);color:#111827;}"
    + r".chip{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:999px;font-size:13px;font-weight:600;background:var(--surface2);color:var(--text);border:1px solid var(--border);}"
    + r".chip.selected{background:var(--primary);color:var(--on-primary);border-color:var(--primary);}"
    + r".dev-error-card{border-color:var(--danger);}"
    + r".dev-log-box{background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius-sm);padding:10px;display:flex;flex-direction:column;gap:4px;max-height:160px;overflow-y:auto;}"
    + r"@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important;}}";
}

/// Full stylesheet: vars + all rule blocks.
public fn stylesheet() -> string {
    return css_vars() + css_base() + css_layout() + css_chrome() + css_controls() + css_surfaces();
}
