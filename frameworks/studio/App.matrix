// studio/App.matrix
// The AppStudio application object: pages, handlers, tabs, storage, boot sequence.
//
// Native (desktop/dev) mode — entry file main.matrix:
//   let app = studio_app();
//   app.bridge(studio_title, studio_html, studio_eval, studio_on, studio_emit);
//   return app.run();
//
// Wasm (web/Android/iOS) mode — AppStudio hosts eval `app source + driver`:
//   driver:  let STUDIO_EVENT_JSON = "<injected>";
//            fn main() -> int { return studio_app().wasm_run(STUDIO_EVENT_JSON); }
// The program answers with @@STUDIO_*@@ protocol lines on stdout; the host
// re-evaluates the whole app source for every UI event (stateless REPL).

import "Bridge" as br;
import "State" as state;
import "Router" as nav;
import "Render" as render;
import "CSS" as css;
import "Storage" as storage;
import "ClientJS" as client;
import "Theme" as theme;
import "I18n" as i18n;
import "Util" as U;
import "Errors" as errors;

const MAX_LOG_ENTRIES = 100;
let log_ring = [];
let log_seq = 0;
let dev_overlay_enabled = false;
let perf_frames = 0;
let perf_last_ms = 0;
let perf_max_ms = 0;
let perf_total_ms = 0;

fn safe_now_ms() -> int {
    try {
        return int(now_ms());
    } catch (_e) {
        return 0;
    }
}

fn record_frame_ms(elapsed: int) {
    let ms = if elapsed < 0 {
        0
    } else {
        elapsed
    };
    perf_frames += 1;
    perf_last_ms = ms;
    perf_total_ms += ms;
    if ms > perf_max_ms {
        perf_max_ms = ms;
    }
}

/// Toggle dev error overlay with structured diagnostics and log ring tail (A-24).
public fn set_dev_mode(flag: bool) {
    dev_overlay_enabled = flag;
}

/// Whether dev error overlay mode is currently enabled (A-24).
public fn is_dev_mode() -> bool {
    return dev_overlay_enabled;
}

/// Append a structured record to the bounded in-memory log ring buffer (A-24).
public fn append_log(
    level: string,
    source: string,
    message: string,
    code: string = ""
) {
    log_seq += 1;
    let rec = {
        "seq": log_seq,
        "ts": safe_now_ms(),
        "level": level,
        "source": source,
        "code": code,
        "message": message,
    };
    log_ring.push(rec);
    if log_ring.len() > MAX_LOG_ENTRIES {
        let trimmed = [];
        let start = log_ring.len() - MAX_LOG_ENTRIES;
        let idx = start;
        while idx < log_ring.len() {
            trimmed.push(log_ring[idx]);
            idx += 1;
        }
        log_ring = trimmed;
    }
}

public fn log_info(source: string, message: string) {
    append_log("info", source, message, "");
}

public fn log_warn(source: string, message: string) {
    append_log("warn", source, message, "");
}

public fn log_error(source: string, message: string, code: string = "E_RUNTIME") {
    append_log("error", source, message, code);
}

/// Return up to `limit` most recent structured log records as deep copies (A-24).
public fn recent_logs(limit: int = 50) -> list {
    let n = log_ring.len();
    if n == 0 or limit <= 0 {
        return [];
    }
    let start = if limit < n {
        n - limit
    } else {
        0
    };
    let out = [];
    let i = start;
    while i < n {
        out.push(U.deep_copy(log_ring[i]));
        i += 1;
    }
    return out;
}

/// Clear the in-memory log ring buffer (A-24).
public fn clear_logs() {
    log_ring = [];
    log_seq = 0;
}

/// Return frame render + storage persistence performance metrics (A-03).
public fn perf_stats() -> map {
    let avg = if perf_frames > 0 {
        perf_total_ms / perf_frames
    } else {
        0
    };
    return {
        "frames": perf_frames,
        "last_render_ms": perf_last_ms,
        "max_render_ms": perf_max_ms,
        "avg_render_ms": avg,
        "storage_saves": storage.save_count(),
    };
}

/// Reset frame performance counters (A-03).
public fn reset_perf() {
    perf_frames = 0;
    perf_last_ms = 0;
    perf_max_ms = 0;
    perf_total_ms = 0;
}

fn build_error_html(
    heading: string,
    detail: string,
    code: string = "E_RUNTIME",
    source: string = ""
) -> string {
    br.clear_slots_keep_epoch();
    let h = "<div class=\"page\"><div class=\"card dev-error-card\" style=\"gap:10px;\">"
    + "<div class=\"row\" style=\"justify-content:space-between;gap:8px;\">"
    + "<div class=\"title\" style=\"color:var(--danger)\">" + U.esc(heading) + "</div>"
    + "<span class=\"badge danger\">" + U.esc(code) + "</span></div>";
    if source != "" {
        h += "<div class=\"caption\">Source: " + U.esc(source) + "</div>";
    }
    h += "<div class=\"mono\">" + U.esc(detail) + "</div>";
    if dev_overlay_enabled {
        let tail = recent_logs(6);
        if tail.len() > 0 {
            h += "<div class=\"dev-log-box\">";
            for entry in tail {
                let lv = U.s(entry, "level").upper();
                let src = U.s(entry, "source");
                let msg = U.s(entry, "message");
                h += "<div class=\"mono caption\">[" + U.esc(lv) + "] " + U.esc(src) + ": " + U.esc(msg) + "</div>";
            }
            h += "</div>";
        }
    }
    h += "<div class=\"row\" style=\"gap:8px;margin-top:6px;\">";
    if nav.can_pop() {
        h += "<button class=\"btn secondary\" data-tap=\"" + br.slot((_ev) => nav.pop()) + "\">Go Back</button>";
    }
    h += "<button class=\"btn primary\" data-tap=\"" + br.slot((_ev) => {
    }) + "\">Reload</button>";
    h += "</div></div></div>";
    return h;
}

// Mounted-instance registry so plain handler functions can reach the running app:
//   App.current().restyle();
let current_app = null;
let dirty_render = false;
let bg_busy = false;
let rendering = false;

public fn mount(a) {
    current_app = a;
}

public fn current() -> App {
    return current_app;
}

/// Request a UI re-render on the next native event-loop tick (safe from spawn workers).
public fn request_render() {
    dirty_render = true;
}

/// Mark whether background spawn workers are active so native GUI polls for dirty renders.
public fn set_bg_busy(active: bool) {
    bg_busy = active;
}

/// Re-inject CSS + re-render from anywhere (wasm-safe, alias-friendly):
///   appkit.refresh_theme();
public fn refresh_theme() {
    let a = current();
    if a != null {
        a.restyle();
    }
}

/// Forward a structured AppError to the mounted App's opt-in on_error hook (A-32).
public fn report_error(
    source: string,
    message: string,
    code: string = "E_RUNTIME",
    retryable: bool = false
) {
    let a = current();
    if a != null {
        a.notify_error(source, message, code, retryable);
    }
}

public class App {
    public let app_name;
    public let bundle_id;
    public let version;
    private let pages;
    private let handlers;
    private let tab_defs;
    private let root_page;
    private let data_dir_path;
    private let boot_fn;
    private let ready_fn;
    private let error_fn;
    private let deep_link_fn;
    private let win_w;
    private let win_h;
    private let win_min_w;
    private let win_min_h;
    private let win_bg;
    private let win_icon;
    private let resize_fn;
    private let focus_fn;
    private let theme_changed_fn;
    private let file_drop_fn;
    private let before_close_fn;
    private let in_wasm;
    private let rendered_in_dispatch;
    private let client_ready;

    fn new (n: string, bid: string = "", ver: string = "1.0.0") {
        self.app_name = n;
        self.bundle_id = bid;
        self.version = ver;
        self.pages = {
        };
        self.handlers = {
        };
        self.tab_defs = [];
        self.root_page = "";
        self.data_dir_path = "storage";
        self.boot_fn = null;
        self.ready_fn = null;
        self.error_fn = null;
        self.deep_link_fn = null;
        self.win_w = 0;
        self.win_h = 0;
        self.win_min_w = 0;
        self.win_min_h = 0;
        self.win_bg = "";
        self.win_icon = "";
        self.resize_fn = null;
        self.focus_fn = null;
        self.theme_changed_fn = null;
        self.file_drop_fn = null;
        self.before_close_fn = null;
        self.in_wasm = false;
        self.rendered_in_dispatch = false;
        self.client_ready = false;
    }

    /// Register a page renderer: fn() -> component node (usually ui.page([...])).
    /// The first registered page is the root unless tab_pages() is used.
    public fn page(self, name: string, f) -> App {
        self.pages[name] = f;
        if self.root_page == "" {
            self.root_page = name;
        }
        return self;
    }

    /// Register a named event handler: fn(ev: map). Referenced by name in components.
    public fn handler(self, name: string, f) -> App {
        self.handlers[name] = f;
        return self;
    }

    /// Bottom tab bar. Entries: page names, or {"label","icon"} maps
    /// whose "label" is the page name.
    public fn tab_pages(self, tabs: list) -> App {
        self.tab_defs = tabs;
        return self;
    }

    /// Directory for Storage (default "./storage").
    public fn data_dir(self, d: string) -> App {
        self.data_dir_path = d;
        return self;
    }

    /// Boot function: called before the first render (seed storage, load data).
    public fn boot(self, f) -> App {
        self.boot_fn = f;
        return self;
    }

    /// Ready callback: invoked once when the native webview reports ready (after main returns).
    public fn on_ready(self, f) -> App {
        self.ready_fn = f;
        return self;
    }

    /// Opt-in crash/error hook: invoked with an AppError whenever a page, handler, boot,
    /// ready, or render boundary catches an exception (A-32).
    public fn on_error(self, f) -> App {
        self.error_fn = f;
        return self;
    }

    /// Register a deep-link / OAuth redirect callback handler: fn(ev: map) (A-53).
    /// Inbound events include `value` (raw URL) and `parsed` ({url, scheme, host, path, query}).
    public fn on_deep_link(self, f) -> App {
        self.deep_link_fn = f;
        return self;
    }

    /// Enable or disable the dev error overlay with structured log tail (A-24).
    public fn dev_mode(self, flag: bool = true) -> App {
        set_dev_mode(flag);
        return self;
    }

    /// Notify the opt-in error hook with a structured AppError without crashing the boundary.
    public fn notify_error(
        self,
        source: string,
        message: string,
        code: string = "E_RUNTIME",
        retryable: bool = false
    ) {
        log_error(source, message, code);
        if self.error_fn == null {
            return;
        }
        let err = errors.make(code, message, source, retryable);
        try {
            let ef = self.error_fn;
            ef(err);
        } catch (_hook_err) {
            let _ignored = _hook_err;
        }
    }

    /// REQUIRED for native (desktop/dev) mode: install the entry-file GUI shims.
    /// gui_* natives only link inside the entry file. `studio new` generates them:
    ///
    ///   fn studio_title(t: string) { gui_title(t); }
    ///   fn studio_html(h: string) { gui_set_html(h); }
    ///   fn studio_eval(js: string) { gui_eval(js); }
    ///   fn studio_on(n: string, cb) { gui_on(n, cb); }
    ///   fn studio_emit(n: string, p: string) { gui_emit(n, p); }
    public fn bridge(self, f_title, f_html, f_eval, f_on, f_emit) -> App {
        br.install(f_title, f_html, f_eval, f_on, f_emit);
        return self;
    }

    /// Optional desktop window control shims (gui_size, gui_min_size, gui_theme, gui_bg_color, gui_icon, etc.).
    public fn window_bridge(self, api: map) -> App {
        br.install_window_api(api);
        return self;
    }

    /// Configure initial desktop window dimensions in logical pixels.
    public fn window_size(self, w: int, h: int) -> App {
        self.win_w = w;
        self.win_h = h;
        return self;
    }

    /// Configure minimum desktop window dimensions in logical pixels.
    public fn window_min_size(self, w: int, h: int) -> App {
        self.win_min_w = w;
        self.win_min_h = h;
        return self;
    }

    /// Configure desktop webview startup background hex color (#RRGGBB / #RRGGBBAA).
    public fn window_bg(self, hex: string) -> App {
        self.win_bg = hex;
        return self;
    }

    /// Configure desktop window & taskbar icon path (.ico or .png).
    public fn window_icon(self, path: string) -> App {
        self.win_icon = path;
        return self;
    }

    /// Register desktop window resize callback: fn(ev: map) with {"width", "height"}.
    public fn on_resize(self, f) -> App {
        self.resize_fn = f;
        return self;
    }

    /// Register desktop window focus callback: fn(ev: map) with {"focused"}.
    public fn on_focus(self, f) -> App {
        self.focus_fn = f;
        return self;
    }

    /// Register OS/webview theme-change callback: fn(ev: map) with {"theme"}.
    public fn on_theme_changed(self, f) -> App {
        self.theme_changed_fn = f;
        return self;
    }

    /// Register file-drop callback: fn(ev: map) with {"paths", "x", "y"}.
    public fn on_file_drop(self, f) -> App {
        self.file_drop_fn = f;
        return self;
    }

    /// Register close-request callback: fn(ev: map); call Bridge.cancel_close() to veto.
    public fn on_before_close(self, f) -> App {
        self.before_close_fn = f;
        return self;
    }

    /// Shared boot: handler registry, router, storage, mounted instance.
    public fn prepare(self, is_wasm: bool = false) {
        self.in_wasm = is_wasm;
        if is_wasm {
            br.set_host_caps({
                "platform": "web"
            });
        } else {
            br.set_host_caps({
                "platform": "native"
            });
        }
        br.drain_effects();
        for (hname, f) in self.handlers {
            br.named_handler(hname, f);
        }
        if self.deep_link_fn != null {
            let dl_fn = self.deep_link_fn;
            br.on_deep_link((ev) => {
                let raw_u = if ev != null and type_of(ev) == "map" and ev.has("value") and ev["value"] != null {
                    string(ev["value"])
                } else {
                    ""
                };
                let parsed = br.parse_deep_link(raw_u);
                let out_ev = U.deep_copy(ev);
                if type_of(out_ev) != "map" {
                    out_ev = {
                        "sid": "__studio_deep_link__", "kind": "deep_link", "value": raw_u
                    };
                }
                out_ev["parsed"] = parsed;
                dl_fn(out_ev);
            });
        }
        if self.tab_defs.len() > 0 {
            nav.configure(self.tab_defs);
        } else {
            nav.configure_single(self.root_page);
        }
        storage.set_memory_only(is_wasm);
        storage.configure(self.data_dir_path);
        mount(self);
    }

    /// HTML for the current route (page + chrome).
    private fn page_html(self) -> string {
        let pname = nav.page_name();
        if not self.pages.has(pname) {
            return "<div class=\"page\"><h2>Page not found</h2><p class=\"muted\">No page registered as '"
            + U.esc(pname) + "'. Registered: " + U.esc(string(self.pages.keys())) + "</p></div>";
        }
        let f = self.pages[pname];
        let node = null;
        try {
            node = f();
        } catch (e) {
            self.notify_error("page:" + pname, string(e), "E_PAGE_RENDER", false);
            return build_error_html("Page '" + pname + "' failed", string(e));
        }
        if node == null or type_of(node) != "map" {
            return "<div class=\"page\"><h2>Page error</h2><p class=\"muted\">Page '" + U.esc(pname) + "' did not return a component node.</p></div>";
        }
        try {
            if not node.has("el") or string(node["el"]) != "page" {
                let wrap = {
                    "el": "page", "pagekey": pname, "children": [node]
                };
                return render.document(wrap, nav.tabs(), nav.tab_index());
            }
            node["pagekey"] = pname;
            return render.document(node, nav.tabs(), nav.tab_index());
        } catch (e) {
            self.notify_error("render:" + pname, string(e), "E_RENDER", false);
            return build_error_html("Render failed on '" + pname + "'", string(e));
        }
    }

    private fn flush_native_effects(self) {
        if self.in_wasm or not self.client_ready {
            return;
        }
        let efs = br.drain_effects();
        if efs.len() > 0 {
            br.eval(
                r#"(function(e){if(window.__studio&&window.__studio.runEffects){window.__studio.runEffects(e);}})("#
                + json_write(efs) + ");"
            );
        }
    }

    private fn sync_native_poll(self) {
        if self.in_wasm or not self.client_ready {
            return;
        }
        let active_js = if dirty_render or bg_busy {
            "true"
        } else {
            "false"
        };
        br.eval(
            "(function(){if(window.__studio&&window.__studio.setPoll){window.__studio.setPoll("
            + active_js + ",140);}})();"
        );
    }

    /// Render the current route into the webview (native mode).
    /// Queues re-entrant render calls via dirty_render instead of dropping frames (A-28).
    public fn render(self) {
        if rendering {
            dirty_render = true;
            return;
        }
        rendering = true;
        let passes = 0;
        try {
            while passes < 4 {
                dirty_render = false;
                passes += 1;
                let t0 = safe_now_ms();
                br.clear_slots();
                let html = self.page_html();
                record_frame_ms(safe_now_ms() - t0);
                if not self.in_wasm and self.client_ready {
                    br.eval(
                        r#"(function(h){if(window.__studio&&window.__studio.patch){window.__studio.patch(h);}else{var r=document.getElementById('spid3r-root')||document.body;if(r){r.innerHTML=h;}}})("#
                        + json_write(html) + ");"
                    );
                } else {
                    br.set_html(html);
                }
                self.flush_native_effects();
                self.sync_native_poll();
                self.rendered_in_dispatch = true;
                if not dirty_render {
                    break;
                }
            }
        } catch (e) {
            rendering = false;
            throw e;
        }
        rendering = false;
    }

    /// Re-inject the stylesheet (after Theme changes) and re-render.
    public fn restyle(self) {
        if self.in_wasm {
            return;
        }
        let tokens = theme.tokens();
        let mode_s = if tokens.has("mode") {
            string(tokens["mode"])
        } else {
            "light"
        };
        let bg_s = if tokens.has("bg") {
            string(tokens["bg"])
        } else {
            ""
        };
        br.set_window_theme(mode_s);
        if bg_s != "" {
            br.set_window_bg_color(bg_s);
        }
        let css_json = json_write(css.stylesheet());
        br.eval(
            "(function(){var css=" + css_json
            + ";var el=document.querySelector('style[data-studio]');if(el){el.textContent=css;}"
            + "else{var s=document.createElement('style');s.setAttribute('data-studio','1');s.textContent=css;document.head.appendChild(s);}})();"
        );
        self.render();
    }

    /// Persist router/state/theme/i18n snapshot across desktop hot-reload restarts (A-23).
    public fn save_hot_snapshot(self, path: string = ".studio-hot-state.json") -> bool {
        let snap = {
            "app": self.app_name,
            "router": nav.snapshot(),
            "state": state.snapshot(),
            "theme": theme.snapshot(),
            "i18n": i18n.snapshot(),
        };
        return write_file(path, json_write(snap)).is_ok();
    }

    /// Restore hot-reload snapshot if present and delete the transient file (A-23).
    public fn restore_hot_snapshot(self, path: string = ".studio-hot-state.json") -> bool {
        if not file_exists(path) {
            return false;
        }
        let r = read_file(path);
        let _rm = remove_file(path);
        if r.is_err() {
            return false;
        }
        try {
            let m = json_parse(string(r.unwrap()));
            if type_of(m) != "map" {
                return false;
            }
            if m.has("app") and string(m["app"]) != "" and string(m["app"]) != self.app_name {
                return false;
            }
            if m.has("router") and type_of(m["router"]) == "map" {
                nav.restore(m["router"]);
            }
            if m.has("state") and type_of(m["state"]) == "map" {
                state.restore(m["state"]);
            }
            if m.has("theme") and type_of(m["theme"]) == "map" {
                theme.restore(m["theme"]);
            }
            if m.has("i18n") and type_of(m["i18n"]) == "map" {
                i18n.restore(m["i18n"]);
            }
            return true;
        } catch (_e) {
            return false;
        }
    }

    private fn dispatch_window_event(self, kind: string, cb, raw_a, raw_b) {
        if cb == null {
            return;
        }
        let raw_payload = if raw_b != null {
            raw_b
        } else {
            raw_a
        };
        let ev_map = {
            "event": kind,
            "raw": raw_payload,
        };
        if type_of(raw_payload) == "string" {
            let trimmed = string(raw_payload).trim();
            if trimmed.starts_with("{") or trimmed.starts_with("[") {
                try {
                    let parsed = json_parse(trimmed);
                    if type_of(parsed) == "map" {
                        for (pk, pv) in parsed {
                            ev_map[string(pk)] = pv;
                        }
                    }
                } catch (_pe) {
                    let _skip_pe = _pe;
                }
            }
        } elif type_of(raw_payload) == "map" {
            for (pk, pv) in raw_payload {
                ev_map[string(pk)] = pv;
            }
        }
        try {
            cb(ev_map);
        } catch (e) {
            self.notify_error("window:" + kind, string(e), "E_WINDOW_EVENT", false);
        }
        if dirty_render {
            try {
                self.render();
            } catch (e2) {
                self.notify_error("window_render:" + kind, string(e2), "E_RENDER", true);
                br.set_html(build_error_html("Render error", string(e2)));
            }
        }
    }

    /// Boot the app in the native webview and run until the window closes.
    public fn run(self) -> int {
        self.prepare();
        br.set_title(self.app_name);
        if int(self.win_w) > 0 and int(self.win_h) > 0 {
            br.set_window_size(int(self.win_w), int(self.win_h));
        }
        if int(self.win_min_w) > 0 and int(self.win_min_h) > 0 {
            br.set_window_min_size(int(self.win_min_w), int(self.win_min_h));
        }
        if string(self.win_icon) != "" {
            br.set_window_icon(string(self.win_icon));
        }
        if self.boot_fn != null {
            let bf = self.boot_fn;
            bf();
        }
        self.restore_hot_snapshot();
        let boot_tokens = theme.tokens();
        let boot_mode = if boot_tokens.has("mode") {
            string(boot_tokens["mode"])
        } else {
            "light"
        };
        let boot_bg = if string(self.win_bg) != "" {
            string(self.win_bg)
        } elif boot_tokens.has("bg") {
            string(boot_tokens["bg"])
        } else {
            ""
        };
        br.set_window_theme(boot_mode);
        if boot_bg != "" {
            br.set_window_bg_color(boot_bg);
        }
        br.eval(
            "(function(){var s=document.createElement('style');s.setAttribute('data-studio','1');s.textContent="
            + json_write(css.stylesheet()) + ";document.head.appendChild(s);})();"
        );
        br.eval(client.runtime_js());
        self.client_ready = true;
        self.render();

        if self.resize_fn != null {
            let rfn = self.resize_fn;
            br.on(
                "resize",
                (a, b = null) => self.dispatch_window_event("resize", rfn, a, b)
            );
        }
        if self.focus_fn != null {
            let ffn = self.focus_fn;
            br.on(
                "focus",
                (a, b = null) => self.dispatch_window_event("focus", ffn, a, b)
            );
        }
        if self.theme_changed_fn != null {
            let tfn = self.theme_changed_fn;
            br.on(
                "theme_changed",
                (a, b = null) => self.dispatch_window_event("theme_changed", tfn, a, b)
            );
        }
        if self.file_drop_fn != null {
            let dfn = self.file_drop_fn;
            br.on(
                "file_drop",
                (a, b = null) => self.dispatch_window_event("file_drop", dfn, a, b)
            );
        }
        if self.before_close_fn != null {
            let cfn = self.before_close_fn;
            br.on(
                "before_close",
                (a, b = null) => self.dispatch_window_event("before_close", cfn, a, b)
            );
        }

        br.on("ui", (a, b = null) => {
            let ev = if b != null {
                b
            } else {
                a
            };
            let p = br.normalize(ev);
            if p != null and p.has("sid") and string(p["sid"]) == "__studio_tick__" {
                if dirty_render {
                    try {
                        self.render();
                    } catch (e) {
                        self.notify_error("tick_render", string(e), "E_RENDER", true);
                        br.set_html(build_error_html("Render error", string(e)));
                    }
                } else {
                    self.sync_native_poll();
                }
                if file_exists(".studio-reload") {
                    self.save_hot_snapshot();
                    request_shutdown();
                } elif file_exists(".studio-stop") {
                    request_shutdown();
                }
                return;
            }
            self.rendered_in_dispatch = false;
            let err = br.dispatch_safe(ev);
            if err != "" {
                self.notify_error("handler", err, "E_HANDLER", false);
                br.set_html(build_error_html("Handler error", err));
                return;
            }
            if not self.rendered_in_dispatch {
                try {
                    self.render();
                } catch (e) {
                    self.notify_error("render", string(e), "E_RENDER", true);
                    br.set_html(build_error_html("Render error", string(e)));
                }
            } else {
                self.sync_native_poll();
            }
        });

        br.on("ready", (_a, _b = null) => {
            if self.ready_fn != null {
                try {
                    let rf = self.ready_fn;
                    rf();
                } catch (e) {
                    self.notify_error("ready", string(e), "E_READY", false);
                    br.set_html(build_error_html("Ready error", string(e)));
                    return;
                }
            }
            if dirty_render {
                try {
                    self.render();
                } catch (e2) {
                    self.notify_error("ready_render", string(e2), "E_RENDER", true);
                    br.set_html(build_error_html("Render error", string(e2)));
                }
            } else {
                self.sync_native_poll();
            }
        });

        // Return immediately with zero active background tasks so `spid3r gui` enters its
        // native WebView2/tao event loop with no drain delay; dirty_render refreshes are
        // driven on demand by `window.__studio.setPoll(...)` via `__studio_tick__`.
        return 0;
    }

    /// Wasm/mobile REPL mode: restore, boot, dispatch one event, render, and
    /// answer with an atomic @@STUDIO_FRAME@@ JSON line on stdout.
    public fn wasm_run(self, ev_json: string) -> int {
        self.prepare(true);
        let had_event = false;
        let err_title = "";
        let err_msg = "";
        let client_tv = 0;
        let client_html_hash = "";
        let incoming_nonce = "";
        let incoming_epoch = 1;
        if ev_json != "" {
            let env = null;
            try {
                env = json_parse(ev_json);
            } catch (_e) {
                env = null;
            }
            if env != null and type_of(env) == "map" {
                if env.has("caps") and type_of(env["caps"]) == "map" {
                    br.set_host_caps(env["caps"]);
                }
                if env.has("router") and type_of(env["router"]) == "map" {
                    nav.restore(env["router"]);
                }
                if env.has("state") and type_of(env["state"]) == "map" {
                    state.restore(env["state"]);
                }
                if env.has("storage") and type_of(env["storage"]) == "map" {
                    storage.hydrate(env["storage"]);
                }
                if env.has("storage_version") and env["storage_version"] != null {
                    storage.set_version(U.ival(env, "storage_version", 0));
                }
                if env.has("theme") and type_of(env["theme"]) == "map" {
                    theme.restore(env["theme"]);
                }
                if env.has("i18n") and type_of(env["i18n"]) == "map" {
                    i18n.restore(env["i18n"]);
                }
                if env.has("theme_version") and env["theme_version"] != null {
                    let tv = U.ival(env, "theme_version", 0);
                    if tv > 0 {
                        client_tv = tv;
                        theme.set_version(tv);
                    }
                }
                if env.has("html_hash") and env["html_hash"] != null {
                    client_html_hash = string(env["html_hash"]);
                }
                if env.has("slot_nonce") and env["slot_nonce"] != null {
                    incoming_nonce = string(env["slot_nonce"]).trim();
                }
                if env.has("frame_epoch") and env["frame_epoch"] != null {
                    let fe = U.ival(env, "frame_epoch", 1);
                    if fe > 0 {
                        incoming_epoch = fe;
                    }
                }
                if env.has("event") and br.is_valid_event(env["event"]) {
                    let ev_obj = env["event"];
                    let sid = string(ev_obj["sid"]);
                    let flushed_list = [];
                    if ev_obj.has("flushed") and type_of(ev_obj["flushed"]) == "list" {
                        for fev in ev_obj["flushed"] {
                            if br.is_valid_event(fev) {
                                flushed_list.push(fev);
                            }
                        }
                    }
                    let needs_slots = sid != "__studio_back__" and sid != "" and not br.has_named(sid);
                    if not needs_slots {
                        for fev in flushed_list {
                            if not br.has_named(string(fev["sid"])) {
                                needs_slots = true;
                                break;
                            }
                        }
                    }
                    if needs_slots {
                        // Restore the exact previous frame's slot nonce + epoch before regenerating
                        // closure slots so only authentic current-frame sids match (A-13).
                        try {
                            br.clear_slots();
                            br.set_slot_context(incoming_nonce, incoming_epoch);
                            let _pre_html = self.page_html();
                        } catch (_re) {
                            let _r1 = _re;
                        }
                    }
                    for fev in flushed_list {
                        let fsid = string(fev["sid"]);
                        let fh = br.lookup(fsid);
                        if fh != null {
                            try {
                                fh(fev);
                            } catch (fe) {
                                err_title = "Handler '" + fsid + "' failed";
                                err_msg = string(fe);
                                self.notify_error("handler:" + fsid, err_msg, "E_HANDLER", false);
                                break;
                            }
                        }
                    }
                    if err_msg != "" {
                        had_event = true;
                    } elif sid == "__studio_back__" {
                        if nav.can_pop() {
                            nav.pop();
                        }
                        had_event = true;
                    } elif sid != "" {
                        let h = br.lookup(sid);
                        if h != null {
                            try {
                                h(ev_obj);
                            } catch (e) {
                                err_title = "Handler '" + sid + "' failed";
                                err_msg = string(e);
                                self.notify_error("handler:" + sid, err_msg, "E_HANDLER", false);
                            }
                        }
                        had_event = true;
                    }
                }
            }
        }
        if not had_event and err_msg == "" and self.boot_fn != null {
            try {
                let bf = self.boot_fn;
                bf();
            } catch (e) {
                err_title = "Boot failed";
                err_msg = string(e);
                self.notify_error("boot", err_msg, "E_BOOT", false);
            }
        }
        let next_epoch = if had_event {
            incoming_epoch + 1
        } else {
            incoming_epoch
        };
        let html = "";
        let effects = [];
        let t_render_0 = safe_now_ms();
        if err_msg != "" {
            br.drain_effects();
            br.set_slot_context(incoming_nonce, next_epoch);
            html = build_error_html(err_title, err_msg, "E_HANDLER", "wasm");
        } else {
            br.clear_slots();
            br.set_slot_context(incoming_nonce, next_epoch);
            html = self.page_html();
            effects = br.drain_effects();
        }
        let render_ms = safe_now_ms() - t_render_0;
        record_frame_ms(render_ms);
        let cur_tv = theme.version();
        let emit_css = "";
        if client_tv == 0 or cur_tv != client_tv {
            emit_css = css.stylesheet();
        }
        let cur_html_hash = U.fnv_hex(html);
        let emit_html = if client_html_hash != "" and client_html_hash == cur_html_hash {
            null
        } else {
            html
        };
        let frame = {
            "css": emit_css,
            "theme_version": cur_tv,
            "storage_version": storage.version(),
            "html": emit_html,
            "html_hash": cur_html_hash,
            "slot_nonce": br.session_nonce(),
            "frame_epoch": br.slot_epoch_id(),
            "title": self.app_name,
            "router": nav.snapshot(),
            "state": state.snapshot(),
            "storage": storage.all(),
            "theme": theme.snapshot(),
            "i18n": i18n.snapshot(),
            "perf": {
                "render_ms": render_ms
            }
            ,
            "effects": effects,
        };
        println("@@STUDIO_FRAME@@");
        println(json_write(frame));
        return 0;
    }
}
