// gui/pages/Platforms.matrix
// Balanced 2x2 Desktop platform matrix for Desktop, Web/PWA, iOS (.ipa), and Android APK.

import "studio/Components" as ui;
import "studio/State" as state;
import "studio/Bridge" as br;
import "studio/Router" as nav;
import "gui/Icons" as ico;
import "gui/Jobs" as jobs;
import "gui/Toolchain" as tc;
import "gui/Shell" as shell;

fn desktop_card(appdir: string, ready: bool, busy: bool) -> map {
    let badge = if ready {
        ui.badge("Ready", "success")
    } else {
        ui.badge("Missing spid3r", "danger")
    };
    let info = state.get_or("proj_info", null);
    let built_note = "Host: Direct OS WebView2 window (zero browser needed)";
    if info != null and type_of(info) == "map" and info["built_desktop"] == true {
        built_note = "Built executable: " + appdir + "/build/desktop";
    }
    return ui.card([ui.column([ui.row([ui.row([ico.desktop()], {
        "cls": "cc-icon-box indigo"
    }), ui.column([ui.title("Desktop Native"), ui.caption(
        "Native WebView2 preview, hot reload & release executable"
    ),], {
        "flex": 1
    }), badge,], {
        "gap": 10
    }), ui.divider(), ui.row([ui.text(built_note, "cc-code-text")], {
        "cls": "cc-code-box"
    }), ui.spacer(8),]), ui.column([ui.row([ui.button("Run Preview", (_ev) => jobs.launch_native_preview(appdir), "primary", {
        "flex": 1, "disabled": not ready
    }), ui.button("Hot-Reload Dev", (_ev) => jobs.launch_native_dev(appdir), "secondary", {
        "flex": 1, "disabled": not ready
    }),], {
        "gap": 8
    }), ui.spacer(8), ui.row([ui.button("Build Release Exe", (_ev) => {
        jobs.run_async("Build Desktop: " + appdir, () => {
            let m = jobs.run_studio_cli(["build", appdir, "--target", "desktop"]);
            jobs.append_exec_logs(m);
            state.set("proj_info", jobs.project_info(appdir));
            return int(m["code"]) == 0;
        });
    }, "outline", {
        "flex": 1, "disabled": busy or not ready
    }), ui.button("Check Entry", (_ev) => {
        jobs.run_async("Static Check: " + appdir, () => {
            let m = jobs.run_studio_cli(["check", appdir]);
            jobs.append_exec_logs(m);
            return int(m["code"]) == 0;
        });
    }, "secondary", {
        "flex": 1, "disabled": busy or not ready
    }),], {
        "gap": 8
    }),]),], {
        "cls": "cc-plat-card cc-accent-indigo"
    });
}

fn web_card(appdir: string, ready: bool, busy: bool) -> map {
    let web_on = state.get_or("web_running", false) == true;
    let host = string(state.get_or("web_host", "0.0.0.0"));
    let port = string(state.get_or("web_port", "8080"));
    let lan_ip = string(state.get_or("lan_ip", "127.0.0.1"));
    let local_url = "http://127.0.0.1:" + port + "/index.html";
    let lan_url = "http://" + lan_ip + ":" + port + "/index.html";

    let badge = ui.badge("Missing spid3r", "danger");
    if web_on {
        badge = ui.badge("LIVE :" + port, "success");
    } elif ready {
        badge = ui.badge("Ready", "success");
    }

    return ui.card([ui.column([ui.row([ui.row([ico.web()], {
        "cls": "cc-icon-box cyan"
    }), ui.column([ui.title("Web & Mobile PWA"), ui.caption(
        "WASM Worker runtime + offline sw.js + Phone Home Screen"
    ),], {
        "flex": 1
    }), badge,], {
        "gap": 10
    }), ui.divider(), ui.row([ui.input("Host (0.0.0.0)", (_ev) => state.set("web_host", string(_ev["value"])), host, "text", {
        "flex": 1
    }), ui.input("Port (8080)", (_ev) => state.set("web_port", string(_ev["value"])), port, "text", {
        "width": "110px"
    }),], {
        "gap": 8
    }), ui.spacer(8), ui.row([ui.text(lan_url, "cc-code-text"), ui.button("Copy Phone URL", (_ev) => {
        br.copy_text(lan_url);
        state.set("toast_msg", "Copied " + lan_url);
    }, "ghost", {
        "cls": "cc-sm"
    }), ui.button("Open", (_ev) => br.open_url(local_url), "ghost", {
        "cls": "cc-sm"
    }),], {
        "cls": "cc-code-box"
    }),]), ui.column([ui.spacer(8), ui.row([ui.button("Build Web + PWA", (_ev) => {
        jobs.run_async("Build Web: " + appdir, () => {
            let m = jobs.run_studio_cli(["build", appdir, "--target", "web"]);
            jobs.append_exec_logs(m);
            state.set("proj_info", jobs.project_info(appdir));
            return int(m["code"]) == 0;
        });
    }, "secondary", {
        "flex": 1, "disabled": busy or not ready
    }), if web_on {
        ui.button("Stop Server", (_ev) => jobs.stop_web_server(), "danger", {
            "flex": 1
        })
    } else {
        ui.button("Start LAN Server", (_ev) => jobs.start_web_server(appdir, host, port), "primary", {
            "flex": 1, "disabled": not ready
        })
    },], {
        "gap": 8
    }),]),], {
        "cls": "cc-plat-card cc-accent-cyan"
    });
}

fn ios_card(appdir: string, rd: map, busy: bool) -> map {
    let missing = int(rd["ios_missing"]);
    let badge = if missing == 0 {
        ui.badge("Ready", "success")
    } else {
        ui.badge(string(missing) + " setup item(s)", "accent")
    };
    let udid = string(state.get_or("ios_udid", ""));
    let busid = string(state.get_or("ios_busid", ""));
    let usb_st = string(state.get_or("ios_usb_state", ""));
    let dev_line = "USB iPhone: Not plugged in (or use Web LAN Wi-Fi)";
    if udid != "" {
        dev_line = "iPhone Paired in WSL2: " + udid;
    } elif busid != "" {
        dev_line = "iPhone BUSID " + busid + " (" + usb_st + ")";
    }
    let xip_val = string(state.get_or("ios_xip_path", ""));

    let foot_kids = [
    ui.row([ui.button("Build iOS Pkg", (_ev) => {
        jobs.run_async("Build iOS: " + appdir, () => {
            let m = jobs.run_studio_cli(["build", appdir, "--target", "ios"]);
            jobs.append_exec_logs(m);
            state.set("proj_info", jobs.project_info(appdir));
            return int(m["code"]) == 0;
        });
    }, "secondary", {
        "flex": 1, "disabled": busy
    }), ui.button("Install .ipa on iPhone", (_ev) => {
        jobs.run_async("Install iOS .ipa: " + appdir, () => {
            let m = jobs.run_studio_cli(["ios", "run", appdir]);
            jobs.append_exec_logs(m);
            state.set("proj_info", jobs.project_info(appdir));
            return int(m["code"]) == 0;
        });
    }, "primary", {
        "flex": 1, "disabled": busy
    }),], {
        "gap": 8
    }),
    ui.spacer(6),
    ui.row([ui.button("Attach USB", (_ev) => tc.run_tool_action("attach_usb_ios"), "outline", {
        "cls": "cc-sm", "disabled": busy
    }), ui.button("Launch", (_ev) => {
        jobs.run_async("Launch iOS: " + appdir, () => {
            let m = jobs.run_studio_cli(["ios", "launch", appdir]);
            jobs.append_exec_logs(m);
            return int(m["code"]) == 0;
        });
    }, "ghost", {
        "cls": "cc-sm", "disabled": busy
    }), ui.button("Uninstall", (_ev) => {
        jobs.run_async("Uninstall iOS: " + appdir, () => {
            let m = jobs.run_studio_cli(["ios", "uninstall", appdir]);
            jobs.append_exec_logs(m);
            return int(m["code"]) == 0;
        });
    }, "ghost", {
        "cls": "cc-sm", "disabled": busy
    }), ui.button("Apple Auth", (_ev) => tc.run_tool_action("open_apple_auth"), "ghost", {
        "cls": "cc-sm"
    }),], {
        "gap": 6, "wrap": true
    }),
    ];
    if missing > 0 {
        foot_kids.push(ui.spacer(4));
        foot_kids.push(ui.button("Fix Missing iOS Requirements in Doctor ->", (_ev) => nav.replace("Doctor"), "ghost", {
            "cls": "cc-sm"
        }));
    }

    return ui.card([ui.column([ui.row([ui.row([ico.phone()], {
        "cls": "cc-icon-box indigo"
    }), ui.column([ui.title("iOS Native (.ipa — iPhone)"), ui.caption(
        "SwiftPM + xtool 1.24.0 + 16 KB chunked USB installer"
    ),], {
        "flex": 1
    }), badge,], {
        "gap": 10
    }), ui.divider(), ui.row([ui.text(dev_line, "cc-code-text")], {
        "cls": "cc-code-box"
    }), ui.spacer(6), ui.row([ui.input("Path to Xcode.xip (optional)", (_ev) => state.set("ios_xip_path", string(_ev["value"])), xip_val, "text", {
        "flex": 1
    }), ui.button("Install SDK", (_ev) => tc.run_tool_action(
        "install_darwin_sdk",
        string(state.get_or("ios_xip_path", ""))
    ), "outline", {
        "cls": "cc-sm", "disabled": busy
    }),], {
        "gap": 8
    }), ui.spacer(8),]), ui.column(foot_kids),], {
        "cls": "cc-plat-card cc-accent-violet"
    });
}

fn android_card(appdir: string, rd: map, busy: bool) -> map {
    let missing = int(rd["android_missing"]);
    let badge = if missing == 0 {
        ui.badge("Ready", "success")
    } else {
        ui.badge(string(missing) + " missing", "accent")
    };
    let adb_txt = string(state.get_or("adb_devices_text", ""));
    let dev_note = if adb_txt == "" {
        "Gradle + Java JDK 17+ + ANDROID_HOME required for APK builds"
    } else {
        jobs.first_line(adb_txt)
    };

    return ui.card([ui.column([ui.row([ui.row([ico.android()], {
        "cls": "cc-icon-box emerald"
    }), ui.column([ui.title("Android (APK / Gradle)"), ui.caption(
        "Kotlin WebViewAssetLoader + Hardware Back + ADB deploy"
    ),], {
        "flex": 1
    }), badge,], {
        "gap": 10
    }), ui.divider(), ui.row([ui.text(dev_note, "cc-code-text")], {
        "cls": "cc-code-box"
    }), ui.spacer(8),]), ui.column([ui.row([ui.button("Build Android Project", (_ev) => {
        jobs.run_async("Build Android: " + appdir, () => {
            let m = jobs.run_studio_cli(["build", appdir, "--target", "android"]);
            jobs.append_exec_logs(m);
            state.set("proj_info", jobs.project_info(appdir));
            return int(m["code"]) == 0;
        });
    }, "primary", {
        "flex": 1, "disabled": busy
    }), ui.button("Assemble Debug APK", (_ev) => {
        jobs.run_async("Gradle assembleDebug: " + appdir, () => {
            let gdir = jobs.join_dir(appdir, "build/android/AndroidApp");
            if not is_dir(gdir) {
                let bm = jobs.run_studio_cli(["build", appdir, "--target", "android"]);
                jobs.append_exec_logs(bm);
            }
            let gm = jobs.run_exec("gradle", ["assembleDebug"], gdir);
            jobs.append_exec_logs(gm);
            return int(gm["code"]) == 0;
        });
    }, "secondary", {
        "flex": 1, "disabled": busy or missing > 0
    }),], {
        "gap": 8
    }), ui.spacer(6), ui.row([ui.button("Install APK (adb)", (_ev) => {
        jobs.run_async("ADB Install: " + appdir, () => {
            let apk = jobs.join_dir(
                appdir,
                "build/android/AndroidApp/app/build/outputs/apk/debug/app-debug.apk"
            );
            let m = jobs.run_exec("adb", ["install", "-r", apk], null);
            jobs.append_exec_logs(m);
            return int(m["code"]) == 0;
        });
    }, "outline", {
        "cls": "cc-sm", "disabled": busy or missing > 0
    }), ui.button("Download Missing Tools ->", (_ev) => nav.replace("Doctor"), "ghost", {
        "cls": "cc-sm"
    }),], {
        "gap": 8
    }),]),], {
        "cls": "cc-plat-card cc-accent-emerald"
    });
}

public fn Platforms() -> map {
    let appdir = string(state.get_or("active_project", "examples/demo"));
    let busy = state.get_or("job_busy", false) == true;
    let rd = state.get_or("readiness", {
        "desktop_ok": true, "web_ok": true, "ios_missing": 0, "android_missing": 4
    });
    if type_of(rd) != "map" {
        rd = {
            "desktop_ok": true, "web_ok": true, "ios_missing": 0, "android_missing": 4
        };
    }

    let grid = ui.grid([desktop_card(appdir, rd["desktop_ok"] == true, busy), web_card(appdir, rd["web_ok"] == true, busy), ios_card(appdir, rd, busy), android_card(appdir, rd, busy),], 2, 16, {
        "cls": "cc-plat-grid"
    });

    return shell.render_shell(
        "Platforms",
        "Cross-Platform Targets",
        "Build, preview, serve on Wi-Fi, or deploy native packages for " + appdir + ".",
        [grid]
    );
}
