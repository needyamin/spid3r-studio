// gui/Toolchain.matrix
// Cross-platform dependency probing, readiness calculation, recommendations, and 1-click installs.

import "studio/State" as state;
import "studio/Bridge" as br;
import "gui/Jobs" as jobs;

fn make_check(
    id: string,
    name: string,
    cat: string,
    status: string,
    detail: string,
    req_for: string,
    rec: string,
    act_kind: string,
    act_label: string,
    act_arg: string,
    cmd_hint: string
) -> map {
    return {
        "id": id,
        "name": name,
        "category": cat,
        "status": status,
        "detail": detail,
        "required_for": req_for,
        "recommendation": rec,
        "action_kind": act_kind,
        "action_label": act_label,
        "action_arg": act_arg,
        "cmd_hint": cmd_hint,
    };
}

/// Pure function computing readiness across all 4 targets from probe records.
public fn evaluate_readiness(checks: list) -> map {
    let by_id = {
    };
    for c in checks {
        if type_of(c) == "map" and c.has("id") {
            by_id[string(c["id"])] = string(c["status"]) == "ok";
        }
    }
    let has_spid3r = by_id.has("spid3r") and by_id["spid3r"] == true;
    let is_win = by_id.has("wsl2");
    let ios_keys = if is_win {
        ["spid3r", "wsl2", "xtool", "swift_wsl", "darwin_sdk", "usbmuxd", "ideviceinstaller", "usbipd", "apple_auth"]
    } else {
        ["spid3r", "xtool", "swift_wsl", "darwin_sdk", "apple_auth"]
    };
    let ios_missing = 0;
    for k in ios_keys {
        if not (by_id.has(k) and by_id[k] == true) {
            ios_missing += 1;
        }
    }

    let and_keys = ["java", "gradle", "adb", "android_home"];
    let and_missing = 0;
    for k in and_keys {
        if not (by_id.has(k) and by_id[k] == true) {
            and_missing += 1;
        }
    }

    let total_ok = 0;
    let total_issues = 0;
    for c in checks {
        if type_of(c) == "map" and c.has("status") {
            if string(c["status"]) == "ok" {
                total_ok += 1;
            } else {
                total_issues += 1;
            }
        }
    }

    return {
        "desktop_ok": has_spid3r,
        "web_ok": has_spid3r,
        "ios_ok": ios_missing == 0,
        "ios_missing": ios_missing,
        "android_ok": and_missing == 0,
        "android_missing": and_missing,
        "total_ok": total_ok,
        "total_issues": total_issues,
    };
}

/// Filter non-ok probes into ordered actionable recommendations.
public fn build_recommendations(checks: list) -> list {
    let recs = [];
    for c in checks {
        if type_of(c) == "map" and c.has("status") and string(c["status"]) != "ok" {
            recs.push(c);
        }
    }
    return recs;
}

fn find_kv(output: string, key: string) -> string {
    let prefix = key + "=";
    for row in string(output).split("\n") {
        let t = string(row).replace("\r", "").trim();
        if t.starts_with(prefix) {
            return t.slice(prefix.len(), t.len()).trim();
        }
    }
    return "";
}

fn detect_xcode_xip() -> string {
    let root_ld = list_dir(".");
    if root_ld.is_ok() {
        for item in root_ld.unwrap() {
            let n = string(item);
            if n.starts_with("Xcode") and n.ends_with(".xip") {
                return jobs.join_dir(jobs.fw_root_abs(), n);
            }
        }
    }
    let dl = env("USERPROFILE");
    if string(dl) != "none" {
        let ddir = jobs.join_dir(string(dl.unwrap()), "Downloads");
        let d_ld = list_dir(ddir);
        if d_ld.is_ok() {
            for item in d_ld.unwrap() {
                let n = string(item);
                if n.starts_with("Xcode") and n.ends_with(".xip") {
                    return jobs.join_dir(ddir, n);
                }
            }
        }
    }
    return "";
}

public fn scan_environment() -> list {
    let checks = [];
    let win = jobs.is_windows();
    let where_out = "";
    if win {
        let wr0 = jobs.run_exec(
            "cmd",
            ["/c",
            "where winget java gradle adb usbipd 2>nul"],
            null
        );
        where_out = string(wr0["stdout"]).lower();
    }

    // 1. Spid3r
    let sp_r = jobs.run_exec("spid3r", ["version"], null);
    let sp_ver = "";
    if int(sp_r["code"]) == 0 {
        for row in string(sp_r["stdout"]).split("\n") {
            let t = string(row).trim();
            if t.starts_with("Version") {
                sp_ver = t;
                break;
            }
        }
        if sp_ver == "" {
            sp_ver = jobs.first_line(string(sp_r["stdout"]));
        }
    }
    if sp_ver != "" {
        checks.push(
            make_check(
                "spid3r",
                "Spid3r CLI & Runtime",
                "Core",
                "ok",
                sp_ver,
                "All targets",
                "Core runtime ready.",
                "none",
                "",
                "",
                ""
            )
        );
    } else {
        checks.push(
            make_check(
                "spid3r",
                "Spid3r CLI & Runtime",
                "Core",
                "missing",
                "Not on PATH",
                "All targets",
                "Install Spid3r v1.1.1+ and add it to PATH.",
                "open_url",
                "Download Spid3r",
                "https://github.com/spid3r-lang/spid3r",
                "spid3r version"
            )
        );
    }

    // 2. Winget (Windows helper)
    if win {
        let wg_ok = false;
        let wg_ver = "";
        if where_out.contains("winget") {
            let wg = jobs.run_exec("winget", ["--version"], null);
            if int(wg["code"]) == 0 {
                wg_ok = true;
                wg_ver = jobs.first_line(string(wg["stdout"]));
            }
        }
        if wg_ok {
            checks.push(
                make_check(
                    "winget",
                    "Windows winget",
                    "Core",
                    "ok",
                    wg_ver,
                    "1-click Windows installs",
                    "Package manager ready.",
                    "none",
                    "",
                    "",
                    ""
                )
            );
        } else {
            checks.push(
                make_check(
                    "winget",
                    "Windows winget",
                    "Core",
                    "missing",
                    "Not installed",
                    "1-click Windows installs",
                    "Install App Installer from Microsoft Store to enable 1-click tool downloads.",
                    "open_url",
                    "Get App Installer",
                    "https://apps.microsoft.com/detail/9NBLGGH4NNS1",
                    "winget --version"
                )
            );
        }
    }

    // 3. iOS Toolchain (WSL2 on Windows or native POSIX)
    let wsl_ok = true;
    if win {
        let wr = jobs.run_exec("wsl", ["-e", "true"], null);
        wsl_ok = int(wr["code"]) == 0;
        if wsl_ok {
            checks.push(
                make_check(
                    "wsl2",
                    "WSL2 Ubuntu",
                    "iOS",
                    "ok",
                    "Available",
                    "iOS native .ipa",
                    "WSL2 bridge active.",
                    "none",
                    "",
                    "",
                    ""
                )
            );
        } else {
            checks.push(
                make_check(
                    "wsl2",
                    "WSL2 Ubuntu",
                    "iOS",
                    "missing",
                    "Not installed",
                    "iOS native .ipa",
                    "Install WSL2 Ubuntu so xtool & Swift can compile iOS apps on Windows.",
                    "terminal",
                    "Install WSL2",
                    "wsl --install -d Ubuntu",
                    "wsl --install -d Ubuntu"
                )
            );
        }
    }

    let xip_found = detect_xcode_xip();
    if xip_found != "" {
        state.set("ios_xip_path", xip_found);
    }

    let xtool_app = jobs.join_dir(
        jobs.fw_root_abs(),
        ".studio-cache/xtool/1.24.0/xtool.AppImage"
    );
    let has_cached_xtool = file_exists(xtool_app);
    let wsl_probe = "";
    if wsl_ok {
        let pscript = "echo \"SWIFT=$(swift --version 2>/dev/null | head -n 1 || true)\"; "
        + "echo \"SDKS=$(swift sdk list 2>/dev/null | tr '\n' ' ' || true)\"; "
        + "echo \"USBMUXD=$(command -v usbmuxd || true)\"; "
        + "echo \"MUXSOCK=$(test -S /var/run/usbmuxd && echo running || echo stopped)\"; "
        + "echo \"IDEVINST=$(command -v ideviceinstaller || true)\"; "
        + "echo \"IDEVICE=$(if [ -S /var/run/usbmuxd ]; then timeout 2 idevice_id -l 2>/dev/null | head -n 1 || true; fi)\"; "
        + "echo \"AUTH=$(find $HOME/.config/xtool $HOME/.local/share/xtool -maxdepth 3 -type f 2>/dev/null | head -n 1 || true)\"; "
        + "echo \"XTOOLBIN=$(command -v xtool || true)\"";
        let wp = jobs.run_wsl_bash(pscript);
        wsl_probe = string(wp["stdout"]);
    }

    let xtool_bin = find_kv(wsl_probe, "XTOOLBIN");
    if has_cached_xtool or xtool_bin != "" {
        let xdet = if has_cached_xtool {
            "xtool 1.24.0 (.studio-cache/xtool)"
        } else {
            xtool_bin
        };
        checks.push(
            make_check(
                "xtool",
                "xtool 1.24.0",
                "iOS",
                "ok",
                xdet,
                "iOS builds & signing",
                "xtool ready.",
                "none",
                "",
                "",
                ""
            )
        );
    } else {
        checks.push(
            make_check(
                "xtool",
                "xtool 1.24.0",
                "iOS",
                "missing",
                "Not cached",
                "iOS builds & signing",
                "Download xtool 1.24.0 AppImage into .studio-cache/xtool/.",
                "install",
                "Install xtool 1.24.0",
                "install_xtool",
                "spid3r run studio.matrix ios install-tools"
            )
        );
    }

    let sw_wsl = find_kv(wsl_probe, "SWIFT");
    if sw_wsl != "" {
        checks.push(
            make_check(
                "swift_wsl",
                "Swift Compiler (WSL)",
                "iOS",
                "ok",
                sw_wsl,
                "iOS SwiftPM compilation",
                "Swift toolchain ready.",
                "none",
                "",
                "",
                ""
            )
        );
    } else {
        checks.push(
            make_check(
                "swift_wsl",
                "Swift Compiler (WSL)",
                "iOS",
                "missing",
                "Not installed",
                "iOS SwiftPM compilation",
                "Install Swift via swiftly inside WSL2 (needed to compile StudioDemo/SwiftPM).",
                "install",
                "Install Swift (WSL)",
                "install_swift_wsl",
                "curl swiftly && swiftly init"
            )
        );
    }

    let sdks = find_kv(wsl_probe, "SDKS");
    if sdks != "" and not sdks.contains("No Swift SDKs") {
        checks.push(
            make_check(
                "darwin_sdk",
                "Darwin iOS Swift SDK",
                "iOS",
                "ok",
                sdks,
                "iOS arm64 compilation",
                "iOS SDK registered in SwiftPM.",
                "none",
                "",
                "",
                ""
            )
        );
    } elif xip_found != "" {
        checks.push(
            make_check(
                "darwin_sdk",
                "Darwin iOS Swift SDK",
                "iOS",
                "action",
                "Found " + jobs.base_name(xip_found),
                "iOS arm64 compilation",
                "Xcode.xip detected on disk — click Install Darwin SDK to extract it.",
                "sdk_xip",
                "Install Darwin SDK",
                "install_darwin_sdk",
                "spid3r run studio.matrix ios sdk-install " + xip_found
            )
        );
    } else {
        checks.push(
            make_check(
                "darwin_sdk",
                "Darwin iOS Swift SDK",
                "iOS",
                "missing",
                "Not installed",
                "iOS arm64 compilation",
                "Download Xcode 27.x .xip from Apple Developer, then install it in Platforms -> iOS.",
                "open_url",
                "Download Xcode.xip",
                "https://developer.apple.com/download/all/?q=Xcode",
                "spid3r run studio.matrix ios sdk-install <Xcode.xip>"
            )
        );
    }

    let um = find_kv(wsl_probe, "USBMUXD");
    let msock = find_kv(wsl_probe, "MUXSOCK");
    let idi = find_kv(wsl_probe, "IDEVINST");
    if um != "" and idi != "" {
        checks.push(
            make_check(
                "usbmuxd",
                "usbmuxd Daemon",
                "iOS",
                "ok",
                um + " (" + msock + ")",
                "iPhone USB communication",
                "usbmuxd installed.",
                "none",
                "",
                "",
                ""
            )
        );
        checks.push(
            make_check(
                "ideviceinstaller",
                "libimobiledevice + ideviceinstaller",
                "iOS",
                "ok",
                idi,
                "iPhone .ipa USB install",
                "USB installer libraries ready.",
                "none",
                "",
                "",
                ""
            )
        );
    } else {
        if um == "" {
            checks.push(
                make_check(
                    "usbmuxd",
                    "usbmuxd Daemon",
                    "iOS",
                    "missing",
                    "Not installed in WSL",
                    "iPhone USB communication",
                    "Install usbmuxd + libimobiledevice-utils + ideviceinstaller in WSL2.",
                    "install",
                    "Install WSL USB Tools",
                    "install_wsl_ios_pkgs",
                    "sudo apt install -y usbmuxd libimobiledevice-utils ideviceinstaller"
                )
            );
        } else {
            checks.push(
                make_check(
                    "usbmuxd",
                    "usbmuxd Daemon",
                    "iOS",
                    "ok",
                    um + " (" + msock + ")",
                    "iPhone USB communication",
                    "usbmuxd installed.",
                    "none",
                    "",
                    "",
                    ""
                )
            );
        }
        if idi == "" {
            checks.push(
                make_check(
                    "ideviceinstaller",
                    "libimobiledevice + ideviceinstaller",
                    "iOS",
                    "missing",
                    "Not installed in WSL",
                    "iPhone .ipa USB install",
                    "Install ideviceinstaller in WSL2.",
                    "install",
                    "Install WSL USB Tools",
                    "install_wsl_ios_pkgs",
                    "sudo apt install -y ideviceinstaller libimobiledevice-utils"
                )
            );
        } else {
            checks.push(
                make_check(
                    "ideviceinstaller",
                    "libimobiledevice + ideviceinstaller",
                    "iOS",
                    "ok",
                    idi,
                    "iPhone .ipa USB install",
                    "Installed.",
                    "none",
                    "",
                    "",
                    ""
                )
            );
        }
    }

    let apple_busid = "";
    let apple_usb_state = "";
    if win {
        let uip_exe = "C:/Program Files/usbipd-win/usbipd.exe";
        let cmd_u = "";
        if file_exists(uip_exe) {
            cmd_u = uip_exe;
        } elif where_out.contains("usbipd") {
            cmd_u = "usbipd";
        }
        if cmd_u != "" {
            let ul = jobs.run_exec(cmd_u, ["list"], null);
            let uv = "usbipd-win";
            let in_connected = true;
            for row in string(ul["stdout"]).split("\n") {
                let r = string(row).trim();
                if r.starts_with("Connected:") {
                    in_connected = true;
                    continue;
                }
                if r.starts_with("Persisted:") {
                    in_connected = false;
                    continue;
                }
                if in_connected and (
                    r.contains("05ac:") or r.contains("Apple Mobile Device")
                ) {
                    let cols = r.split(" ");
                    if cols.len() > 0 {
                        apple_busid = string(cols[0]).trim();
                    }
                    if r.contains("Attached") {
                        apple_usb_state = "Attached";
                    } elif r.contains("Shared") {
                        apple_usb_state = "Shared";
                    } else {
                        apple_usb_state = "Not shared";
                    }
                }
            }
            checks.push(
                make_check(
                    "usbipd",
                    "usbipd-win USB Bridge",
                    "iOS",
                    "ok",
                    uv,
                    "Pass iPhone USB to WSL2",
                    "usbipd-win installed.",
                    "none",
                    "",
                    "",
                    ""
                )
            );
        } else {
            checks.push(
                make_check(
                    "usbipd",
                    "usbipd-win USB Bridge",
                    "iOS",
                    "missing",
                    "Not installed",
                    "Pass iPhone USB to WSL2",
                    "Install usbipd-win via winget so WSL2 can access your USB iPhone.",
                    "install",
                    "Install usbipd-win",
                    "install_usbipd",
                    "winget install --exact dorssel.usbipd-win"
                )
            );
        }
    }

    let auth_marker = find_kv(wsl_probe, "AUTH");
    if auth_marker != "" {
        checks.push(
            make_check(
                "apple_auth",
                "Apple ID Signing Session",
                "iOS",
                "ok",
                "Cached in WSL (" + auth_marker + ")",
                "Codesigning .ipa",
                "Apple signing session present.",
                "none",
                "",
                "",
                ""
            )
        );
    } else {
        checks.push(
            make_check(
                "apple_auth",
                "Apple ID Signing Session",
                "iOS",
                "action",
                "Not signed in yet",
                "Codesigning .ipa",
                "Sign in once with your Apple ID + 2FA to generate signing certificates.",
                "terminal",
                "Sign in (Apple ID)",
                "open_apple_auth",
                "xtool auth"
            )
        );
    }

    let ios_udid = find_kv(wsl_probe, "IDEVICE");
    state.set("ios_udid", ios_udid);
    state.set("ios_busid", apple_busid);
    state.set("ios_usb_state", apple_usb_state);
    state.set("usbmuxd_running", msock == "running");

    if ios_udid != "" {
        checks.push(
            make_check(
                "ios_device",
                "Connected iPhone (USB)",
                "Devices",
                "ok",
                "UDID: " + ios_udid,
                "Direct .ipa install",
                "iPhone ready for deployment.",
                "none",
                "",
                "",
                ""
            )
        );
    } elif apple_busid != "" {
        if apple_usb_state == "Shared" {
            checks.push(
                make_check(
                    "ios_device",
                    "iPhone USB (" + apple_busid + ")",
                    "Devices",
                    "action",
                    "Shared — ready to attach to WSL2",
                    "Direct .ipa install",
                    "Click Attach USB to connect BUSID " + apple_busid + " to WSL2 and start usbmuxd.",
                    "install",
                    "Attach iPhone USB",
                    "attach_usb_ios",
                    "usbipd attach --wsl --busid " + apple_busid
                )
            );
        } else {
            checks.push(
                make_check(
                    "ios_device",
                    "iPhone USB (" + apple_busid + ")",
                    "Devices",
                    "action",
                    "Windows connected (" + apple_usb_state + ")",
                    "Direct .ipa install",
                    "Bind BUSID " + apple_busid + " once in an Admin PowerShell, then Attach to WSL2.",
                    "terminal",
                    "Bind BUSID (Admin)",
                    "open_admin_usbipd",
                    "usbipd bind --busid " + apple_busid + " --force && usbipd attach --wsl --busid " + apple_busid
                )
            );
        }
    } else {
        checks.push(
            make_check(
                "ios_device",
                "iPhone USB Device",
                "Devices",
                "action",
                "Not plugged in",
                "USB .ipa deployment (use Web LAN for Wi-Fi)",
                "Plug iPhone in with a data USB cable & tap Trust, or use Platforms -> Web Server over Wi-Fi.",
                "none",
                "",
                "",
                "usbipd list"
            )
        );
    }

    // 4. Android Toolchain
    let has_java = not win or where_out.contains("java");
    let jr = {
        "code": 1, "stdout": "", "stderr": ""
    };
    if has_java {
        jr = jobs.run_exec("java", ["-version"], null);
    }
    if int(jr["code"]) == 0 {
        let jv = jobs.first_line(string(jr["stderr"]) + "\n" + string(jr["stdout"]));
        checks.push(
            make_check(
                "java",
                "Java JDK",
                "Android",
                "ok",
                jv,
                "Android Gradle APK",
                "Java runtime ready.",
                "none",
                "",
                "",
                ""
            )
        );
    } else {
        checks.push(
            make_check(
                "java",
                "Java JDK (17+)",
                "Android",
                "missing",
                "Not installed",
                "Android Gradle APK",
                "Install Microsoft OpenJDK 17 so Gradle can compile Android APKs.",
                "install",
                "Install OpenJDK 17",
                "install_jdk",
                "winget install --exact Microsoft.OpenJDK.17"
            )
        );
    }

    let has_gradle = not win or where_out.contains("gradle");
    let gr = {
        "code": 1, "stdout": "", "stderr": ""
    };
    if has_gradle {
        gr = jobs.run_exec("gradle", ["--version"], null);
    }
    if int(gr["code"]) == 0 {
        checks.push(
            make_check(
                "gradle",
                "Gradle Build Tool",
                "Android",
                "ok",
                jobs.first_line(string(gr["stdout"])),
                "Android Gradle APK",
                "Gradle ready.",
                "none",
                "",
                "",
                ""
            )
        );
    } else {
        checks.push(
            make_check(
                "gradle",
                "Gradle Build Tool",
                "Android",
                "missing",
                "Not installed",
                "Android Gradle APK",
                "Install Gradle (or use Android Studio) to run assembleDebug from CLI/GUI.",
                "install",
                "Install Gradle",
                "install_gradle",
                "winget install --exact Gradle.Gradle"
            )
        );
    }

    let has_adb = not win or where_out.contains("adb");
    let adbr = {
        "code": 1, "stdout": "", "stderr": ""
    };
    if has_adb {
        adbr = jobs.run_exec("adb", ["version"], null);
    }
    let adb_devs = "";
    if int(adbr["code"]) == 0 {
        checks.push(
            make_check(
                "adb",
                "Android Debug Bridge (adb)",
                "Android",
                "ok",
                jobs.first_line(string(adbr["stdout"])),
                "Android USB install",
                "adb ready.",
                "none",
                "",
                "",
                ""
            )
        );
        let dl = jobs.run_exec("adb", ["devices"], null);
        adb_devs = string(dl["stdout"]).trim();
    } else {
        checks.push(
            make_check(
                "adb",
                "Android Debug Bridge (adb)",
                "Android",
                "missing",
                "Not installed",
                "Android USB install",
                "Install Android Platform-Tools via winget to deploy APKs over USB.",
                "install",
                "Install ADB Tools",
                "install_adb",
                "winget install --exact Google.PlatformTools"
            )
        );
    }
    state.set("adb_devices_text", adb_devs);

    let ah = env("ANDROID_HOME");
    let asdk = env("ANDROID_SDK_ROOT");
    let sdk_path = "";
    if string(ah) != "none" and string(ah.unwrap()).trim() != "" {
        sdk_path = string(ah.unwrap()).trim();
    } elif string(asdk) != "none" and string(asdk.unwrap()).trim() != "" {
        sdk_path = string(asdk.unwrap()).trim();
    }
    if sdk_path != "" {
        checks.push(
            make_check(
                "android_home",
                "Android SDK (ANDROID_HOME)",
                "Android",
                "ok",
                sdk_path,
                "Android compilation",
                "Android SDK configured.",
                "none",
                "",
                "",
                ""
            )
        );
    } else {
        checks.push(
            make_check(
                "android_home",
                "Android SDK (ANDROID_HOME)",
                "Android",
                "missing",
                "Not set",
                "Android compilation",
                "Download Android Studio (includes Android SDK) and set ANDROID_HOME.",
                "open_url",
                "Download Android Studio",
                "https://developer.android.com/studio",
                "set ANDROID_HOME=%LOCALAPPDATA%\\Android\\Sdk"
            )
        );
    }

    state.set("env_checks", checks);
    state.set("readiness", evaluate_readiness(checks));
    return checks;
}

public fn trigger_rescan(quiet: bool = false) {
    jobs.run_async("Scanning Environment & Devices", () => {
        state.set("lan_ip", jobs.detect_lan_ip());
        scan_environment();
        return true;
    }, not quiet);
}

public fn run_tool_action(action_id: string, extra_arg: string = "") {
    if action_id.starts_with("https://") or action_id.starts_with("http://") {
        if br.platform() == "native" {
            jobs.open_external_url(action_id);
        } else {
            br.open_url(action_id);
        }
        state.set("toast_msg", "Opened download page in browser");
        return;
    }
    if action_id == "open_apple_auth" {
        let cmd = "wsl -e bash -lc 'APPIMAGE_EXTRACT_AND_RUN=1 " + jobs.win_to_wsl(jobs.fw_root_abs()) + "/.studio-cache/xtool/1.24.0/xtool.AppImage auth'";
        jobs.open_terminal("AppStudio Apple ID Auth", cmd);
        return;
    }
    if action_id == "open_admin_usbipd" {
        let bid = string(state.get_or("ios_busid", "2-1"));
        if bid == "" {
            bid = "2-1";
        }
        let ucmd = "& \"$env:ProgramFiles\\usbipd-win\\usbipd.exe\" bind --busid " + bid + " --force; & \"$env:ProgramFiles\\usbipd-win\\usbipd.exe\" attach --wsl --busid " + bid;
        br.copy_text(ucmd);
        jobs.open_terminal(
            "AppStudio USB Bind",
            "Write-Host 'Run in an Administrator PowerShell (copied to clipboard):'; Write-Host '" + ucmd.replace("'", "''") + "'"
        );
        state.set("toast_msg", "Copied Admin USB bind command");
        return;
    }

    jobs.run_async("Toolchain: " + action_id, () => {
        let ok = false;
        if action_id == "install_xtool" {
            let m = jobs.run_studio_cli(["ios", "install-tools"]);
            jobs.append_exec_logs(m);
            ok = int(m["code"]) == 0;
        } elif action_id == "install_darwin_sdk" {
            let xp = if extra_arg.trim() != "" {
                extra_arg.trim()
            } else {
                string(state.get_or("ios_xip_path", ""))
            };
            if xp == "" {
                jobs.append_log("error: specify a valid path to Xcode.xip first.");
                return false;
            }
            let m = jobs.run_studio_cli(["ios", "sdk-install", xp]);
            jobs.append_exec_logs(m);
            ok = int(m["code"]) == 0;
        } elif action_id == "install_wsl_ios_pkgs" {
            let m = jobs.run_exec(
                "wsl",
                ["-u",
                "root",
                "bash",
                "-lc",
                "export DEBIAN_FRONTEND=noninteractive && apt-get update && apt-get install -y usbmuxd libimobiledevice-utils ideviceinstaller"],
                null
            );
            jobs.append_exec_logs(m);
            ok = int(m["code"]) == 0;
        } elif action_id == "install_swift_wsl" {
            let s1 = jobs.run_exec(
                "wsl",
                ["-u",
                "root",
                "bash",
                "-lc",
                "export DEBIAN_FRONTEND=noninteractive && apt-get update && apt-get install -y binutils-gold curl git gnupg2 libcurl4-openssl-dev libedit2 libgcc-15-dev libncurses-dev libpython3-dev libsqlite3-0 libstdc++-15-dev libxml2-dev libz3-dev pkg-config tzdata unzip zip zlib1g-dev"],
                null
            );
            jobs.append_exec_logs(s1);
            let s2 = jobs.run_wsl_bash(
                "mkdir -p /tmp/swiftly-install && cd /tmp/swiftly-install && curl -fsSL https://download.swift.org/swiftly/linux/swiftly-x86_64.tar.gz -o swiftly.tar.gz && tar zxf swiftly.tar.gz && (./swiftly init --quiet-shell-followup --assume-yes || ./swiftly init --quiet-shell-followup --assume-yes --platform ubuntu2404) && rm -rf /tmp/swiftly-install && swift --version"
            );
            jobs.append_exec_logs(s2);
            ok = int(s2["code"]) == 0;
        } elif action_id == "install_usbipd" {
            let m = jobs.run_exec(
                "winget",
                ["install",
                "--exact",
                "--id",
                "dorssel.usbipd-win",
                "--accept-package-agreements",
                "--accept-source-agreements"],
                null
            );
            jobs.append_exec_logs(m);
            ok = int(m["code"]) == 0;
        } elif action_id == "install_jdk" {
            let m = jobs.run_exec(
                "winget",
                ["install",
                "--exact",
                "--id",
                "Microsoft.OpenJDK.17",
                "--accept-package-agreements",
                "--accept-source-agreements"],
                null
            );
            jobs.append_exec_logs(m);
            ok = int(m["code"]) == 0;
        } elif action_id == "install_gradle" {
            let m = jobs.run_exec(
                "winget",
                ["install",
                "--exact",
                "--id",
                "Gradle.Gradle",
                "--accept-package-agreements",
                "--accept-source-agreements"],
                null
            );
            jobs.append_exec_logs(m);
            ok = int(m["code"]) == 0;
        } elif action_id == "install_adb" {
            let m = jobs.run_exec(
                "winget",
                ["install",
                "--exact",
                "--id",
                "Google.PlatformTools",
                "--accept-package-agreements",
                "--accept-source-agreements"],
                null
            );
            jobs.append_exec_logs(m);
            ok = int(m["code"]) == 0;
        } elif action_id == "attach_usb_ios" {
            let bid = string(state.get_or("ios_busid", ""));
            if bid == "" {
                jobs.append_log("error: no Apple USB device detected. Plug iPhone in via USB.");
                return false;
            }
            jobs.run_exec(
                "wsl",
                ["-u",
                "root",
                "bash",
                "-lc",
                "test -S /var/run/usbmuxd || (usbmuxd && sleep 1)"],
                null
            );
            let uip_exe = "C:/Program Files/usbipd-win/usbipd.exe";
            let cmd_u = if file_exists(uip_exe) {
                uip_exe
            } else {
                "usbipd"
            };
            let m = jobs.run_exec(cmd_u, ["attach", "--wsl", "--busid", bid], null);
            jobs.append_exec_logs(m);
            ok = int(m["code"]) == 0;
        }
        scan_environment();
        return ok;
    });
}
