// tests/gui_center.matrix
// Verification suite for AppStudio Control Center (gui/) desktop shell, views, and App.request_render().

import "studio/App" as appkit;
import "studio/Render" as render;
import "studio/State" as state;
import "studio/Theme" as theme;
import "gui/Jobs" as jobs;
import "gui/Toolchain" as tc;
import "gui/app" as cc;
import "gui/pages/Workspace" as p_ws;
import "gui/pages/Platforms" as p_plat;
import "gui/pages/Tests" as p_tests;
import "gui/pages/Doctor" as p_doc;

let pass_n = 0;
let fail_n = 0;

fn check(cond: bool, label: string) {
    if cond {
        pass_n += 1;
    } else {
        fail_n += 1;
        println("FAIL: " + label);
    }
}

fn main() -> int {
    // 1. Non-blocking UI refresh hook & dedicated host.html check
    appkit.request_render();
    check(file_exists("gui/host.html"), "gui/host.html desktop stylesheet exists");

    // 2. Project discovery finds showcase demo
    let projs = jobs.discover_projects();
    let has_demo = false;
    for p in projs {
        if string(p) == "examples/demo" {
            has_demo = true;
        }
    }
    check(has_demo, "discover_projects locates examples/demo");

    let info = jobs.project_info("examples/demo");
    check(string(info["name"]) == "Studio Demo", "project_info reads Studio Demo name");
    check(string(info["bundle_id"]) == "sh.appstudio.demo", "project_info reads bundleID");

    // 3. Log buffer capping & test summary parser
    let capped = jobs.cap_logs(["a", "b"], "c\nd\ne", 3);
    check(
        capped.len() == 3 and string(capped[2]) == "e",
        "cap_logs retains newest lines within cap"
    );

    let parsed = jobs.parse_test_summary(
        "[1/3] checking formatting across 48 files...\n  checked 48 files cleanly\npassed: 183  failed: 0\npassed: 36  failed: 0\nall 5 test suites passed."
    );
    check(
        parsed["fmt_ok"] == true and parsed["check_ok"] == true,
        "parse_test_summary detects fmt & check"
    );
    check(
        int(parsed["suites"]) == 2 and int(parsed["passed"]) == 219 and parsed["all_ok"] == true,
        "parse_test_summary counts suites & assertions"
    );

    // 4. Toolchain readiness & recommendation engine
    let partial_checks = [
    {
        "id": "spid3r", "name": "Spid3r CLI", "category": "Core", "status": "ok", "detail": "1.1.1", "required_for": "All", "recommendation": "", "action_kind": "none", "action_label": "", "action_arg": "", "cmd_hint": ""
    }
    ,
    {
        "id": "wsl2", "name": "WSL2", "category": "iOS", "status": "ok", "detail": "Available", "required_for": "iOS", "recommendation": "", "action_kind": "none", "action_label": "", "action_arg": "", "cmd_hint": ""
    }
    ,
    {
        "id": "xtool", "name": "xtool 1.24.0", "category": "iOS", "status": "missing", "detail": "Not cached", "required_for": "iOS", "recommendation": "Install xtool", "action_kind": "install", "action_label": "Install", "action_arg": "install_xtool", "cmd_hint": ""
    }
    ,
    {
        "id": "swift_wsl", "name": "Swift", "category": "iOS", "status": "ok", "detail": "6.4.3", "required_for": "iOS", "recommendation": "", "action_kind": "none", "action_label": "", "action_arg": "", "cmd_hint": ""
    }
    ,
    {
        "id": "darwin_sdk", "name": "Darwin SDK", "category": "iOS", "status": "ok", "detail": "darwin", "required_for": "iOS", "recommendation": "", "action_kind": "none", "action_label": "", "action_arg": "", "cmd_hint": ""
    }
    ,
    {
        "id": "usbmuxd", "name": "usbmuxd", "category": "iOS", "status": "ok", "detail": "/usr/sbin/usbmuxd", "required_for": "iOS", "recommendation": "", "action_kind": "none", "action_label": "", "action_arg": "", "cmd_hint": ""
    }
    ,
    {
        "id": "ideviceinstaller", "name": "ideviceinstaller", "category": "iOS", "status": "ok", "detail": "/usr/bin/ideviceinstaller", "required_for": "iOS", "recommendation": "", "action_kind": "none", "action_label": "", "action_arg": "", "cmd_hint": ""
    }
    ,
    {
        "id": "usbipd", "name": "usbipd", "category": "iOS", "status": "ok", "detail": "5.3.0", "required_for": "iOS", "recommendation": "", "action_kind": "none", "action_label": "", "action_arg": "", "cmd_hint": ""
    }
    ,
    {
        "id": "apple_auth", "name": "Apple Auth", "category": "iOS", "status": "ok", "detail": "ok", "required_for": "iOS", "recommendation": "", "action_kind": "none", "action_label": "", "action_arg": "", "cmd_hint": ""
    }
    ,
    {
        "id": "java", "name": "Java JDK", "category": "Android", "status": "missing", "detail": "Not installed", "required_for": "Android", "recommendation": "Install OpenJDK", "action_kind": "install", "action_label": "Install", "action_arg": "install_jdk", "cmd_hint": ""
    }
    ,
    {
        "id": "gradle", "name": "Gradle", "category": "Android", "status": "missing", "detail": "Not installed", "required_for": "Android", "recommendation": "Install Gradle", "action_kind": "install", "action_label": "Install", "action_arg": "install_gradle", "cmd_hint": ""
    }
    ,
    {
        "id": "adb", "name": "ADB", "category": "Android", "status": "ok", "detail": "1.0.41", "required_for": "Android", "recommendation": "", "action_kind": "none", "action_label": "", "action_arg": "", "cmd_hint": ""
    }
    ,
    {
        "id": "android_home", "name": "ANDROID_HOME", "category": "Android", "status": "missing", "detail": "Not set", "required_for": "Android", "recommendation": "Download Android Studio", "action_kind": "open_url", "action_label": "Download", "action_arg": "https://developer.android.com/studio", "cmd_hint": ""
    }
    ,
    ];
    let rd = tc.evaluate_readiness(partial_checks);
    check(
        rd["desktop_ok"] == true and rd["web_ok"] == true,
        "Desktop & Web ready when spid3r ok"
    );
    check(
        int(rd["ios_missing"]) == 1 and rd["ios_ok"] == false,
        "iOS detects 1 missing dependency"
    );
    check(
        int(rd["android_missing"]) == 3 and rd["android_ok"] == false,
        "Android detects 3 missing dependencies"
    );
    let recs = tc.build_recommendations(partial_checks);
    check(recs.len() == 4, "build_recommendations filters exact non-ok items");

    // 5. Render redesigned Desktop Shell & all 4 pages cleanly (dark + light, no mobile tabbar)
    state.set("active_project", "examples/demo");
    state.set("proj_info", info);
    state.set("env_checks", partial_checks);
    state.set("readiness", rd);

    theme.mode("dark");
    let ws_dark = render.document(p_ws.Workspace(), [], 0);
    check(
        ws_dark.contains("cc-shell cc-dark") and ws_dark.contains("cc-sidebar") and ws_dark.contains("cc-drawer"),
        "Workspace renders dark desktop shell"
    );
    check(
        ws_dark.contains("<svg") and not ws_dark.contains("class=\"tabbar\""),
        "Workspace includes SVG icons and omits mobile tabbar"
    );

    theme.mode("light");
    let pl_light = render.document(p_plat.Platforms(), [], 0);
    check(
        pl_light.contains("cc-shell cc-light") and pl_light.contains("cc-plat-grid") and pl_light.contains("Desktop Native"),
        "Platforms renders light 2x2 desktop grid"
    );

    let ts_html = render.document(p_tests.Tests(), [], 0);
    check(
        ts_html.contains("Full Verification Pipeline"),
        "Tests page renders verification KPIs and suites"
    );

    let dc_html = render.document(p_doc.Doctor(), [], 0);
    check(
        dc_html.contains("Environment Readiness") and dc_html.contains("cc-doc-row"),
        "Doctor renders clean row audit & actions"
    );

    let rc = cc.studio_app().wasm_run("");
    check(rc == 0, "Control Center studio_app().wasm_run('') exits 0");
    check(
        string(state.get_or("active_project", "")) != "",
        "boot_control_center sets active_project"
    );

    let theme_ev = "{\"event\":{\"sid\":\"flip_theme\",\"kind\":\"tap\",\"value\":null,\"arg\":null},\"theme\":{\"mode\":\"dark\"}}";
    let rc_flip = cc.studio_app().wasm_run(theme_ev);
    check(
        rc_flip == 0 and string(theme.token("mode")) == "light",
        "Control Center flip_theme click toggles dark to light"
    );

    println("gui_center passed: " + string(pass_n) + "  failed: " + string(fail_n));
    return if fail_n == 0 {
        0
    } else {
        1
    };
}
