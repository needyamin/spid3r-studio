// core/Diagnostics.matrix
// Structured compiler and runtime error/warning detector with Spid3r v1.5.0 (.matrix/.mt) fix suggestions.

fn str_find(s: string, needle: string, from: int = 0) -> int {
    let n = s.len();
    let nl = needle.len();
    if nl == 0 or nl > n {
        return -1;
    }
    let i = from;
    while i <= n - nl {
        if s.slice(i, i + nl) == needle {
            return i;
        }
        i += 1;
    }
    return -1;
}

public fn suggestion_for_message(msg: string) -> string {
    let low = string(msg).lower();
    if low.contains("invalid module path") or low.contains("..") {
        return "Parent-relative '../' imports are disallowed. Use project-root-relative paths or configure SPID3R_PATH.";
    }
    if low.contains("cannot find module") or low.contains("module not found") {
        return "Module import could not be resolved. Ensure SPID3R_PATH includes the project/framework root or run 'studio upgrade'.";
    }
    if low.contains("would reformat") {
        return "File formatting or UTF-8 BOM mismatch detected. Run 'spid3r fmt' or click 'Auto-Recover Project'.";
    }
    if low.contains("unused variable") or low.contains("unused import") or low.contains("unused parameter") or low.contains("unreachable") {
        return "Strict '--deny-warnings' check flagged an unused binding or unreachable branch. Prefix unused names with '_' or remove dead code.";
    }
    if low.contains("is private") or low.contains("cannot access private") {
        return "Class members and top-level declarations default to private in Spid3r v1.5.0. Add 'public' on exported members or methods.";
    }
    if low.contains("non-exhaustive") or low.contains("missing variant") {
        return "Exhaustive 'match' on an enum must handle every variant or include a wildcard '_' arm.";
    }
    if low.contains("division by zero") or low.contains("overflow") {
        return "Spid3r v1.5.0 enforces checked arithmetic and rejects division/modulo by zero at runtime. Guard divisors and bounds before operating.";
    }
    if low.contains("unknown name 'gui_") {
        return "gui_* natives require the 'spid3r gui' desktop runtime (or pass shims from main.matrix via app.bridge(...)).";
    }
    if low.contains("spid3r_ini") or low.contains("spid3r.ini") or low.contains("config pin") {
        return "Check SPID3R_INI or run 'spid3r config validate' to repair the configuration pin.";
    }
    if low.contains("found keyword 'elif'") or low.contains("unexpected keyword 'else'") {
        return "Legacy Spid3r BUG-06 parser mismatch (fixed in Spid3r v1.5.0): upgrade Spid3r or use statement-form 'if / elif / else'.";
    }
    if low.contains("found colon") and low.contains("expected ';'") {
        return "Legacy Spid3r BUG-07 parser mismatch (fixed in Spid3r v1.5.0): assign map literals inside a statement block.";
    }
    if low.contains("fn expects") and low.contains("got 2") {
        return "gui_on invokes 2-arg handlers as (event, payload); add an optional second parameter (ev, payload = null) => { ... }.";
    }
    if low.contains("'_' is already declared") {
        return "Legacy Spid3r BUG-09 duplicate '_' error (fixed in Spid3r v1.5.0): upgrade Spid3r or use distinct '_a'/'_b' names.";
    }
    if low.contains("null is not callable") {
        return "Legacy Spid3r BUG-10 map-value if/else error (fixed in Spid3r v1.5.0): bind the expression to a local variable first.";
    }
    return "Inspect the referenced file and line number in Code & Debugger, then run 'spid3r check --deny-warnings' to verify your fix.";
}

/// Lint a .matrix/.mt source string for common hygiene issues (returns structured warning records).
public fn lint_unsupported_enums(_src: string, _file_label: string = "") -> list {
    // Spid3r v1.5.0 natively supports enum declarations and exhaustive match across all engines.
    return [];
}

fn parse_span(line: string) -> map {
    let arrow = str_find(line, "-->", 0);
    if arrow < 0 {
        return {
            "file": "", "line": 0, "col": 0
        };
    }
    let tail = line.slice(arrow + 3, line.len()).trim();
    let parts = tail.split(":");
    if parts.len() < 2 {
        return {
            "file": tail, "line": 0, "col": 0
        };
    }
    let col_n = 0;
    let line_n = 0;
    let file_s = "";
    if parts.len() >= 3 {
        let c_str = string(parts[parts.len() - 1]).trim();
        let l_str = string(parts[parts.len() - 2]).trim();
        try {
            line_n = int(l_str);
            col_n = int(c_str);
        } catch (_e) {
            let _ = _e;
        }
        let end_idx = tail.len() - (l_str.len() + c_str.len() + 2);
        if end_idx > 0 {
            file_s = tail.slice(0, end_idx);
        } else {
            file_s = string(parts[0]);
        }
    } else {
        file_s = string(parts[0]);
    }
    return {
        "file": file_s, "line": line_n, "col": col_n
    };
}

/// Parse compiler/runtime output into structured diagnostic records and deduplicate BUG-06 parser spam.
public fn analyze_output(raw_output: string, default_file: string = "") -> map {
    let items = [];
    let seen = {
    };
    let err_count = 0;
    let warn_count = 0;
    let rows = string(raw_output).split("\n");
    let i = 0;
    while i < rows.len() {
        let t = string(rows[i]).replace("\r", "").trim();
        let is_err = t.starts_with("error[") or t.starts_with("error:");
        let is_warn = t.starts_with("warning[") or t.starts_with("warning:");
        if is_err or is_warn {
            let sev = "error";
            if is_warn {
                sev = "warning";
            }
            let kind = "compiler";
            let b1 = str_find(t, "[", 0);
            let b2 = str_find(t, "]", b1 + 1);
            if b1 >= 0 and b2 > b1 {
                kind = t.slice(b1 + 1, b2);
            }
            let colon = str_find(t, ":", 0);
            let msg = t;
            if colon >= 0 and colon + 1 < t.len() {
                msg = t.slice(colon + 1, t.len()).trim();
            }
            let file_s = default_file;
            let line_n = 0;
            let col_n = 0;
            if i + 1 < rows.len() {
                let next_l = string(rows[i + 1]).replace("\r", "").trim();
                if next_l.starts_with("-->") {
                    let sp = parse_span(next_l);
                    if string(sp["file"]) != "" {
                        file_s = string(sp["file"]);
                    }
                    line_n = int(sp["line"]);
                    col_n = int(sp["col"]);
                }
            }
            let dedup_key = sev + ":" + file_s + ":" + string(line_n) + ":" + string(col_n) + ":" + msg;
            if not seen.has(dedup_key) {
                seen[dedup_key] = true;
                if is_err {
                    err_count += 1;
                } else {
                    warn_count += 1;
                }
                items.push({
                    "severity": sev,
                    "category": kind,
                    "message": msg,
                    "file": file_s,
                    "line": line_n,
                    "col": col_n,
                    "suggestion": suggestion_for_message(msg),
                });
            }
        } elif t.starts_with("would reformat ") {
            let wf = t.slice(15, t.len()).trim();
            let dkey = "fmt:" + wf;
            if not seen.has(dkey) {
                seen[dkey] = true;
                warn_count += 1;
                items.push({
                    "severity": "warning",
                    "category": "formatter",
                    "message": "File needs formatting or has a UTF-8 BOM (" + wf + ")",
                    "file": wf,
                    "line": 1,
                    "col": 1,
                    "suggestion": suggestion_for_message("would reformat"),
                });
            }
        }
        i += 1;
    }

    let status = "clean";
    if err_count > 0 {
        status = "error";
    } elif warn_count > 0 {
        status = "warning";
    }
    return {
        "status": status,
        "error_count": err_count,
        "warning_count": warn_count,
        "items": items,
    };
}
