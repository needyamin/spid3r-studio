// cli/BuildDesktop.matrix
// Self-contained desktop executable builder (AOT launcher + bytecode + embedded host).

import "Fs" as fs;
import "Manifest" as man;
import "Exec" as ex;

public fn build(
    appdir: string,
    entry: string,
    outdir: string,
    release: bool = false
) -> int {
    fs.ensure_dir(outdir);
    fs.setup_import_path();
    let name = man.app_name_of(appdir);
    let m = man.read_manifest(appdir);
    let ver = man.app_version_of(appdir);
    let host_abs = fs.abs_path(fs.trim_slash(fs.host_page(appdir)));
    let ext = if fs.is_windows() {
        ".exe" } else {
        ""
    };
    let out_bin = outdir + "/" + name + ext;
    let mode_lbl = if release {
        "release"
    } else {
        "debug"
    };
    println("building desktop app (" + mode_lbl + ") -> " + out_bin);

    let bc = outdir + "/._tmp_" + fs.sanitize_swift_ident(name) + ".matrixc";
    if not ex.run_checked("spid3r", ["compile", entry, "-o", bc], "compiling") {
        return 1;
    }

    let launcher = outdir + "/_launcher.matrix";
    let launch_call = if release {
        "run_payload_strict()"
    } else {
        "run_payload()"
    };
    if not fs.write_checked(
        launcher,
        "fn main() -> int {\n    return " + launch_call + ";\n}\n"
    ) {
        remove_file(bc);
        return 1;
    }
    let b_args = [
    "build", launcher,
    "-o", out_bin,
    "--release",
    "--bytecode", bc,
    "--embed", host_abs,
    "--bundle-runtime",
    "--product-name", name,
    "--version", ver,
    ];
    if fs.is_windows() {
        b_args.push("--subsystem");
        b_args.push("windows");
    }
    if m.has("icon") and string(m["icon"]).trim() != "" {
        let icon_p = string(m["icon"]).trim();
        if not fs.is_abs_path(icon_p) {
            icon_p = fs.join_dir(appdir, icon_p);
        }
        if file_exists(icon_p) {
            b_args.push("--icon");
            b_args.push(icon_p);
        }
    }
    let ok = ex.run_checked("spid3r", b_args, "building");
    remove_file(launcher);
    remove_file(bc);
    if not ok {
        return 1;
    }
    if not fs.copy_app_assets(appdir, outdir) {
        return 1;
    }
    if not man.emit_sbom(appdir, outdir, "desktop", release) {
        return 1;
    }
    if release {
        let pkg_dir = outdir + "/packaging";
        fs.ensure_dir(pkg_dir);
        let safe_name = fs.sanitize_swift_ident(name);
        let bid = man.app_bundle_id_of(appdir);
        let exec_name = name + ext;
        let ver4 = ver + ".0";
        if ver.split(".").len() >= 4 {
            ver4 = ver;
        }
        let art_sha = ex.sha256_file(out_bin);
        let plat_lbl = if fs.is_windows() {
            "windows"
        } elif fs.is_macos() {
            "macos"
        } else {
            "linux"
        };
        let pvars = {
            "APP_NAME": name,
            "APP_NAME_XML": fs.html_escape(name),
            "APP_NAME_JSON": name.replace("\"", "\\\""),
            "SAFE_NAME": safe_name,
            "BUNDLE_ID": bid,
            "BUNDLE_ID_XML": fs.html_escape(bid),
            "BUNDLE_ID_JSON": bid.replace("\"", "\\\""),
            "APP_VERSION": ver,
            "APP_VERSION_4": ver4,
            "APP_VERSION_XML": fs.html_escape(ver),
            "APP_VERSION_JSON": ver.replace("\"", "\\\""),
            "EXEC_NAME": exec_name,
            "EXEC_NAME_XML": fs.html_escape(exec_name),
            "EXEC_NAME_JSON": exec_name.replace("\"", "\\\""),
            "PLATFORM_JSON": plat_lbl,
            "ARTIFACT_SHA256": art_sha,
        };
        let feed = fs.render_template("targets/desktop/update-feed.json.tmpl", pvars);
        if feed != "" {
            let _uf = fs.write_checked(outdir + "/update-feed.json", feed);
        }
        if fs.is_windows() {
            let am = fs.render_template("targets/desktop/AppxManifest.xml.tmpl", pvars);
            let ps = fs.render_template("targets/desktop/package-msix.ps1.tmpl", pvars);
            if am != "" {
                let _wa = fs.write_checked(pkg_dir + "/AppxManifest.xml", am);
            }
            if ps != "" {
                let _wp = fs.write_checked(pkg_dir + "/package-msix.ps1", ps);
            }
        } elif fs.is_macos() {
            let pl = fs.render_template("targets/desktop/Info.plist.tmpl", pvars);
            let sh = fs.render_template("targets/desktop/package-dmg.sh.tmpl", pvars);
            if pl != "" {
                let _wl = fs.write_checked(pkg_dir + "/Info.plist", pl);
            }
            if sh != "" {
                let _ws = fs.write_checked(pkg_dir + "/package-dmg.sh", sh);
            }
        } else {
            let dt = fs.render_template("targets/desktop/app.desktop.tmpl", pvars);
            if dt != "" {
                let _wd = fs.write_checked(pkg_dir + "/" + safe_name + ".desktop", dt);
            }
        }

        let sign_env = env("STUDIO_DESKTOP_SIGN_CMD");
        if string(sign_env) != "none" {
            let sign_cmd = string(sign_env.unwrap()).trim();
            if sign_cmd != "" {
                let full_cmd = sign_cmd.replace("\{\{BINARY\}\}", fs.abs_path(out_bin));
                if full_cmd == sign_cmd {
                    full_cmd = sign_cmd + " " + fs.sh_quote(fs.abs_path(out_bin));
                }
                let s_ok = if fs.is_windows() {
                    ex.run_checked(
                        "powershell",
                        ["-NoProfile",
                        "-Command",
                        full_cmd],
                        "signing"
                    )
                } else {
                    ex.run_checked("bash", ["-lc", full_cmd], "signing")
                };
                if not s_ok {
                    return 1;
                }
            }
        } else {
            println(
                "  note: set STUDIO_DESKTOP_SIGN_CMD to run an automatic code-signing hook on --release."
            );
        }
    }
    println("done: " + out_bin + " (self-contained binary)");
    return 0;
}
