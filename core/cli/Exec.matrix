// cli/Exec.matrix
// Subprocess helpers, toolchain version probing, and cached wasm runtime extraction.

import "Fs" as fs;

public fn flush_child_output(m: map) {
    let out = string(m["stdout"]);
    let err = string(m["stderr"]);
    if out != "" {
        print(out);
    }
    if err != "" {
        print(err);
    }
}

public fn run_checked(cmd: string, args: list, err_prefix: string) -> bool {
    let r = exec_capture(cmd, args, null);
    if r.is_err() {
        println("error " + err_prefix + ": " + string(r.unwrap_err()));
        return false;
    }
    let m = r.unwrap();
    if int(m["code"]) != 0 {
        println(
            "error " + err_prefix + ":\n" + string(m["stdout"]) + string(m["stderr"])
        );
        return false;
    }
    return true;
}

public fn probe_version(cmd: string, args: list) -> string {
    let r = exec_capture(cmd, args, null);
    if r.is_err() {
        return "";
    }
    let m = r.unwrap();
    if int(m["code"]) != 0 {
        return "";
    }
    let s = string(m["stdout"]);
    if s.trim() == "" {
        s = string(m["stderr"]);
    }
    let line = s.split("\n");
    let i = 0;
    while i < line.len() {
        let t = string(line[i]).trim();
        if t != "" and not t.starts_with("█") and not t.starts_with("╱") and not t.starts_with("╚") {
            return t;
        }
        i += 1;
    }
    return "";
}

public fn probe_spid3r_version() -> string {
    let r = exec_capture("spid3r", ["version"], null);
    if r.is_err() or int(r.unwrap()["code"]) != 0 {
        return "";
    }
    let s = string(r.unwrap()["stdout"]);
    for row in s.split("\n") {
        let t = string(row).trim();
        if t.starts_with("Version") {
            let parts = t.split(" ");
            let k = parts.len() - 1;
            while k >= 0 {
                let p = string(parts[k]).trim();
                if p != "" and p != "Version" {
                    return p;
                }
                k -= 1;
            }
        }
    }
    return probe_version("spid3r", ["--version"]);
}

fn is_hex_sha256(s: string) -> bool {
    let t = string(s).trim().lower();
    if t.len() != 64 {
        return false;
    }
    let i = 0;
    while i < 64 {
        let c = t[i];
        let ok = (c >= "0" and c <= "9") or (c >= "a" and c <= "f");
        if not ok {
            return false;
        }
        i += 1;
    }
    return true;
}

/// Compute lowercase 64-hex SHA-256 digest of a file on disk (A-14).
public fn sha256_file(path: string) -> string {
    if not file_exists(path) {
        return "";
    }
    if fs.is_windows() {
        let rc = exec_capture("certutil", ["-hashfile", path, "SHA256"], null);
        if rc.is_ok() and int(rc.unwrap()["code"]) == 0 {
            for row in string(rc.unwrap()["stdout"]).split("\n") {
                let clean = string(row).replace("\r", "").replace(" ", "").trim().lower();
                if is_hex_sha256(clean) {
                    return clean;
                }
            }
        }
    } else {
        let rs = exec_capture("sha256sum", [path], null);
        if rs.is_ok() and int(rs.unwrap()["code"]) == 0 {
            let tok = string(
                string(rs.unwrap()["stdout"]).trim().split(" ")[0]
            ).trim().lower();
            if is_hex_sha256(tok) {
                return tok;
            }
        }
        let rm = exec_capture("shasum", ["-a", "256", path], null);
        if rm.is_ok() and int(rm.unwrap()["code"]) == 0 {
            let tok2 = string(
                string(rm.unwrap()["stdout"]).trim().split(" ")[0]
            ).trim().lower();
            if is_hex_sha256(tok2) {
                return tok2;
            }
        }
    }
    let py_cmd = if fs.is_windows() {
        "python"
    } else {
        "python3"
    };
    let rp = exec_capture(
        py_cmd,
        ["-c",
        "import hashlib,sys;h=hashlib.sha256();f=open(sys.argv[1],'rb');h.update(f.read());f.close();print(h.hexdigest())",
        path],
        null
    );
    if rp.is_ok() and int(rp.unwrap()["code"]) == 0 {
        let dig = string(rp.unwrap()["stdout"]).trim().lower();
        if is_hex_sha256(dig) {
            return dig;
        }
    }
    return "";
}

/// Compute base64-encoded SHA-256 digest of a file on disk for HTML SRI attributes (A-31).
public fn sha256_base64_file(path: string) -> string {
    let hex = sha256_file(path);
    if hex == "" {
        return "";
    }
    let py_cmd = if fs.is_windows() {
        "python"
    } else {
        "python3"
    };
    let rp = exec_capture(
        py_cmd,
        ["-c",
        "import base64,hashlib,sys;print(base64.b64encode(hashlib.sha256(open(sys.argv[1],'rb').read()).digest()).decode())",
        path],
        null
    );
    if rp.is_ok() and int(rp.unwrap()["code"]) == 0 {
        let b64 = string(rp.unwrap()["stdout"]).trim();
        if b64 != "" {
            return b64;
        }
    }
    let ro = exec_capture("openssl", ["dgst", "-sha256", "-binary", path], null);
    if ro.is_ok() and int(ro.unwrap()["code"]) == 0 {
        // Fallback when python is absent: try openssl base64 pipeline via shell
        let sh_cmd = if fs.is_windows() {
            "powershell"
        } else {
            "sh"
        };
        let args = if fs.is_windows() {
            ["-NoProfile",
            "-Command",
            "[Convert]::ToBase64String([System.Security.Cryptography.SHA256]::Create().ComputeHash([System.IO.File]::ReadAllBytes('" + path.replace("'", "''") + "')))"]
        } else {
            ["-c",
            "openssl dgst -sha256 -binary \"$1\" | base64",
            "_",
            path]
        };
        let rs = exec_capture(sh_cmd, args, null);
        if rs.is_ok() and int(rs.unwrap()["code"]) == 0 {
            let out = string(rs.unwrap()["stdout"]).trim();
            if out != "" {
                return out;
            }
        }
    }
    return "";
}

/// Format an integrity="sha256-..." attribute for an emitted local script asset (A-31).
public fn sri_sha256_attr(path: string) -> string {
    let b64 = sha256_base64_file(path);
    if b64 == "" {
        return "";
    }
    return " integrity=\"sha256-" + b64 + "\"";
}

/// Verify downloads/packages/catalog.json against catalog.json.sha256 and optional detached OpenSSL sig (A-14).
public fn verify_catalog_signature(
    cat_path_in: string = "",
    sidecar_path_in: string = ""
) -> bool {
    let dl_pkg = fs.join_dir(fs.downloads_dir(), "packages");
    let cat_path = if cat_path_in != "" {
        cat_path_in
    } else {
        fs.join_dir(dl_pkg, "catalog.json")
    };
    let side_path = if sidecar_path_in != "" {
        sidecar_path_in
    } else {
        cat_path + ".sha256"
    };
    if not file_exists(cat_path) or not file_exists(side_path) {
        println("error[security]: missing catalog.json or catalog.json.sha256");
        return false;
    }
    let sr = read_file(side_path);
    if sr.is_err() {
        println("error[security]: cannot read " + side_path);
        return false;
    }
    let expected = "";
    for row in string(sr.unwrap()).split("\n") {
        let t = string(row).replace("\r", "").trim();
        if t == "" {
            continue;
        }
        let toks = t.split(" ");
        if toks.len() > 0 and is_hex_sha256(string(toks[0])) {
            expected = string(toks[0]).trim().lower();
            break;
        }
    }
    if expected == "" {
        println("error[security]: invalid SHA-256 entry in " + side_path);
        return false;
    }
    if not verify_sha256(cat_path, expected, "catalog.json") {
        return false;
    }
    let sig_path = cat_path + ".sig";
    let pub_path = fs.join_dir(dl_pkg, "catalog.pub.pem");
    if file_exists(sig_path) and file_exists(pub_path) {
        let vr = exec_capture(
            "openssl",
            ["dgst",
            "-sha256",
            "-verify",
            pub_path,
            "-signature",
            sig_path,
            cat_path],
            null
        );
        if vr.is_err() or int(vr.unwrap()["code"]) != 0 {
            println(
                "error[security]: detached OpenSSL signature verification failed for catalog.json"
            );
            return false;
        }
    }
    return true;
}

/// Verify a file's SHA-256 digest against an expected 64-hex string (A-14).
public fn verify_sha256(path: string, expected: string, label: string) -> bool {
    let exp = string(expected).trim().lower();
    if exp == "" {
        return true;
    }
    if not is_hex_sha256(exp) {
        println(
            "error[security]: invalid expected SHA-256 digest configured for " + label + ": " + exp
        );
        return false;
    }
    let actual = sha256_file(path);
    if actual == "" {
        println("error[security]: could not compute SHA-256 for " + label + " (" + path + ")");
        return false;
    }
    if actual != exp {
        println("error[security]: SHA-256 mismatch for " + label + " (" + path + ")");
        println("  expected: " + exp);
        println("  actual:   " + actual);
        return false;
    }
    return true;
}

/// Read downloads/packages/catalog.json.
public fn read_catalog() -> map {
    let p = fs.join_dir(fs.downloads_dir(), "packages/catalog.json");
    let r = read_file(p);
    if r.is_err() {
        return {
        };
    }
    try {
        let m = json_parse(string(r.unwrap()));
        if type_of(m) == "map" {
            return m;
        }
    } catch (_e) {
        return {
        };
    }
    return {
    };
}

/// Look up a pinned SHA-256 digest in catalog.json for pkg_id (and optional arch/file subkey).
public fn catalog_sha256(pkg_id: string, subkey: string = "") -> string {
    let cat = read_catalog();
    if not cat.has("packages") or type_of(cat["packages"]) != "list" {
        return "";
    }
    for entry in cat["packages"] {
        if type_of(entry) != "map" or not entry.has("id") {
            continue;
        }
        if string(entry["id"]) != pkg_id {
            continue;
        }
        if subkey != "" and entry.has("sha256ByArch") and type_of(entry["sha256ByArch"]) == "map" {
            let am = entry["sha256ByArch"];
            if am.has(subkey) {
                return string(am[subkey]).trim().lower();
            }
        }
        if entry.has("sha256") and entry["sha256"] != null {
            return string(entry["sha256"]).trim().lower();
        }
        return "";
    }
    return "";
}

fn catalog_wasm_digests(ver: string) -> map {
    let cat = read_catalog();
    if not cat.has("packages") or type_of(cat["packages"]) != "list" {
        return {
        };
    }
    for entry in cat["packages"] {
        if type_of(entry) == "map" and entry.has("id") and string(entry["id"]) == "spid3r-wasm-runtime" {
            if entry.has("sha256ByVersion") and type_of(entry["sha256ByVersion"]) == "map" {
                let byv = entry["sha256ByVersion"];
                if byv.has(ver) and type_of(byv[ver]) == "map" {
                    return byv[ver];
                }
            }
        }
    }
    return {
    };
}

fn write_wasm_sidecar(dl_dir: string) {
    let js_h = sha256_file(dl_dir + "/spid3r.js");
    let wasm_h = sha256_file(dl_dir + "/spid3r.wasm");
    if js_h != "" and wasm_h != "" {
        let sidecar = js_h + "  spid3r.js\n" + wasm_h + "  spid3r.wasm\n";
        let _w = write_file(dl_dir + "/checksums.sha256", sidecar);
    }
}

fn verify_wasm_cache(dl_dir: string, ver: string) -> bool {
    let pinned = catalog_wasm_digests(ver);
    if pinned.has("spid3r.js") and not verify_sha256(
        dl_dir + "/spid3r.js",
        string(pinned["spid3r.js"]),
        "cached spid3r.js (" + ver + ")"
    ) {
        return false;
    }
    if pinned.has("spid3r.wasm") and not verify_sha256(
        dl_dir + "/spid3r.wasm",
        string(pinned["spid3r.wasm"]),
        "cached spid3r.wasm (" + ver + ")"
    ) {
        return false;
    }
    let side_p = dl_dir + "/checksums.sha256";
    if file_exists(side_p) {
        let sr = read_file(side_p);
        if sr.is_err() {
            println("error[security]: cannot read " + side_p);
            return false;
        }
        for row in string(sr.unwrap()).split("\n") {
            let t = string(row).replace("\r", "").trim();
            if t == "" {
                continue;
            }
            let parts = t.split("  ");
            if parts.len() >= 2 {
                let dig = string(parts[0]).trim();
                let fname = string(parts[1]).trim();
                if fname == "spid3r.js" or fname == "spid3r.wasm" {
                    if not verify_sha256(dl_dir + "/" + fname, dig, "cached " + fname) {
                        return false;
                    }
                }
            }
        }
    } else {
        write_wasm_sidecar(dl_dir);
    }
    return true;
}

/// Provide spid3r.js + spid3r.wasm, caching once under <fw_root>/downloads/wasm-runtime/<version>/.
/// Verifies SHA-256 integrity against catalog pins and checksums.sha256 on cache hit (A-14).
public fn wasm_runtime_assets(tmpdir: string) -> string {
    let ver = probe_spid3r_version();
    if ver == "" {
        ver = "default";
    }
    let dl_root = fs.join_dir(fs.downloads_dir(), "wasm-runtime");
    let dl_dir = fs.join_dir(dl_root, ver);
    if file_exists(dl_dir + "/spid3r.js") and file_exists(dl_dir + "/spid3r.wasm") {
        if not verify_wasm_cache(dl_dir, ver) {
            return "";
        }
        return dl_dir;
    }

    fs.ensure_dir(tmpdir);
    let stub = tmpdir + "/_bundlestub.matrix";
    write_file(stub, "fn main() -> int {\n    return 0;\n}\n");
    let proj = tmpdir + "/rt";
    if not run_checked(
        "spid3r",
        ["bundle",
        stub,
        "--target",
        "android",
        "-o",
        proj],
        "runtime bundling failed"
    ) {
        return "";
    }
    let assets = proj + "/app/src/main/assets";
    if not (file_exists(assets + "/spid3r.js") and file_exists(assets + "/spid3r.wasm")) {
        println("error: runtime assets missing after bundle");
        return "";
    }

    fs.ensure_dir(fs.downloads_dir());
    fs.ensure_dir(dl_root);
    fs.ensure_dir(dl_dir);
    let cj = copy_file(assets + "/spid3r.js", dl_dir + "/spid3r.js");
    let cw = copy_file(assets + "/spid3r.wasm", dl_dir + "/spid3r.wasm");
    if cj.is_ok() and cw.is_ok() {
        write_wasm_sidecar(dl_dir);
        if not verify_wasm_cache(dl_dir, ver) {
            return "";
        }
        dir_remove(tmpdir);
        return dl_dir;
    }
    return assets;
}
