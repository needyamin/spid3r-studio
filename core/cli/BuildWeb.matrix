// cli/BuildWeb.matrix
// Wasm host HTML emitter, bundle verification gate (A-38/A-49), and Web target packager.

import "Fs" as fs;
import "Manifest" as man;
import "Exec" as ex;

fn is_token_char(c: string, upper_only: bool, allow_dash: bool) -> bool {
    if (c >= "A" and c <= "Z") or (c >= "0" and c <= "9") {
        return true;
    }
    if not upper_only and ((c >= "a" and c <= "z") or c == "_") {
        return true;
    }
    if allow_dash and c == "-" {
        return true;
    }
    return false;
}

fn has_prefixed_secret(
    src: string,
    prefix: string,
    min_tail: int,
    upper_only: bool,
    allow_dash: bool
) -> bool {
    if not src.contains(prefix) {
        return false;
    }
    let plen = prefix.len();
    let rem = src;
    let guard = 0;
    while guard < 128 {
        guard += 1;
        let pos = rem.index_of(prefix);
        if pos < 0 {
            return false;
        }
        let j = pos + plen;
        let n = rem.len();
        let run = 0;
        while j < n and is_token_char(rem[j], upper_only, allow_dash) {
            run += 1;
            j += 1;
        }
        if run >= min_tail {
            return true;
        }
        if pos + plen >= n {
            return false;
        }
        rem = rem.slice(pos + plen, n);
    }
    return false;
}

/// Build-time secret scanner for world-readable flat bundles (A-49).
/// Returns a list of matched secret class descriptions (empty when clean).
public fn scan_secrets(flat: string) -> list {
    let findings = [];
    if has_prefixed_secret(flat, "AKIA", 16, true, false) {
        findings.push("AWS access key ID (AKIA...)");
    }
    for gh in ["ghp_", "gho_", "ghu_", "ghs_", "github_pat_"] {
        if has_prefixed_secret(flat, gh, 20, false, false) {
            findings.push("GitHub token (" + gh + "...)");
            break;
        }
    }
    for sk in ["sk_live_", "sk_test_"] {
        if has_prefixed_secret(flat, sk, 16, false, false) {
            findings.push("Stripe secret key (" + sk + "...)");
            break;
        }
    }
    for sl in ["xoxb-", "xoxp-", "xoxa-"] {
        if has_prefixed_secret(flat, sl, 12, false, true) {
            findings.push("Slack token (" + sl + "...)");
            break;
        }
    }
    if has_prefixed_secret(flat, "AIza", 35, false, true) {
        findings.push("Google API key (AIza...)");
    }
    if flat.contains("-----BEGIN ") and flat.contains("PRIVATE KEY-----") {
        let rem = flat;
        let pguard = 0;
        while pguard < 64 {
            pguard += 1;
            let pem_pos = rem.index_of("-----BEGIN ");
            if pem_pos < 0 {
                break;
            }
            let end_p = pem_pos + 64;
            if end_p > rem.len() {
                end_p = rem.len();
            }
            if rem.slice(pem_pos, end_p).contains("PRIVATE KEY-----") {
                findings.push("PEM private key block");
                break;
            }
            if pem_pos + 11 >= rem.len() {
                break;
            }
            rem = rem.slice(pem_pos + 11, rem.len());
        }
    }
    return findings;
}

/// Static bundle gate (A-38 & A-49): scans for hardcoded secrets and runs
/// `spid3r check --deny-warnings` on the exact flattened bundle.
public fn verify_flat_bundle(flat: string, workdir: string) -> int {
    let secrets = scan_secrets(flat);
    if secrets.len() > 0 {
        for s in secrets {
            println(
                "error[security]: hardcoded secret detected in flat bundle: " + string(s)
            );
        }
        println(
            "hint: flat bundles are readable by clients; move credentials to a server/proxy."
        );
        return 1;
    }
    fs.ensure_dir(workdir);
    let tmp = fs.join_dir(workdir, "._studio_bundle_check.matrix");
    if not fs.write_checked(tmp, flat) {
        return 1;
    }
    let r = exec_capture("spid3r", ["check", "--deny-warnings", tmp], null);
    let _rm = remove_file(tmp);
    if r.is_err() {
        println("error: spid3r check failed to run: " + string(r.unwrap_err()));
        return 1;
    }
    let m = r.unwrap();
    if int(m["code"]) != 0 {
        ex.flush_child_output(m);
        println("error: flat bundle failed static verification (spid3r check --deny-warnings)");
        return 1;
    }
    return 0;
}

public fn fill_host_page(
    appdir: string,
    outdir: string,
    client_js: string,
    release: bool = false
) -> int {
    let name = man.app_name_of(appdir);
    let bundle_id = man.app_bundle_id_of(appdir);
    let tpl_r = read_file(
        fs.join_dir(fs.fw_root(), "frameworks/targets/wasmhost.template.html")
    );
    if tpl_r.is_err() {
        println("error: missing frameworks/targets/wasmhost.template.html");
        return 1;
    }
    let tpl = string(tpl_r.unwrap());
    let icon_tag = "";
    let touch_icon_tag = "";
    let icon_src = man.app_icon_of(appdir);
    if icon_src != "" {
        let ext = fs.file_ext(icon_src);
        if ext == "" {
            ext = "png";
        }
        let icon_name = "icon." + ext;
        if copy_file(icon_src, outdir + "/" + icon_name).is_ok() {
            let e_icon = fs.html_escape(icon_name);
            icon_tag = "<link rel=\"icon\" href=\"" + e_icon + "\">";
            touch_icon_tag = "\n<link rel=\"apple-touch-icon\" href=\"" + e_icon + "\">";
        }
    }
    let theme_map = man.app_theme_of(appdir);
    let theme_json = "null";
    let theme_color = "#4f46e5";
    let status_style = "default";
    if theme_map.len() > 0 {
        theme_json = fs.safe_script_json(theme_map);
        if theme_map.has("primary") {
            theme_color = string(theme_map["primary"]);
        }
        if theme_map.has("mode") and string(theme_map["mode"]) == "dark" {
            status_style = "black-translucent";
        }
    }
    let pwa_tags = "<meta name=\"theme-color\" content=\"" + fs.html_escape(theme_color) + "\">\n"
    + "<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n"
    + "<meta name=\"mobile-web-app-capable\" content=\"yes\">\n"
    + "<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"" + status_style + "\">\n"
    + "<meta name=\"apple-mobile-web-app-title\" content=\"" + fs.html_escape(name) + "\">\n"
    + "<link rel=\"manifest\" href=\"manifest.json\">" + touch_icon_tag;

    let csp_conn = man.csp_connect_src_of(appdir);
    let csp_extra = if release {
        " upgrade-insecure-requests;"
    } else {
        ""
    };
    let app_ver = man.app_version_of(appdir);
    let nonce_seed = bundle_id + "|" + app_ver + "|" + string(client_js.len()) + "|" + string(now_ms());
    let csp_nonce = ex.sha256_file(outdir + "/app.matrix");
    if csp_nonce == "" {
        csp_nonce = fs.sanitize_swift_ident(bundle_id) + "_" + string(nonce_seed.len()) + "_" + string(now_ms());
    } else {
        csp_nonce = csp_nonce.slice(0, 24);
    }
    let sri_attr = ex.sri_sha256_attr(outdir + "/spid3r.js");
    let out = tpl.replace("\{\{APP_CSP_CONNECT_SRC\}\}", fs.html_escape(csp_conn))
    .replace("\{\{APP_CSP_EXTRA\}\}", csp_extra)
    .replace("\{\{APP_CSP_NONCE\}\}", csp_nonce)
    .replace("\{\{SPID3R_JS_SRI\}\}", sri_attr)
    .replace("\{\{APP_TITLE\}\}", fs.html_escape(name))
    .replace("\{\{APP_ICON_TAG\}\}", icon_tag)
    .replace("\{\{APP_PWA_TAGS\}\}", pwa_tags)
    .replace("\{\{APP_BUNDLE_ID_JSON\}\}", fs.safe_script_json(bundle_id))
    .replace("\{\{APP_THEME_JSON\}\}", theme_json)
    .replace("\{\{CLIENT_JS\}\}", client_js);
    if not fs.write_checked(outdir + "/index.html", out) {
        return 1;
    }
    return 0;
}

/// Emit FlatKit line map JSON (app.matrix.map.json) for dev runtime stack mapping (A-24).
public fn emit_line_map(outdir: string, lmap: list) -> bool {
    if lmap == null or lmap.len() == 0 {
        return true;
    }
    return fs.write_checked(outdir + "/app.matrix.map.json", json_write(lmap) + "\n");
}

fn write_pwa_png_icons(icon_src: string, outdir: string) -> bool {
    let p192 = outdir + "/icon-192.png";
    let p512 = outdir + "/icon-512.png";
    if icon_src != "" and fs.file_ext(icon_src) == "png" {
        if copy_file(icon_src, p192).is_ok() and copy_file(icon_src, p512).is_ok() {
            return true;
        }
    }
    let py_cmd = if fs.is_windows() {
        "python"
    } else {
        "python3"
    };
    let script = "import struct,zlib,sys\ndef chunk(t,d):\n return struct.pack('!I',len(d))+t+d+struct.pack('!I',zlib.crc32(t+d)&0xffffffff)\ndef mk(sz):\n row=b'\\x00'+b'\\x4f\\x46\\xe5\\xff'*sz\n raw=zlib.compress(row*sz,1)\n return b'\\x89PNG\\r\\n\\x1a\\n'+chunk(b'IHDR',struct.pack('!IIBBBBB',sz,sz,8,6,0,0,0))+chunk(b'IDAT',raw)+chunk(b'IEND',b'')\nopen(sys.argv[1],'wb').write(mk(192))\nopen(sys.argv[2],'wb').write(mk(512))\n";
    let r = exec_capture(py_cmd, ["-c", script, p192, p512], null);
    if r.is_ok() and int(r.unwrap()["code"]) == 0 and file_exists(p192) and file_exists(p512) {
        return true;
    }
    // Minimal 1x1 fallback PNG base64-decoded via PowerShell if Python is unavailable
    let b64 = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==";
    if fs.is_windows() {
        let ps = "$b=[Convert]::FromBase64String('" + b64 + "');[IO.File]::WriteAllBytes('" + p192.replace("'", "''") + "',$b);[IO.File]::WriteAllBytes('" + p512.replace("'", "''") + "',$b)";
        let rp = exec_capture("powershell", ["-NoProfile", "-Command", ps], null);
        return rp.is_ok() and int(rp.unwrap()["code"]) == 0;
    }
    let rl = exec_capture(
        "sh",
        ["-c",
        "printf '%s' \"$1\" | base64 -d > \"$2\" && cp \"$2\" \"$3\"",
        "_",
        b64,
        p192,
        p512],
        null
    );
    return rl.is_ok() and int(rl.unwrap()["code"]) == 0;
}

fn emit_pwa_files(appdir: string, outdir: string) -> int {
    let name = man.app_name_of(appdir);
    let bundle_id = man.app_bundle_id_of(appdir);
    let app_ver = man.app_version_of(appdir);
    let tm = man.app_theme_of(appdir);
    let theme_color = if tm.has("primary") {
        string(tm["primary"])
    } else {
        "#4f46e5"
    };
    let bg_color = if tm.has("mode") and string(tm["mode"]) == "dark" {
        "#0b0f1a"
    } else {
        "#f4f5fb"
    };
    let manifest = {
        "name": name,
        "short_name": name,
        "start_url": "./index.html",
        "display": "standalone",
        "background_color": bg_color,
        "theme_color": theme_color,
    };
    let icon_src = man.app_icon_of(appdir);
    if write_pwa_png_icons(icon_src, outdir) {
        manifest["icons"] = [{
            "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"
        }
        , {
            "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable"
        }
        , {
            "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"
        }
        , {
            "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"
        }
        ];
    }
    if not fs.write_checked(outdir + "/manifest.json", json_write(manifest)) {
        return 1;
    }

    let off_txt = fs.render_template("targets/offline.template.html", {
        "APP_TITLE": fs.html_escape(name),
        "THEME_COLOR": fs.html_escape(theme_color),
        "BG_COLOR": fs.html_escape(bg_color),
    });
    if off_txt == "" or not fs.write_checked(outdir + "/offline.html", off_txt) {
        return 1;
    }

    let safe_bid = fs.kotlin_str_escape(bundle_id).replace("'", "\\'");
    let safe_ver = fs.kotlin_str_escape(app_ver).replace("'", "\\'");
    let sw_txt = fs.render_template("targets/sw.template.js", {
        "BUNDLE_ID": safe_bid, "APP_VERSION": safe_ver
    });
    if sw_txt == "" {
        return 1;
    }
    if not fs.write_checked(outdir + "/sw.js", sw_txt) {
        return 1;
    }
    return 0;
}

public fn copy_wasm_assets(rt_dir: string, dest_dir: string) -> int {
    let fw = fs.fw_root();
    let copies = [
    [rt_dir + "/spid3r.js", dest_dir + "/spid3r.js", "spid3r.js"],
    [rt_dir + "/spid3r.wasm", dest_dir + "/spid3r.wasm", "spid3r.wasm"],
    [fs.join_dir(fw, "frameworks/targets/wasmworker.js"), dest_dir + "/wasmworker.js", "wasmworker.js"],
    ];
    for item in copies {
        let r = copy_file(item[0], item[1]);
        if r.is_err() {
            println("error: copying " + item[2] + " failed: " + string(r.unwrap_err()));
            return 1;
        }
    }
    return 0;
}

public fn build(
    appdir: string,
    outdir: string,
    flat: string,
    client_js: string,
    release: bool = false
) -> int {
    fs.ensure_dir(outdir);
    fs.setup_import_path();
    for warn in man.validate_manifest(appdir) {
        println("warning: " + warn);
    }
    if verify_flat_bundle(flat, outdir) != 0 {
        return 1;
    }
    let mode_lbl = if release {
        "release"
    } else {
        "debug"
    };
    println("building web app (" + mode_lbl + ") -> " + outdir + "/index.html");
    let assets = ex.wasm_runtime_assets(outdir + "/_runtime");
    if assets == "" {
        return 1;
    }
    if copy_wasm_assets(assets, outdir) != 0 {
        return 1;
    }
    if not fs.copy_app_assets(appdir, outdir) {
        return 1;
    }
    if not fs.write_checked(outdir + "/app.matrix", flat) {
        return 1;
    }
    let rc = fill_host_page(appdir, outdir, client_js, release);
    if rc != 0 {
        return rc;
    }
    if emit_pwa_files(appdir, outdir) != 0 {
        return 1;
    }
    if release {
        if file_exists(outdir + "/app.matrix.map.json") {
            let _rm_map = remove_file(outdir + "/app.matrix.map.json");
        }
        if file_exists(outdir + "/.__studio_dev_ver") {
            let _rm_ver = remove_file(outdir + "/.__studio_dev_ver");
        }
    }
    if not man.emit_sbom(appdir, outdir, "web", release) {
        return 1;
    }
    println("done: " + outdir + "/index.html (serve the folder over http, or open in a browser)");
    return 0;
}
