// cli/Args.matrix
// CLI help text and flag parsing helpers.

public fn usage() {
    println("AppStudio CLI — Spid3r v1.5.0 apps (.matrix/.mt) for Desktop, Web, iOS & Android");
    println("");
    println("Usage: spid3r run studio.matrix <command> [args]");
    println("");
    println("Commands:");
    println(
        "  new <AppName> [outdir]            Scaffold a self-contained app (vendors the framework)"
    );
    println("  gui [appdir]                      Launch AppStudio GUI Control Center window");
    println(
        "  run <appdir> [--engine E] [--devtools]  Run the app in a desktop webview (E = tree|vm)"
    );
    println(
        "  dev <appdir> [--target T]         Hot-reload preview (--target web [--host IP] [--port N] | ios)"
    );
    println("  check <appdir>                    Static-check the app entry");
    println(
        "  build <appdir> [--target T] [--release]  T = web (default) | android | ios | desktop"
    );
    println(
        "  ios <subcommand>                  Manage xtool & deploy iOS (install-tools|status|setup|devices|run)"
    );
    println(
        "  test [filter] [--all]             Run fmt --check, strict checks, and test suites"
    );
    println("  clean [appdir] [--cache]          Remove build artifacts (and optional cache)");
    println("  upgrade <appdir>                  Refresh vendored vendor/studio/ runtime modules");
    println("  doctor                            Check Spid3r, WASM, iOS & Android toolchains");
    println("  help                              This message");
}

public fn arg_value(args: list, flag: string) -> string {
    let i = 0;
    while i < args.len() {
        let a = string(args[i]);
        if a == flag and i + 1 < args.len() {
            return string(args[i + 1]);
        }
        if a.starts_with(flag + "=") {
            return a.slice(flag.len() + 1, a.len());
        }
        i += 1;
    }
    return "";
}

public fn has_flag(args: list, flag: string) -> bool {
    for item in args {
        let a = string(item);
        if a == flag {
            return true;
        }
        if a.starts_with(flag + "=") {
            let v = a.slice(flag.len() + 1, a.len()).trim().lower();
            return v != "false" and v != "0" and v != "no";
        }
    }
    return false;
}
