// cli/Doctor.matrix
// Toolchain diagnostics for spid3r, iOS (xtool/swift), and Android (java/gradle/adb/SDK).

import "Exec" as ex;
import "Fs" as fs;
import "IosToolchain" as ios_tc;
import "core/Version" as ver_info;

public fn cmd_doctor() -> int {
    println("AppStudio doctor (v" + ver_info.STUDIO_VERSION + ")");
    println("----------------");
    let ok_all = true;

    let v = ex.probe_spid3r_version();
    if v == "" {
        println(
            "[x] spid3r        NOT FOUND on PATH (requires v" + ver_info.SPID3R_MIN_VERSION + "+)"
        );
        ok_all = false;
    } else {
        println("[ok] spid3r       " + v + " (target v" + ver_info.SPID3R_TARGET_VERSION + ")");
    }

    let spkg = ex.probe_version("spkg", ["--version"]);
    if spkg == "" {
        println("[!] spkg          not found on PATH (optional package manager)");
    } else {
        println("[ok] spkg         " + spkg);
    }

    let yamc = ex.probe_version("yamc", ["--version"]);
    if yamc == "" {
        println("[!] yamc          not found on PATH (optional standalone AOT compiler)");
    } else {
        println("[ok] yamc         " + yamc);
    }

    let wasm_ver = if v != "" {
        v
    } else {
        ver_info.SPID3R_TARGET_VERSION
    };
    let wasm_dir = fs.join_dir(fs.downloads_dir(), "wasm-runtime/" + wasm_ver);
    if file_exists(wasm_dir + "/spid3r.wasm") and file_exists(wasm_dir + "/spid3r.js") {
        println("[ok] wasm cache   " + wasm_dir);
    } else {
        println("[!] wasm cache    not cached yet (auto-extracted on first web/mobile build)");
    }

    let x = ios_tc.probe_xtool_status();
    if x == "" {
        println("[!] xtool         not found (needed only for the iOS target)");
        println("    install: spid3r run studio.matrix ios install-tools");
    } else {
        println("[ok] xtool        " + x);
    }

    let sw = ex.probe_version("swift", ["--version"]);
    if sw == "" and ios_tc.has_wsl() {
        sw = ios_tc.probe_swift_wsl_status();
        if sw != "" {
            sw = sw + " (WSL)";
        }
    }
    if sw == "" {
        println(
            "[!] swift         not found (install via swiftly for native iOS builds)"
        );
    } else {
        println("[ok] swift        " + sw);
        let sdk = ios_tc.probe_darwin_sdk_status();
        if sdk == "" {
            println(
                "[!] Darwin SDK    not installed (run: spid3r run studio.matrix ios sdk-install <Xcode.xip>)"
            );
        } else {
            println("[ok] Darwin SDK   " + sdk);
        }
    }

    let j = ex.probe_version("java", ["-version"]);
    if j == "" {
        println("[!] java          not found (needed by Gradle/Android builds)");
    } else {
        println("[ok] java         " + j);
    }

    let gr = ex.probe_version("gradle", ["--version"]);
    if gr == "" {
        println("[!] gradle        not found on PATH (Android Studio includes its own Gradle)");
    } else {
        println("[ok] gradle       " + gr);
    }

    let adb = ex.probe_version("adb", ["version"]);
    if adb == "" {
        println("[!] adb           not found (Android platform-tools)");
    } else {
        println("[ok] adb          " + adb);
    }

    let ah = env("ANDROID_HOME");
    let asdk = env("ANDROID_SDK_ROOT");
    if string(ah) != "none" and string(ah.unwrap()).trim() != "" {
        println("[ok] ANDROID_HOME " + string(ah.unwrap()));
    } elif string(asdk) != "none" and string(asdk.unwrap()).trim() != "" {
        println("[ok] ANDROID_SDK  " + string(asdk.unwrap()));
    } else {
        println("[!] ANDROID_HOME  not set (required for command-line Android APK builds)");
    }

    println("");
    if ok_all {
        println("core toolchain ready — run: spid3r run studio.matrix new MyApp");
        return 0;
    }
    println("error: core spid3r toolchain missing.");
    return 1;
}
