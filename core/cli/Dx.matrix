// cli/Dx.matrix
// Developer experience CLI commands: test, clean, upgrade.

import "Fs" as fs;
import "Exec" as ex;
import "Args" as args_cli;

fn is_source_ext(name: string) -> bool {
    return name.ends_with(".matrix") or name.ends_with(".mt");
}

fn collect_matrix_files(dir: string, out: list, include_all_ws: bool = false) {
    let ld = list_dir(dir);
    if ld.is_err() {
        return;
    }
    for item in ld.unwrap() {
        let name = string(item);
        let p = fs.join_dir(dir, name);
        if is_dir(p) {
            if name == "downloads" or name == "documents" or name == "build" or name == "dist" or name == ".git" or name == "storage" or name == "vendor" or name.starts_with("_test_") {
                continue;
            }
            if not include_all_ws and fs.base_name(dir) == "workspace" and name != "demo" {
                continue;
            }
            collect_matrix_files(p, out, include_all_ws);
        } elif is_file(p) and is_source_ext(name) and not name.starts_with("._tmp_") {
            out.push(p);
        }
    }
}

fn first_positional(args: list) -> string {
    let skip_next = false;
    for item in args {
        let s = string(item);
        if skip_next {
            skip_next = false;
            continue;
        }
        if s == "--target" or s == "-o" or s == "--port" or s == "--host" or s == "--engine" {
            skip_next = true;
            continue;
        }
        if s.starts_with("-") {
            continue;
        }
        return s;
    }
    return "";
}

fn check_single_file(p: string) -> bool {
    let r = exec_capture("spid3r", ["check", "--deny-warnings", p], null);
    if r.is_err() {
        println("error checking " + p + ": " + string(r.unwrap_err()));
        return false;
    }
    let m = r.unwrap();
    if int(m["code"]) != 0 {
        ex.flush_child_output(m);
        return false;
    }
    return true;
}

fn check_files(files: list) -> bool {
    if files.len() == 0 {
        return true;
    }
    let args = ["check", "--deny-warnings"];
    for f in files {
        args.push(string(f));
    }
    let r = exec_capture("spid3r", args, null);
    if r.is_ok() {
        let m = r.unwrap();
        if int(m["code"]) == 0 {
            return true;
        }
        let err_low = string(m["stderr"]).lower();
        if not err_low.contains("unexpected argument") and not err_low.contains("usage:") {
            ex.flush_child_output(m);
            return false;
        }
    }
    for f in files {
        if not check_single_file(string(f)) {
            return false;
        }
    }
    return true;
}

public fn cmd_test(rest: list) -> int {
    let root = fs.trim_slash(fs.fw_root());
    let filter = first_positional(rest);
    let include_all_ws = args_cli.has_flag(rest, "--all");
    let all_files = [];
    collect_matrix_files(root, all_files, include_all_ws);
    all_files.sort();
    if all_files.len() == 0 {
        println("error: no .matrix files found under " + root);
        return 1;
    }

    println("[1/3] checking formatting across " + string(all_files.len()) + " files...");
    let fmt_args = ["fmt", "--check"];
    for f in all_files {
        fmt_args.push(f);
    }
    if not ex.run_checked("spid3r", fmt_args, "fmt --check failed") {
        return 1;
    }

    println("[2/3] running strict static checks (--deny-warnings)...");
    let root_files = [fs.join_dir(root, "studio.matrix")];
    let cli_ld = list_dir(fs.join_dir(root, "core/cli"));
    if cli_ld.is_ok() {
        for item in cli_ld.unwrap() {
            let name = string(item);
            if name.ends_with(".matrix") {
                root_files.push(fs.join_dir(root, "core/cli/" + name));
            }
        }
    }
    if not check_files(root_files) {
        return 1;
    }

    fs.setup_import_path();
    let has_gui = ex.supports_gui_builtins();
    let skipped_gui = 0;
    let import_files = [];
    for f in all_files {
        let rel = f;
        if root != "." and rel.starts_with(root + "/") {
            rel = rel.slice(root.len() + 1, rel.len());
        }
        if rel == "studio.matrix" or rel.starts_with("core/cli/") {
            continue;
        }
        if not has_gui and fs.base_name(f) == "main.matrix" {
            let rf = read_file(f);
            if rf.is_ok() and string(rf.unwrap()).contains("gui_title(") {
                skipped_gui += 1;
                continue;
            }
        }
        import_files.push(f);
    }
    if not check_files(import_files) {
        return 1;
    }
    if skipped_gui > 0 {
        println(
            "  checked " + string(all_files.len() - skipped_gui) + " files cleanly (skipped " + string(skipped_gui) + " gui_* entry shim(s) on headless spid3r)"
        );
    } else {
        println("  checked " + string(all_files.len()) + " files cleanly");
    }

    println("[3/3] running test suites...");
    let test_dir = fs.join_dir(root, "core/tests");
    let tld = list_dir(test_dir);
    if tld.is_err() {
        println("error: missing core/tests/ directory");
        return 1;
    }
    let suites = [];
    for item in tld.unwrap() {
        let name = string(item);
        if name.ends_with(".matrix") and (filter == "" or name.contains(filter)) {
            suites.push(fs.join_dir(test_dir, name));
        }
    }
    suites.sort();
    if suites.len() == 0 {
        println("error: no test suites matched");
        return 1;
    }

    let ok_all = true;
    for sp in suites {
        println("--- running " + sp + " ---");
        let rr = exec_capture("spid3r", ["run", sp], null);
        if rr.is_err() {
            println("error: " + string(rr.unwrap_err()));
            ok_all = false;
            continue;
        }
        let m = rr.unwrap();
        ex.flush_child_output(m);
        if int(m["code"]) != 0 {
            ok_all = false;
        }
    }

    let cwd_ld = list_dir(".");
    if cwd_ld.is_ok() {
        for entry in cwd_ld.unwrap() {
            let en = string(entry);
            if en.starts_with("_test_") and is_dir(en) {
                println("error: leftover temporary test dir: " + en);
                ok_all = false;
            }
        }
    }
    if not ok_all {
        return 1;
    }
    println("all " + string(suites.len()) + " test suites passed.");
    return 0;
}

public fn cmd_clean(rest: list) -> int {
    let appdir = first_positional(rest);
    if appdir == "" {
        appdir = "workspace/demo";
    }
    let clean_dir = fs.trim_slash(appdir);
    let removed = 0;

    let bdir = fs.join_dir(clean_dir, "build");
    if is_dir(bdir) {
        dir_remove(bdir);
        println("removed " + bdir);
        removed += 1;
    }
    for flag in [
    ".studio-reload",
    ".studio-stop",
    fs.join_dir(clean_dir, ".studio-dev-done"),
    ] {
        if file_exists(flag) {
            remove_file(flag);
            removed += 1;
        }
    }

    let ld = list_dir(".");
    if ld.is_ok() {
        for item in ld.unwrap() {
            let n = string(item);
            if n.starts_with("_test_") and is_dir(n) {
                dir_remove(n);
                println("removed " + n);
                removed += 1;
            }
        }
    }

    if args_cli.has_flag(rest, "--cache") or args_cli.has_flag(rest, "--all") {
        let wcache = fs.join_dir(fs.downloads_dir(), "wasm-runtime");
        if is_dir(wcache) {
            dir_remove(wcache);
            println("removed " + wcache);
            removed += 1;
        }
    }

    println("clean finished (" + string(removed) + " items removed).");
    return 0;
}

public fn cmd_upgrade(appdir: string) -> int {
    if appdir == "" or not is_dir(appdir) {
        println("error: upgrade requires an existing app directory");
        return 2;
    }
    let clean_dir = fs.trim_slash(appdir);
    if not (
        file_exists(fs.join_dir(clean_dir, "app.matrix")) or file_exists(fs.join_dir(clean_dir, "studio.json"))
    ) {
        println("error: " + clean_dir + " does not look like an AppStudio app directory");
        return 2;
    }

    let root = fs.fw_root();
    let ld = list_dir(fs.join_dir(root, "frameworks/studio"));
    if ld.is_err() {
        println("error: cannot locate frameworks/studio/ runtime modules under " + root);
        return 1;
    }

    let vdir = fs.join_dir(clean_dir, "vendor/studio");
    fs.ensure_dir(fs.join_dir(clean_dir, "vendor"));
    fs.ensure_dir(vdir);

    let count = 0;
    for item in ld.unwrap() {
        let fname = string(item);
        if fname.ends_with(".matrix") {
            let cp = copy_file(
                fs.join_dir(root, "frameworks/studio/" + fname),
                fs.join_dir(vdir, fname)
            );
            if cp.is_err() {
                println("error: upgrading " + fname + " failed: " + string(cp.unwrap_err()));
                return 1;
            }
            count += 1;
        }
    }

    let tdir = fs.join_dir(clean_dir, "targets");
    fs.ensure_dir(tdir);
    let hcp = copy_file(
        fs.join_dir(root, "frameworks/targets/host.html"),
        fs.join_dir(tdir, "host.html")
    );
    if hcp.is_ok() {
        count += 1;
    }

    println("upgraded " + string(count) + " vendored runtime files in " + clean_dir);
    return 0;
}
