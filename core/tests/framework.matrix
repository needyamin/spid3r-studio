// tests/framework.matrix
// AppStudio framework unit tests — deterministic, no GUI/network needed.
// Run:  spid3r run tests/framework.matrix   (or: spid3r test tests/framework.matrix)

import "studio/Util" as U;
import "studio/Theme" as theme;
import "studio/State" as state;
import "studio/Storage" as storage;
import "studio/Router" as nav;
import "studio/Render" as render;
import "studio/Components" as ui;
import "studio/CSS" as css;
import "studio/Bridge" as br;
import "studio/ClientJS" as client;
import "studio/Http" as http;
import "studio/App" as appkit;
import "studio/Errors" as errors;
import "studio/Store" as store_mod;
import "studio/I18n" as i18n;
import "core/cli/Manifest" as man;
import "tools/FlatKit" as flatkit;

let passed = 0;
let failed = 0;
let tmp_base = "";

fn os_temp_base() -> string {
    for k in ["TMPDIR", "TEMP", "TMP"] {
        let ev = env(k);
        if string(ev) != "none" {
            let p = string(ev.unwrap()).replace("\\", "/");
            while p.len() > 1 and p.ends_with("/") {
                p = p.slice(0, p.len() - 1);
            }
            if p != "" and is_dir(p) {
                return p;
            }
        }
    }
    if is_dir("/tmp") {
        return "/tmp";
    }
    return ".";
}

fn read_via_store_iface(s, k: string) -> string {
    return string(store_mod.read_or(s, k, "missing"));
}

fn check_ok(cond: bool, name: string) {
    if cond {
        passed += 1;
    } else {
        failed += 1;
        println("FAIL: " + name);
    }
}

fn check_eq(a, b, name: string) {
    check_ok(string(a) == string(b), name + " (" + string(a) + " != " + string(b) + ")");
}

fn main() -> int {
    tmp_base = os_temp_base() + "/appstudio_test_fw";
    if is_dir(tmp_base) {
        dir_remove(tmp_base);
    }
    dir_create(tmp_base);

    // ---------- Util ----------
    check_eq(U.esc("<b>&"), "&lt;b&gt;&amp;", "util.esc");
    let m = {
        "a": 1
    };
    check_eq(U.prop(m, "a"), 1, "util.prop hit");
    check_eq(U.prop(m, "zz"), null, "util.prop miss");
    check_eq(U.s(m, "zz"), "", "util.s miss");
    check_eq(U.ival({
        "n": 7
    }, "n", 0), 7, "util.ival hit");
    check_eq(U.ival({
    }, "n", 5), 5, "util.ival default");

    // ---------- Theme ----------
    theme.mode("dark");
    check_eq(theme.token("mode"), "dark", "theme dark");
    check_ok(theme.token("bg") == "#0b0f1a", "theme dark bg");
    theme.mode("light");
    check_eq(theme.token("mode"), "light", "theme light back");
    theme.primary("#ff0000");
    check_eq(theme.token("primary"), "#ff0000", "theme.primary");
    theme.mode("light");

    // ---------- State ----------
    state.set("k", 41);
    check_eq(state.get("k"), 41, "state.set/get");
    check_eq(state.get_or("nope", "d"), "d", "state.get_or missing");
    state.set("listy", [1, 2]);
    check_eq(state.get_list("listy").len(), 2, "state.get_list");
    check_eq(state.get_list("nope").len(), 0, "state.get_list missing");
    state.set("n", 1);
    state.incr("n", 4);
    check_eq(state.get("n"), 5, "state.incr");
    state.update("n", x => int(x) * 3);
    check_eq(state.get("n"), 15, "state.update");
    state.drop("n");
    check_eq(state.get("n"), null, "state.drop");

    // ---------- Storage ----------
    let st_dir1 = tmp_base + "/storage1";
    storage.configure(st_dir1);
    storage.set("greeting", "hello");
    check_eq(storage.get("greeting"), "hello", "storage roundtrip");
    let reread = storage.get("greeting");
    check_eq(reread, "hello", "storage persisted string");
    storage.set("nums", [1, 2, 3]);
    check_eq(storage.get_list("nums").len(), 3, "storage list");
    storage.remove("greeting");
    check_eq(storage.get("greeting"), null, "storage remove");
    storage.set("m", {
        "x": 1
    });
    check_eq(storage.get_map("m")["x"], 1, "storage map");

    // ---------- Router ----------
    nav.configure_single("Home");
    check_eq(nav.page_name(), "Home", "router single root");
    check_eq(nav.depth(), 1, "router depth 1");
    nav.push("Detail", {
        "id": 7
    });
    check_eq(nav.page_name(), "Detail", "router push");
    check_eq(nav.depth(), 2, "router depth 2");
    check_eq(nav.params()["id"], 7, "router params");
    check_ok(nav.can_pop(), "router can_pop");
    nav.pop();
    check_eq(nav.page_name(), "Home", "router pop");
    nav.configure([{
        "label": "Home", "icon": "H"
    }, {
        "label": "Stats", "icon": "S"
    }
    ]);
    check_eq(nav.page_name(), "Home", "router tab root");
    nav.switch_tab(1);
    check_eq(nav.page_name(), "Stats", "router switch_tab");
    check_eq(nav.tab_index(), 1, "router tab_index");
    let snap = nav.snapshot();
    check_ok(snap.has("stacks") and snap.has("active"), "router snapshot keys");
    nav.restore(snap);
    check_eq(nav.page_name(), "Stats", "router restore");

    // ---------- Components + Render ----------
    let n = ui.page([ui.navbar("Title"), ui.text("hello <x>", "title"), ui.button("Tap", "do_thing"), ui.row([ui.text("a"), ui.text("b")], {
        "gap": 8
    }), ui.toggle(true, "flip"), ui.list([{
        "title": "one"
    }, {
        "title": "two"
    }
    ]), ui.badge("3 / 4", "primary"),]);
    let html = render.document(n, [], 0);
    check_ok(html.contains("data-pagekey=\"\"") == false, "render omits empty pagekey");
    check_ok(html.contains("&lt;x&gt;"), "render escapes text");
    check_ok(html.contains("data-tap=\"do_thing\""), "render named handler slot");
    check_ok(html.contains("btn primary"), "render button variant");
    check_ok(html.contains("style=\"gap:8px;\""), "render layout style");
    check_ok(html.contains("toggle on"), "render toggle on");
    check_ok(html.contains("tile-title"), "render default list tiles");
    check_ok(html.contains("badge primary"), "render badge");

    // handlers as closures get slots
    let n2 = ui.button("C", (_ev) => {
        let _x = 1;
    });
    let h2 = render.node_html(n2);
    check_ok(
        h2.contains("data-tap=\"f1\"") or h2.contains("data-tap=\"f"),
        "render closure slot"
    );

    // tab bar chrome appears when tabs configured + at root
    nav.configure([{
        "label": "A", "icon": "X"
    }, {
        "label": "B"
    }
    ]);
    let html3 = render.document(
        ui.page([ui.text("x")]),
        nav.tabs(),
        nav.tab_index()
    );
    check_ok(html3.contains("tabbar"), "render tabbar chrome");
    nav.push("B");
    let html4 = render.document(
        ui.page([ui.text("x")]),
        nav.tabs(),
        nav.tab_index()
    );
    check_ok(not html4.contains("tabbar"), "no tabbar on pushed page");
    nav.pop();

    // ---------- FlatKit ----------
    let flat = flatkit.bundle("workspace/demo");
    check_ok(flat != "", "flatkit bundles the demo");
    check_ok(not flat.contains("import \""), "flatkit strips imports");
    check_ok(flat.contains("pub_Components_page"), "flatkit prefixes framework fns");
    check_ok(flat.contains("fn studio_app()"), "flatkit keeps author fns");
    check_ok(flat.contains("app.wasm_run("), "flatkit keeps unprefixed App method calls");
    check_ok(
        flat.contains("\"params\": params"),
        "flatkit preserves default-arg param shadowing"
    );
    check_ok(flat.contains("fn main()"), "flatkit appends driver main");
    // flattened source must be syntactically valid
    let chk = check_source_snippet(flat);
    check_ok(chk, "flatkit output parses");

    // ---------- Phase 1 Security & Protocol ----------
    // 1. safe_url
    check_eq(
        U.safe_url("https://example.com/a.png"),
        "https://example.com/a.png",
        "safe_url allows https"
    );
    check_eq(
        U.safe_url("http://localhost:8080/x"),
        "http://localhost:8080/x",
        "safe_url allows http"
    );
    check_eq(
        U.safe_url("data:image/png;base64,AA=="),
        "data:image/png;base64,AA==",
        "safe_url allows raster data"
    );
    check_eq(U.safe_url("/assets/img.png"), "/assets/img.png", "safe_url allows rooted path");
    check_eq(U.safe_url("assets/logo.png"), "assets/logo.png", "safe_url allows rel path");
    check_eq(U.safe_url("javascript:alert(1)"), "", "safe_url blocks javascript");
    check_eq(U.safe_url("  JaVaScRiPt:void(0)"), "", "safe_url blocks obfuscated javascript");
    check_eq(
        U.safe_url("data:text/html,<script>1</script>"),
        "",
        "safe_url blocks data:text/html"
    );
    check_eq(U.safe_url("data:image/svg+xml,<svg/>"), "", "safe_url blocks svg data");
    check_eq(U.safe_url("//evil.example/x.png"), "", "safe_url blocks protocol-relative");

    // 2. esc_icon
    check_eq(U.esc_icon("&#128465;"), "&#128465;", "esc_icon preserves decimal entity");
    check_eq(U.esc_icon("&#x1F600;"), "&#x1F600;", "esc_icon preserves hex entity");
    check_eq(
        U.esc_icon("<img src=x onerror=1>"),
        "&lt;img src=x onerror=1&gt;",
        "esc_icon escapes html"
    );
    check_eq(
        U.esc_icon("&#9989;<script>x</script>"),
        "&#9989;&lt;script&gt;x&lt;/script&gt;",
        "esc_icon escapes mixed tag"
    );

    // 3. esc_css_val & CSS token sanitization
    check_eq(U.esc_css_val("#4f46e5"), "#4f46e5", "esc_css_val preserves hex");
    check_ok(
        not U.esc_css_val("#000;}body{display:none}").contains("}"),
        "esc_css_val strips braces"
    );
    check_eq(U.esc_css_val("expression(alert(1))"), "", "esc_css_val blocks expression");
    theme.primary("#000;}body{color:red}<style>");
    let st_css = css.stylesheet();
    check_ok(
        not st_css.contains("<style>") and not st_css.contains("body{color:red}"),
        "css.stylesheet sanitizes tokens"
    );
    theme.primary("#4f46e5");

    // 4. Render escaping
    let ib_html = render.node_html(ui.iconbutton("<script>x</script>", "a"));
    check_ok(not ib_html.contains("<script>"), "render iconbutton escapes html");
    let fab_html = render.node_html(ui.fab("<img onerror=1>", "a"));
    check_ok(not fab_html.contains("<img"), "render fab escapes html");
    let sl_html = render.node_html(ui.node("slider", {
        "min": "0\" onload=\"x", "max": "10", "value": "5", "onInput": "s"
    }, []));
    check_ok(sl_html.contains("0&quot; onload=&quot;x"), "render slider escapes attrs");
    let bad_img = render.node_html(ui.image("javascript:alert(1)"));
    check_ok(bad_img.contains("src=\"\""), "render image blocks javascript url");
    let bad_av = render.node_html(ui.avatar("javascript:alert(1)", "AB"));
    check_ok(
        not bad_av.contains("javascript:") and bad_av.contains(">AB<"),
        "render avatar falls back safely"
    );

    // 5. Theme snapshot / restore
    theme.mode("dark");
    theme.primary("#123456");
    let ts = theme.snapshot();
    theme.mode("light");
    theme.primary("#ffffff");
    theme.restore(ts);
    check_eq(theme.token("mode"), "dark", "theme.restore mode");
    check_eq(theme.token("primary"), "#123456", "theme.restore primary");
    theme.mode("light");
    theme.primary("#4f46e5");

    // 6. Storage cache reset, atomic save, memory-only mode
    let st_dir2 = tmp_base + "/storage2";
    let st_empty = tmp_base + "/storage_empty";
    let st_mem = tmp_base + "/storage_mem_should_not_exist";
    storage.configure(st_dir2);
    storage.set("persist_k", "v1");
    check_eq(storage.last_err(), "", "storage atomic save no error");
    storage.configure(st_empty);
    check_eq(storage.get("persist_k"), null, "storage configure resets stale cache");
    storage.set_memory_only(true);
    storage.configure(st_mem);
    storage.set("mem_k", 99);
    check_eq(storage.get("mem_k"), 99, "storage memory-only works");
    check_ok(not is_dir(st_mem), "storage memory-only skips disk");
    storage.set_memory_only(false);

    // 7. Error boundary in Bridge & App
    let rendered_err = "";
    br.install((t) => {
        let _ = t;
    }, (h) => {
        rendered_err = h;
    }, (js) => {
        let _ = js;
    }, (n, cb) => {
        let _ = n; let _c = cb;
    }, (n, p) => {
        let _ = n; let _p = p;
    });
    let err_app = appkit.App("ErrApp", "sh.test.err", "1.0.0")
    .page("Home", () => {
        let m = {
        };
        return ui.page([ui.text(string(m["boom"]))]);
    })
    .handler("throw_h", (_ev) => {
        let m = {
        };
        let _z = m["kaboom"];
    });
    err_app.prepare(true);
    br.dispatch_and_render({
        "sid": "throw_h"
    }, err_app);
    check_ok(
        rendered_err.contains("Handler error") and rendered_err.contains("throw_h"),
        "bridge catches handler exception"
    );
    err_app.render();
    check_ok(
        rendered_err.contains("Page &#39;Home&#39; failed") or rendered_err.contains("Page 'Home' failed"),
        "app catches page render exception"
    );

    // Cleanup test directories
    dir_remove(st_dir1);
    dir_remove(st_dir2);
    dir_remove(st_empty);

    // ---------- Phase 2 Core Framework Fixes ----------
    // 1. Util.fval & ival safety
    check_eq(U.fval({
        "f": 0.75
    }, "f", 0.0), 0.75, "util.fval float");
    check_eq(U.fval({
        "i": 1
    }, "i", 0.0), 1.0, "util.fval int");
    check_eq(U.fval({
        "bad": "abc"
    }, "bad", 0.25), 0.25, "util.fval fallback");
    check_eq(U.ival({
        "bad": "xyz"
    }, "bad", 7), 7, "util.ival fallback");

    // 2. ui.progress float + clamping & ui.column CSS class
    let p50 = render.node_html(ui.progress(0.5));
    check_ok(p50.contains("width:50%"), "progress 0.5 renders 50%");
    let p33 = render.node_html(ui.progress(0.333));
    check_ok(p33.contains("width:33%"), "progress 0.333 renders 33%");
    let p_lo = render.node_html(ui.progress(-0.2));
    check_ok(p_lo.contains("width:0%"), "progress clamps negative to 0%");
    let p_hi = render.node_html(ui.progress(1.5));
    check_ok(p_hi.contains("width:100%"), "progress clamps >1 to 100%");

    let col_html = render.node_html(ui.column([ui.text("a")], {
        "gap": 12
    }));
    check_ok(
        col_html.contains("class=\"column\"") and col_html.contains("gap:12px;"),
        "column class + gap"
    );
    check_ok(
        css.stylesheet().contains(".col,.column{"),
        "css styles .column alongside .col"
    );

    // 3. Renderer & Layout fixes
    let txt_default = render.node_html(ui.text("hello"));
    check_ok(
        txt_default.contains("class=\"body\"") and not txt_default.contains("body body"),
        "text_html no duplicate body class"
    );
    let list_notitle = render.node_html(ui.list([{
        "subtitle": "sub only"
    }
    ]));
    check_ok(
        list_notitle.contains("tile-sub") and list_notitle.contains("sub only"),
        "list_html handles missing title"
    );
    let tab_noact = render.node_html(ui.node("tabbar", {
        "tabs": ["A", "B"]
    }, []));
    check_ok(tab_noact.contains("tab active"), "tabbar handles missing active");
    check_ok(
        render.node_html(ui.spacer(0)).contains("spacer grow"),
        "spacer(0) expands as grow"
    );
    check_ok(
        render.node_html(ui.flex_spacer()).contains("spacer grow"),
        "flex_spacer expands as grow"
    );
    let sp12 = render.node_html(ui.spacer(12));
    check_ok(sp12.contains("width:12px;height:12px;"), "spacer(12) sets width and height");
    let row_dim = render.node_html(ui.row([], {
        "width": "100%", "height": 40
    }));
    check_ok(row_dim.contains("width:100%;height:40px;"), "style_of supports string units");
    let nav_pg = render.node_html(ui.page([ui.navbar("Top"), ui.text("Body")]));
    check_ok(
        nav_pg.starts_with("<div class=\"navbar\"") and nav_pg.contains("page has-nav"),
        "navbar hoisted out of .page"
    );
    let sheet_h = render.node_html(ui.sheet([ui.text("Inside")], {
        "onDismiss": "close"
    }));
    check_ok(
        sheet_h.contains("data-stop-tap=\"1\"") and sheet_h.contains("data-tap=\"close\""),
        "sheet interior stops tap bubbling"
    );
    let tog_off = render.node_html(ui.toggle(false, "flip"));
    check_ok(
        tog_off.contains("data-arg=\"1\"") and tog_off.contains("data-val=\"true\""),
        "toggle emits arg and val"
    );
    let multi_ev = render.node_html(ui.node("input", {
        "placeholder": "p", "onInput": "i", "onChange": "c", "onSubmit": "s", "arg": "k"
    }, []));
    check_ok(
        multi_ev.contains("data-input=\"i\"") and multi_ev.contains("data-change=\"c\"") and multi_ev.contains("data-submit=\"s\"") and multi_ev.contains("data-arg=\"k\""),
        "input supports input/change/submit + single arg"
    );
    let css_s = css.stylesheet();
    check_ok(
        css_s.contains(".page.has-nav") and css_s.contains(".page.page-enter") and css_s.contains(".navbar{flex:none;"),
        "css has nav/enter/navbar flex rules"
    );

    // 4. State.drop, Storage.remove & module reset()
    state.reset();
    state.set("x", 10);
    state.drop("x");
    check_eq(state.get_or("x", 5), 5, "state.drop deletes key so get_or returns default");
    check_eq(state.get("x"), null, "state.drop makes get return null");
    state.reset();
    check_eq(state.get("k"), null, "state.reset clears keys");

    let st_p2 = tmp_base + "/storage_p2";
    storage.configure(st_p2);
    storage.set("skey", "v");
    storage.remove("skey");
    check_eq(storage.get("skey", "fallback"), "fallback", "storage.remove deletes key");
    storage.load();
    check_eq(
        storage.get("skey", "fallback"),
        "fallback",
        "storage.remove persisted deletion"
    );
    storage.reset();
    check_eq(storage.all().keys().len(), 0, "storage.reset clears cache");
    dir_remove(st_p2);

    // 5. Router edge cases & reset()
    nav.reset();
    check_eq(nav.page_name(), "", "empty router page_name");
    check_eq(nav.depth(), 0, "empty router depth");
    check_ok(not nav.can_pop(), "empty router cannot pop");
    nav.configure_single("Login");
    nav.replace("Dash", {
        "ok": 1
    });
    check_eq(nav.depth(), 1, "router.replace at depth 1 keeps depth 1");
    check_ok(not nav.can_pop(), "router.replace at depth 1 leaves no back button");
    check_eq(nav.page_name(), "Dash", "router.replace updates page");
    check_eq(nav.params()["ok"], 1, "router.replace updates params");
    nav.reset();

    // 6. Theme custom nested flattening + mode override preservation
    theme.reset();
    theme.custom({
        "colors": {
            "primary": "#112233"
        }
        , "radius": "8"
    });
    check_eq(theme.token("primary"), "#112233", "theme.custom nested map flattening");
    theme.mode("dark");
    check_eq(theme.token("mode"), "dark", "theme.mode switches to dark");
    check_eq(theme.token("primary"), "#112233", "theme.mode preserves custom primary");
    check_eq(theme.token("radius"), "8", "theme.mode preserves custom radius");
    theme.reset();
    check_eq(theme.token("mode"), "light", "theme.reset restores light");
    check_eq(theme.token("primary"), "#4f46e5", "theme.reset restores default primary");

    // 7. Bridge.has_named, dispatch_safe, reset
    br.reset();
    br.named_handler("ok_h", (_ev) => {
    });
    br.named_handler("bad_h", (_ev) => {
        let m = {
        };
        let _x = m["boom"];
    });
    check_ok(br.has_named("ok_h") and not br.has_named("missing_h"), "bridge.has_named");
    check_eq(br.dispatch_safe({
        "sid": "ok_h"
    }), "", "bridge.dispatch_safe ok");
    check_ok(br.dispatch_safe({
        "sid": "bad_h"
    }).contains("bad_h:"), "bridge.dispatch_safe catches error");
    br.reset();

    // ---------- Phase 3 & 4 FlatKit Multi-File, Lexer & Isolation ----------
    let flat_win = flatkit.bundle("workspace\\demo");
    check_ok(
        flat_win != "" and flat_win.contains("fn studio_app()"),
        "flatkit handles Windows backslash path"
    );
    check_ok(check_source_snippet(flat_win), "flatkit backslash bundle passes spid3r check");

    let mf_dir = tmp_base + "/storage_mf";
    dir_create(mf_dir);
    dir_create(mf_dir + "/pages");
    let sub_src = r#"import "../studio/Components" as ui;
import "../studio/State" as state;
public fn SubPage() -> map {
    return ui.page([ui.text("Sub n={state.get_or("n", 7)}")]);
}
"#

    ;
    let main_mf = "// fn fake_doc_fn()\nimport \"studio/App\" as appkit;\nimport \"studio/Components\" as ui;\nimport \"studio/Http\" as http;\nimport \"pages/Sub\" as sub;\nlet cache = 42;\nlet dir = \"user_dir\";\nclass Runner {\n    public fn run(self) -> string { return \"runner_ok\"; }\n}\nfn Home() -> map {\n    let r = Runner();\n    let _fn_ref = http.get;\n    let msg = \"Click to import items; fn dummy()\";\n    return ui.page([ui.text(msg + \":\" + r.run() + \":\" + string(cache) + \":\" + dir)]);\n}\npublic fn studio_app() {\n    return appkit.App(\"MF\", \"sh.test.mf\", \"1.0.0\").page(\"Home\", Home).page(\"Sub\", sub.SubPage);\n}\n";
    write_file(mf_dir + "/pages/Sub.matrix", sub_src);
    write_file(mf_dir + "/app.matrix", main_mf);
    let mf_flat = flatkit.bundle(mf_dir);
    check_ok(mf_flat != "", "flatkit bundles multi-file app with Http");
    check_ok(mf_flat.contains("// fn fake_doc_fn()"), "flatkit preserves comments verbatim");
    check_ok(
        mf_flat.contains("\"Click to import items; fn dummy()\""),
        "flatkit preserves strings with import/fn"
    );
    check_ok(mf_flat.contains("r.run()"), "flatkit keeps non-App .run() untouched");
    check_ok(
        mf_flat.contains("mod_u_app_cache") and mf_flat.contains("mod_Storage_cache"),
        "flatkit prefixes colliding globals per module"
    );
    check_ok(mf_flat.contains("pub_Http_get"), "flatkit bundles Http module");
    check_ok(
        mf_flat.contains("pub_u_pages_Sub_SubPage"),
        "flatkit bundles pages/Sub submodule"
    );
    check_ok(
        mf_flat.contains("pub_State_get_or"),
        "flatkit rewrites expressions inside string interpolation"
    );
    check_ok(check_source_snippet(mf_flat), "multi-file flatkit output passes spid3r check");
    dir_remove(mf_dir);

    // ---------- Phase 5: Morph, Theme Version, Host Effects & Async Http ----------
    theme.reset();
    let tv0 = theme.version();
    theme.mode("dark");
    check_ok(theme.version() > tv0, "theme.mode bumps version");
    let tv1 = theme.version();
    theme.primary("#00aaff");
    check_ok(theme.version() > tv1, "theme.primary bumps version");
    theme.set_version(42);
    check_eq(theme.version(), 42, "theme.set_version restores revision");
    theme.set_version(0);
    check_eq(theme.version(), 42, "theme.set_version ignores non-positive");
    theme.reset();
    check_ok(theme.version() > 42, "theme.reset advances version");

    br.reset();
    check_eq(br.platform(), "native", "bridge default platform is native");
    br.set_host_caps({
        "platform": "android", "prefers_dark": true, "viewport_width": 412
    });
    check_eq(br.platform(), "android", "bridge caps platform");
    check_ok(br.prefers_dark(), "bridge caps prefers_dark");
    check_eq(br.caps()["viewport_width"], 412, "bridge caps viewport_width");
    br.copy_text("hello");
    check_ok(br.open_url("https://example.com"), "bridge open_url allows https");
    check_ok(not br.open_url("javascript:alert(1)"), "bridge open_url rejects javascript:");
    br.haptic("medium");
    let efs = br.drain_effects();
    check_eq(efs.len(), 3, "bridge drains 3 effects");
    check_eq(efs[0]["kind"], "clipboard.copy", "effect 0 clipboard.copy");
    check_eq(efs[1]["kind"], "open_url", "effect 1 open_url");
    check_eq(efs[2]["kind"], "haptic", "effect 2 haptic");
    check_eq(br.drain_effects().len(), 0, "drain_effects clears queue");

    br.set_host_caps({
        "platform": "web"
    });
    check_ok(
        not http.get_async("javascript:alert(1)", "on_resp"),
        "http.get_async rejects javascript:"
    );
    check_eq(br.drain_effects().len(), 0, "rejected async http enqueues no effect");
    check_ok(
        http.get_async("https://api.example.com/items", "on_resp"),
        "http.get_async accepts https"
    );
    check_ok(http.post_json_async("/api/save", {
        "x": 1
    }, "on_post"), "http.post_json_async accepts relative path");
    let hefs = br.drain_effects();
    check_eq(hefs.len(), 2, "http async enqueues 2 effects on web");
    check_eq(hefs[0]["kind"], "http", "http effect kind");
    check_eq(hefs[0]["method"], "GET", "http effect GET");
    check_eq(hefs[0]["cb"], "on_resp", "http effect callback sid");
    check_eq(hefs[1]["method"], "POST", "http effect POST");

    let keyed = render.node_html(ui.row([ui.card([ui.text("Item")], {
        "key": "k-1"
    })]));
    check_ok(keyed.contains("data-key=\"k-1\""), "render emits data-key attribute");
    let keyed_list = render.node_html(ui.list([{
        "title": "Alpha", "key": "row-a"
    }
    ]));
    check_ok(keyed_list.contains("data-key=\"row-a\""), "list_html forwards data-key");

    let cjs = client.runtime_js();
    check_ok(
        cjs.contains("patch:") and cjs.contains("morphNode") and cjs.contains("runEffects"),
        "ClientJS exposes morph and runEffects"
    );
    check_ok(
        cjs.contains("'submit'") and cjs.contains("role") and cjs.contains("SELECT"),
        "ClientJS handles form submit, switch keyboard, and select/checkbox morphing"
    );

    // ---------- Phase 6 Task 6.1: UI Primitives, Disabled & ARIA ----------
    let cb_html = render.node_html(ui.checkbox(true, "on_chk", "Accept terms"));
    check_ok(
        cb_html.contains("type=\"checkbox\"") and cb_html.contains("checked") and cb_html.contains("aria-checked=\"true\""),
        "checkbox renders checked + aria-checked"
    );

    let sel_html = render.node_html(ui.picker([{
        "value": "hi", "label": "High"
    }, "low"], "hi", "on_sel"));
    check_ok(
        sel_html.contains("<select") and sel_html.contains("value=\"hi\" selected") and sel_html.contains(">High</option>"),
        "select/picker renders selected option"
    );

    let seg_html = render.node_html(ui.segmented(["All", "Open"], 1, "on_seg"));
    check_ok(
        seg_html.contains("role=\"tablist\"") and seg_html.contains("seg-btn active") and seg_html.contains("aria-selected=\"true\""),
        "segmented control renders active tab + ARIA"
    );

    let sp_html = render.node_html(ui.spinner(20, "Saving"));
    check_ok(
        sp_html.contains("role=\"status\"") and sp_html.contains("aria-label=\"Saving\""),
        "spinner renders status role and aria-label"
    );

    let dlg_html = render.node_html(
        ui.confirm("Delete?", "Confirm action", "do_yes", "do_no")
    );
    check_ok(
        dlg_html.contains("role=\"dialog\"") and dlg_html.contains("aria-modal=\"true\"") and dlg_html.contains("data-stop-tap=\"1\""),
        "confirm dialog renders modal ARIA + stop-tap"
    );

    let tst_html = render.node_html(ui.toast("Saved!", "success", "dismiss_t"));
    check_ok(
        tst_html.contains("toast success") and tst_html.contains("aria-live=\"polite\""),
        "toast renders variant + polite live region"
    );

    let grd_html = render.node_html(ui.grid([ui.text("A"), ui.text("B")], 3, 12));
    check_ok(
        grd_html.contains("grid-template-columns:repeat(3,minmax(0,1fr))"),
        "grid renders column template style"
    );

    let chip_html = render.node_html(ui.chip("Urgent", "on_chip", true));
    check_ok(
        chip_html.contains("chip selected") and chip_html.contains("aria-pressed=\"true\""),
        "chip renders selected + aria-pressed"
    );

    let frm_html = render.node_html(ui.form([ui.input("Name", "on_in")], "on_sub"));
    check_ok(
        frm_html.contains("<form") and frm_html.contains("data-submit=\"on_sub\""),
        "form renders submit attribute"
    );

    let dis_btn = render.node_html(ui.button("Locked", "do_lock", "primary", {
        "disabled": true
    }));
    check_ok(
        dis_btn.contains("disabled") and dis_btn.contains("aria-disabled=\"true\"") and not dis_btn.contains("data-tap"),
        "disabled button omits data-tap and sets disabled + aria-disabled"
    );

    nav.configure([{
        "label": "One"
    }, {
        "label": "Two"
    }
    ]);
    let a11y_tree = render.document(
        ui.page(
            [ui.navbar("Dash"),
            ui.progress(0.5),
            ui.toggle(false, "do_t")]
        ),
        nav.tabs(),
        nav.tab_index()
    );
    check_ok(
        a11y_tree.contains("role=\"banner\"") and a11y_tree.contains("aria-valuenow=\"50\"") and a11y_tree.contains("role=\"switch\"") and a11y_tree.contains("role=\"tablist\""),
        "render emits baseline ARIA roles on navbar, progress, toggle, tabbar"
    );
    nav.reset();

    let css_p6 = css.stylesheet();
    check_ok(
        css_p6.contains(":focus-visible") and css_p6.contains("prefers-reduced-motion") and css_p6.contains(".dialog") and css_p6.contains(".toast"),
        "CSS includes focus-visible, reduced-motion, dialog, and toast styles"
    );

    theme.reset();
    theme.restore({
        "mode": "dark", "primary": "#10b981"
    });
    check_eq(theme.token("mode"), "dark", "theme.restore partial applies dark mode");
    check_eq(theme.token("bg"), "#0b0f1a", "theme.restore partial applies dark scheme bg");
    check_eq(
        theme.token("primary"),
        "#10b981",
        "theme.restore partial applies custom primary"
    );

    theme.reset();
    br.reset();

    // 8. Native GUI 2-arg event bridge, JSON stringified payload, and on-demand __studio_tick__ poll
    let js_rt = client.runtime_js();
    check_ok(
        js_rt.contains("JSON.stringify(payload)") and js_rt.contains("setPoll: setPoll"),
        "ClientJS runtime_js stringifies payload objects and exposes setPoll"
    );

    let mock_cbs = {
    };
    let mock_evals = [];
    br.install((t) => {
        let _ = t;
    }, (h) => {
        mock_evals.push(h);
    }, (js) => {
        mock_evals.push(js);
    }, (n, cb) => {
        mock_cbs[n] = cb;
    }, (n, p) => {
        let _ = n; let _p = p;
    });
    state.reset();
    state.set("click_cnt", 0);
    let ready_ran = false;
    let gui_app = appkit.App("ClickTest", "sh.test.click", "1.0.0")
    .page("Home", () => {
        return ui.page(
            [
            ui.text("Count:" + string(state.get_or("click_cnt", 0))),
            ui.button("Bump", "bump")
            ]
        );
    })
    .handler("bump", (_ev) => {
        state.set("click_cnt", int(state.get_or("click_cnt", 0)) + 1);
    })
    .on_ready(() => {
        ready_ran = true;
        appkit.set_bg_busy(true);
    });
    let run_rc = gui_app.run();
    check_eq(run_rc, 0, "App.run returns 0 immediately without blocking");
    check_ok(
        mock_cbs.has("ui") and mock_cbs.has("ready"),
        "App.run subscribes to ui and ready bridge channels"
    );

    let cb_ready = mock_cbs["ready"];
    cb_ready("ready", "");
    check_ok(ready_ran, "2-arg ready callback invokes App.on_ready");
    let saw_poll_on = false;
    for item in mock_evals {
        if string(item).contains("setPoll(true,140)") {
            saw_poll_on = true;
        }
    }
    check_ok(saw_poll_on, "on_ready enables native poll when bg_busy is true");

    mock_evals = [];
    let cb_ui = mock_cbs["ui"];
    cb_ui("ui", "{\"sid\":\"bump\",\"kind\":\"tap\",\"value\":null,\"arg\":null}");
    check_eq(
        state.get("click_cnt"),
        1,
        "2-arg ui handler dispatches JSON string payload to button handler"
    );
    let saw_count1 = false;
    for item in mock_evals {
        if string(item).contains("Count:1") {
            saw_count1 = true;
        }
    }
    check_ok(saw_count1, "2-arg ui click re-renders updated state");

    mock_evals = [];
    appkit.set_bg_busy(false);
    appkit.request_render();
    state.set("click_cnt", 2);
    cb_ui("ui", "{\"sid\":\"__studio_tick__\",\"kind\":\"tick\",\"value\":\"\",\"arg\":\"\"}");
    let saw_count2 = false;
    let saw_poll_off = false;
    for item in mock_evals {
        let si = string(item);
        if si.contains("Count:2") {
            saw_count2 = true;
        }
        if si.contains("setPoll(false,140)") {
            saw_poll_off = true;
        }
    }
    check_ok(
        saw_count2 and saw_poll_off,
        "__studio_tick__ flushes dirty_render and disables poll when idle"
    );

    // 9. A-07 defensive copies, A-44 storage .bak + corrupt guard, A-28 re-entrant render queue
    state.reset();
    state.set("items", ["a", "b"]);
    let copy_l = state.get_list("items");
    copy_l.push("mutated");
    check_eq(
        state.get_list("items").len(),
        2,
        "A-07 State.get_list returns defensive copy"
    );
    state.set("nested", {
        "inner": {
            "v": 1
        }
    });
    let nested_copy = state.get_map("nested");
    nested_copy["inner"]["v"] = 999;
    check_eq(
        state.get_map("nested")["inner"]["v"],
        1,
        "A-07 State.get_map returns deep defensive copy"
    );

    storage.set_memory_only(false);
    let bak_dir = tmp_base + "/storage_bak";
    storage.configure(bak_dir);
    storage.set("v", 1);
    storage.set("v", 2);
    check_ok(file_exists(bak_dir + "/kv.json.bak"), "A-44 Storage.save writes kv.json.bak");
    let sv_before = storage.version();
    storage.set("v", 3);
    check_ok(storage.version() > sv_before, "A-03 Storage.version increments on set");
    storage.set("bag", [1, 2]);
    let raw_bag = storage.get("bag");
    raw_bag.push(3);
    check_eq(
        storage.get_list("bag").len(),
        2,
        "A-07 Storage.get returns deep defensive copy"
    );
    let all_copy = storage.all();
    all_copy["injected"] = 999;
    check_eq(storage.get("injected", null), null, "A-07 Storage.all returns defensive copy");
    write_file(bak_dir + "/kv.json", "{not valid json");
    storage.load();
    check_ok(storage.last_err() != "", "A-44 Storage.load surfaces parse error on corrupt file");
    check_ok(not storage.save(), "A-44 Storage.save refuses to silently overwrite corrupt file");
    let err_once = storage.last_err();
    check_ok(not storage.save(), "A-44 repeated Storage.save keeps corruption lock");
    check_eq(
        storage.last_err(),
        err_once,
        "A-44 repeated Storage.save does not duplicate error prefix"
    );
    storage.reset();
    check_eq(storage.last_err(), "", "A-44 Storage.reset clears corruption lock");
    dir_remove(bak_dir);

    let re_renders = 0;
    let re_app = null;
    re_app = appkit.App("ReEntrant", "sh.test.re", "1.0.0").page("Home", () => {
        re_renders += 1;
        if re_renders == 1 {
            re_app.render();
        }
        return ui.page([ui.text("pass=" + string(re_renders))]);
    });
    re_app.prepare(true);
    re_app.render();
    check_eq(
        re_renders,
        2,
        "A-28 re-entrant App.render queues follow-up pass instead of dropping frame"
    );

    // ---------- H2a OOP: AppError (A-27), Store interface, MemoryStore, FileStore, Container ----------
    let ae = errors.make("E_NET", "Request timed out", "upstream", true);
    check_eq(
        ae.format(),
        "[E_NET] Request timed out (cause: upstream)",
        "A-27 AppError.format"
    );
    let aem = ae.to_map();
    check_ok(
        aem["code"] == "E_NET" and aem["retryable"] == true,
        "A-27 AppError.to_map"
    );
    let res_ok = errors.ok_result(123);
    let res_err = errors.err_result(ae);
    check_ok(
        errors.is_ok_result(res_ok) and not errors.is_ok_result(res_err),
        "A-27 Result helpers"
    );

    let ms = store_mod.MemoryStore();
    ms.set("items", [1, 2]);
    let ms_copy = ms.get("items", []);
    ms_copy.push(99);
    check_eq(ms.get("items", []).len(), 2, "H2a MemoryStore isolates defensive copies");
    check_eq(
        read_via_store_iface(ms, "items").len() > 0,
        true,
        "H2a MemoryStore satisfies Store interface polymorphically"
    );
    ms.set("a", "alpha");
    check_eq(read_via_store_iface(ms, "a"), "alpha", "H2a Store interface read");
    let v_before = ms.version();
    ms.remove("a");
    check_ok(
        ms.version() > v_before and ms.get("a", "none") == "none",
        "H2a MemoryStore remove bumps version"
    );

    let fs_dir = tmp_base + "/filestore";
    let fs_store = store_mod.FileStore(fs_dir);
    fs_store.set("k1", "v1");
    fs_store.set("k1", "v2");
    check_ok(file_exists(fs_dir + "/kv.json.bak"), "H2a FileStore maintains .bak backup");
    check_eq(read_via_store_iface(fs_store, "k1"), "v2", "H2a FileStore implements Store");
    dir_remove(fs_dir);

    let ctr = store_mod.Container();
    let transient_n = 0;
    ctr.bind("store", (_c) => store_mod.MemoryStore(), "singleton");
    ctr.bind("tick", (_c) => {
        transient_n += 1;
        return transient_n;
    }, "transient");
    let s1 = ctr.resolve("store");
    s1.set("shared", "yes");
    let s2 = ctr.resolve("store");
    check_eq(s2.get("shared", ""), "yes", "H2a Container singleton reuses instance");
    check_eq(ctr.resolve("tick"), 1, "H2a Container transient call 1");
    check_eq(ctr.resolve("tick"), 2, "H2a Container transient call 2");

    // ---------- A-08: ui.component / ui.memo with keyed identity & slot-safe memoization ----------
    render.clear_component_cache();
    let comp_runs = 0;
    let badge_comp = (props) => {
        comp_runs += 1;
        return ui.card([ui.text("Item: " + string(props["label"]))]);
    };
    let c_html1 = render.node_html(ui.memo("BadgeCard", {
        "label": "one"
    }, badge_comp, "badge-1"));
    let c_html2 = render.node_html(ui.memo("BadgeCard", {
        "label": "one"
    }, badge_comp, "badge-1"));
    check_ok(
        c_html1.contains("data-key=\"badge-1\"") and c_html1 == c_html2,
        "A-08 ui.memo attaches data-key and returns cached HTML"
    );
    check_eq(comp_runs, 1, "A-08 ui.memo skips re-render when props unchanged");
    check_eq(render.component_cache_stats()["hits"], 1, "A-08 memo hit counter incremented");
    let c_html3 = render.node_html(ui.memo("BadgeCard", {
        "label": "two"
    }, badge_comp, "badge-1"));
    check_ok(
        c_html3.contains("Item: two") and comp_runs == 2,
        "A-08 ui.memo invalidates on prop change"
    );

    // Ephemeral closure slot inside ui.component must NOT be served from stale cache
    let slot_runs = 0;
    let btn_comp = (props) => {
        slot_runs += 1;
        return ui.button(string(props["label"]), (_ev) => {
        });
    };
    br.clear_slots();
    let s_h1 = render.node_html(ui.memo("BtnComp", {
        "label": "Tap"
    }, btn_comp, "btn-1"));
    br.clear_slots();
    let s_h2 = render.node_html(ui.memo("BtnComp", {
        "label": "Tap"
    }, btn_comp, "btn-1"));
    check_eq(
        slot_runs,
        2,
        "A-08 ui.memo bypasses cache when component emits ephemeral closure slots"
    );
    check_ok(s_h1 != s_h2, "A-08 closure component gets fresh epoch slot id on next render");
    render.clear_component_cache();

    // ---------- A-32: App.on_error opt-in crash hook ----------
    let caught_codes = [];
    let caught_msgs = [];
    let hook_app = appkit.App("HookApp", "sh.test.hook", "1.0.0")
    .on_error((err) => {
        caught_codes.push(err.code);
        caught_msgs.push(err.message);
    })
    .page("Home", () => {
        let m = {
        };
        return ui.page([ui.text(string(m["missing_key"]))]);
    });
    hook_app.prepare(true);
    hook_app.render();
    check_eq(caught_codes.len(), 1, "A-32 App.on_error invoked on page render failure");
    check_eq(
        caught_codes[0],
        "E_PAGE_RENDER",
        "A-32 App.on_error receives structured AppError code"
    );

    // ---------- A-40: WASM Http.request_async rejects closures & persists req_id in State ----------
    state.reset();
    br.set_host_caps({
        "platform": "web"
    });
    br.drain_effects();
    check_ok(not http.get_async("https://api.example.com/a", (_ev) => {
    }), "A-40 WASM Http.get_async rejects ephemeral closure callback");
    check_eq(br.drain_effects().len(), 0, "A-40 rejected closure enqueues no effect");
    check_ok(
        http.get_async("https://api.example.com/a", "on_a"),
        "A-40 WASM Http.get_async accepts named handler"
    );
    check_ok(
        http.get_async("https://api.example.com/b", "on_b"),
        "A-40 WASM Http.get_async second call"
    );
    let seq_efs = br.drain_effects();
    check_eq(seq_efs[0]["req_id"], "http1", "A-40 first persisted req_id is http1");
    check_eq(seq_efs[1]["req_id"], "http2", "A-40 second persisted req_id is http2");
    check_eq(state.get("__studio_http_seq"), 2, "A-40 async seq persisted in State");

    // ---------- A-45 & A-18: Manifest deployment target and Android cleartext accessors ----------
    let mf_test_dir = tmp_base + "/manifest_checks";
    dir_create(mf_test_dir);
    write_file(mf_test_dir + "/studio.json", json_write({
        "name": "MfTest",
        "bundleID": "sh.test.mf",
        "ios": {
            "deploymentTarget": "26.0"
        }
        ,
        "android": {
            "cleartext": true, "cleartextDomains": ["10.0.2.2", "dev.local"]
        }
        ,
    }));
    check_eq(
        man.ios_deployment_target_of(mf_test_dir),
        "17",
        "A-45 unsupported iOS deploymentTarget 26 falls back to valid SwiftPM 6.0 target 17"
    );
    check_ok(
        man.android_cleartext_of(mf_test_dir),
        "A-18 android_cleartext_of reads manifest policy"
    );
    check_eq(
        man.android_cleartext_domains_of(mf_test_dir).len(),
        2,
        "A-18 android_cleartext_domains_of reads domain list"
    );
    dir_remove(mf_test_dir);

    // ---------- A-26: Storage & Store schema versioning, migration, dirty flag & batching ----------
    let mig_dir = tmp_base + "/storage_mig";
    dir_create(mig_dir);
    storage.set_memory_only(false);
    storage.configure(mig_dir);
    storage.set("user", "yamin");
    check_eq(
        storage.schema_version(),
        0,
        "A-26 unversioned storage starts at schema_version 0"
    );
    let mig_runs = 0;
    let did_mig = storage.migrate(2, (from_v, data) => {
        mig_runs += 1;
        data["migrated_from"] = from_v;
        data["user_upper"] = string(data["user"]).upper();
        return data;
    });
    check_ok(did_mig and mig_runs == 1, "A-26 storage.migrate runs when cur < target");
    check_eq(storage.schema_version(), 2, "A-26 storage.schema_version updated to 2");
    check_eq(storage.get("user_upper"), "YAMIN", "A-26 migrated field persisted");
    let did_mig2 = storage.migrate(2, (_fv, d) => {
        mig_runs += 1;
        return d;
    });
    check_ok(not did_mig2 and mig_runs == 1, "A-26 storage.migrate is idempotent at target version");

    // Batched persistence: 50 writes -> 1 disk save
    let saves_before = storage.save_count();
    storage.batch(() => {
        let bi = 0;
        while bi < 50 {
            storage.set("k_" + string(bi), bi);
            bi += 1;
        }
    });
    check_eq(
        storage.save_count() - saves_before,
        1,
        "A-26 storage.batch coalesces 50 mutations into 1 disk write"
    );
    check_ok(not storage.is_dirty(), "A-26 storage.is_dirty clears after batch flush");
    storage.set_auto_flush(false);
    storage.set("deferred", 99);
    check_ok(storage.is_dirty(), "A-26 deferred set marks storage dirty");
    check_ok(
        storage.flush() and not storage.is_dirty(),
        "A-26 explicit flush writes and clears dirty"
    );
    storage.set_auto_flush(true);

    // Reload from disk verifies schema_version & batched values survive restart
    storage.configure(mig_dir);
    check_eq(storage.schema_version(), 2, "A-26 schema_version survives reload");
    check_eq(storage.get("k_49"), 49, "A-26 batched key survives reload");
    check_eq(storage.get("deferred"), 99, "A-26 deferred flushed key survives reload");

    // Atomic batch rollback on exception: partial writes must not leak into memory or next flush
    let batch_threw = false;
    let saves_pre_fail = storage.save_count();
    try {
        storage.batch(() => {
            storage.set("partial_leaked", "should_rollback");
            throw "boom_batch";
        });
    } catch (_be) {
        batch_threw = true;
    }
    check_ok(batch_threw, "A-26 storage.batch rethrows exception");
    check_eq(
        storage.get("partial_leaked", "missing"),
        "missing",
        "A-26 storage.batch rolls back partial mutation on exception"
    );
    check_ok(not storage.is_dirty(), "A-26 storage.batch restores clean dirty_flag on rollback");
    check_eq(
        storage.save_count(),
        saves_pre_fail,
        "A-26 failed storage.batch performs zero disk writes"
    );
    storage.set("after_fail", "ok");
    check_eq(
        storage.save_count(),
        saves_pre_fail + 1,
        "A-26 storage.batch restores auto_flush after exception"
    );
    storage.configure(mig_dir);
    check_eq(
        storage.get("partial_leaked", "missing"),
        "missing",
        "A-26 rolled-back batch key never flushed to disk on subsequent write"
    );

    // Corrupt kv.json refuses migrate() without mutating schema_version or overwriting file
    let corrupt_mig_dir = tmp_base + "/corrupt_mig";
    dir_remove(corrupt_mig_dir);
    dir_create(corrupt_mig_dir);
    write_file(corrupt_mig_dir + "/kv.json", "{not valid json");
    storage.configure(corrupt_mig_dir);
    let corrupt_ran = false;
    let corrupt_ok = storage.migrate(3, (_fv, d) => {
        corrupt_ran = true;
        return d;
    });
    check_ok(
        not corrupt_ok and not corrupt_ran,
        "A-26 storage.migrate refuses corrupt store without calling migrate_fn"
    );
    check_eq(storage.schema_version(), 0, "A-26 corrupt store keeps schema_version 0");
    let fs_corrupt = store_mod.FileStore(corrupt_mig_dir);
    check_ok(
        not fs_corrupt.migrate(3, (_fv, d) => d),
        "A-26 FileStore.migrate refuses corrupt store"
    );
    dir_remove(corrupt_mig_dir);
    dir_remove(mig_dir);

    // MemoryStore & FileStore migration + batching + rollback
    let ms2 = store_mod.MemoryStore();
    ms2.set("old", "v1");
    check_ok(ms2.migrate(1, (_fv, d) => {
        d["new_k"] = string(d["old"]) + "_migrated";
        return d;
    }), "A-26 MemoryStore.migrate runs");
    check_eq(ms2.schema_version(), 1, "A-26 MemoryStore.schema_version == 1");
    check_eq(ms2.get("new_k", ""), "v1_migrated", "A-26 MemoryStore migrated data");
    let ms_threw = false;
    try {
        ms2.batch(() => {
            ms2.set("temp_bad", 123);
            throw "ms_boom";
        });
    } catch (_me) {
        ms_threw = true;
    }
    check_ok(
        ms_threw and ms2.get("temp_bad", -1) == -1,
        "A-26 MemoryStore.batch rolls back partial writes on exception"
    );

    let fs_mig_dir = tmp_base + "/fstore_mig";
    let fs2 = store_mod.FileStore(fs_mig_dir);
    let fs_saves0 = fs2.save_count();
    fs2.batch(() => {
        fs2.set("a", 1);
        fs2.set("b", 2);
        fs2.set("c", 3);
    });
    check_eq(
        fs2.save_count() - fs_saves0,
        1,
        "A-26 FileStore.batch coalesces 3 mutations into 1 disk write"
    );
    let fs_threw = false;
    try {
        fs2.batch(() => {
            fs2.set("bad_key", 999);
            throw "fs_boom";
        });
    } catch (_fse) {
        fs_threw = true;
    }
    check_ok(
        fs_threw and fs2.get("bad_key", -1) == -1,
        "A-26 FileStore.batch rolls back partial writes on exception"
    );
    dir_remove(fs_mig_dir);

    // ---------- A-04, A-05, A-53: Capability bridge, secure_store, share, pick_file, auth & deep links ----------
    br.reset();
    check_ok(br.has_cap("secure_store"), "A-05 default host_caps reports secure_store");
    br.set_host_caps({
        "platform": "ios", "capabilities": {
            "share": false, "custom_biometric": true
        }
        ,
    });
    check_ok(not br.has_cap("share"), "A-05 set_host_caps updates capability flags");
    check_ok(br.has_cap("custom_biometric"), "A-05 set_host_caps merges custom capabilities");
    check_ok(
        br.secure_set("auth_token", "tok123", "on_sec"),
        "A-04 secure_set enqueues effect"
    );
    check_ok(not br.secure_set("bad key!", "v"), "A-04 secure_set rejects unsafe key chars");
    check_ok(br.secure_get("auth_token", "on_sec"), "A-04 secure_get enqueues effect");
    check_ok(not br.secure_get("auth_token", ""), "A-04 secure_get requires callback");
    check_ok(br.secure_remove("auth_token"), "A-04 secure_remove enqueues effect");
    check_ok(
        br.share("Title", "Body", "https://example.org"),
        "A-05 share accepts safe https url"
    );
    check_ok(
        not br.share("Title", "Body", "javascript:alert(1)"),
        "A-05 share blocks javascript: url"
    );
    check_ok(br.pick_file("image/*", "on_file"), "A-05 pick_file enqueues files.pick");
    check_ok(
        br.start_auth("https://auth.example.org/authorize", "myapp", "on_auth"),
        "A-53 start_auth accepts https + custom scheme"
    );
    check_ok(
        not br.start_auth("http://insecure.example.org/auth", "myapp", "on_auth"),
        "A-53 start_auth rejects cleartext http://"
    );
    check_ok(
        not br.start_auth("https://auth.example.org/auth", "javascript", "on_auth"),
        "A-53 start_auth rejects unsafe redirect scheme"
    );
    let cap_efs = br.drain_effects();
    check_eq(cap_efs.len(), 6, "A-04/A-05/A-53 enqueued 6 valid host effects");
    check_eq(cap_efs[0]["kind"], "secure_store.set", "effect kind secure_store.set");
    check_eq(cap_efs[1]["kind"], "secure_store.get", "effect kind secure_store.get");
    check_eq(cap_efs[2]["kind"], "secure_store.remove", "effect kind secure_store.remove");
    check_eq(cap_efs[3]["kind"], "share", "effect kind share");
    check_eq(cap_efs[4]["kind"], "files.pick", "effect kind files.pick");
    check_eq(cap_efs[5]["kind"], "auth.open", "effect kind auth.open");

    let dl_ok = br.parse_deep_link("myapp://auth/callback?code=xyz&state=s1#frag");
    check_eq(dl_ok["scheme"], "myapp", "A-53 parse_deep_link scheme");
    check_eq(dl_ok["host"], "auth", "A-53 parse_deep_link host");
    check_eq(dl_ok["path"], "/callback", "A-53 parse_deep_link path");
    check_eq(dl_ok["query"]["code"], "xyz", "A-53 parse_deep_link query.code");
    check_eq(dl_ok["query"]["state"], "s1", "A-53 parse_deep_link query.state");
    check_eq(
        br.parse_deep_link("javascript://evil").len(),
        0,
        "A-53 parse_deep_link rejects javascript:"
    );

    // ---------- A-29: I18n, RTL direction & logical CSS ----------
    i18n.reset();
    i18n.register("en", {
        "hello": r"Hello, {name}!", "only_en": "Fallback OK"
    });
    i18n.register("ar", {
        "hello": r"Marhaba, {name}!"
    });
    check_eq(i18n.locale(), "en", "A-29 default locale is en");
    check_ok(not i18n.is_rtl() and i18n.dir() == "ltr", "A-29 en is LTR");
    check_eq(i18n.t("hello", {
        "name": "Ada"
    }), "Hello, Ada!", "A-29 t() interpolates params");
    i18n.set_locale("ar-EG");
    check_ok(i18n.is_rtl() and i18n.dir() == "rtl", "A-29 ar-EG detected as RTL");
    check_eq(i18n.t("hello", {
        "name": "Ada"
    }), "Marhaba, Ada!", "A-29 regional ar-EG falls back to base ar");
    check_eq(i18n.t("only_en"), "Fallback OK", "A-29 missing ar key falls back to en");
    check_eq(i18n.t("unknown.key"), "unknown.key", "A-29 missing key returns key literal");
    let rtl_page = render.node_html(ui.page([ui.text("Hi")]));
    check_ok(
        rtl_page.contains("dir=\"rtl\""),
        "A-29 Render emits dir=\"rtl\" when RTL locale active"
    );
    // Memoized component must invalidate cache across locale switches
    render.clear_component_cache();
    i18n.set_locale("en");
    let memo_en = render.node_html(ui.component("greet_memo", {
        "name": "Ada"
    }, (p) => ui.text(i18n.t("hello", p)), {
        "memo": true, "key": "greet_memo"
    }));
    i18n.set_locale("ar");
    let memo_ar = render.node_html(ui.component("greet_memo", {
        "name": "Ada"
    }, (p) => ui.text(i18n.t("hello", p)), {
        "memo": true, "key": "greet_memo"
    }));
    check_ok(
        memo_en.contains("Hello, Ada!") and memo_ar.contains("Marhaba, Ada!"),
        "A-29 memoized ui.component invalidates cache when locale changes"
    );
    let sheet_css = css.stylesheet();
    check_ok(
        sheet_css.contains("padding-inline:") and sheet_css.contains("inset-inline-start:") and sheet_css.contains("[dir=rtl]"),
        "A-29 CSS uses logical properties and RTL rules"
    );
    i18n.reset();

    // ---------- A-30: Roving tabindex on tabbar & segmented controls ----------
    let seg_roving = render.node_html(ui.segmented(["A", "B", "C"], 1, "on_s"));
    check_ok(
        seg_roving.contains("aria-selected=\"true\" tabindex=\"0\"") and seg_roving.contains("aria-selected=\"false\" tabindex=\"-1\""),
        "A-30 segmented emits roving tabindex 0 on active tab and -1 on inactive tabs"
    );

    // ---------- A-24: Log ring buffer & dev error overlay ----------
    appkit.clear_logs();
    let li = 0;
    while li < 120 {
        appkit.log_info("test", "msg_" + string(li));
        li += 1;
    }
    let all_logs = appkit.recent_logs(200);
    check_eq(all_logs.len(), 100, "A-24 log ring buffer caps at 100 entries");
    check_eq(all_logs[0]["message"], "msg_20", "A-24 log ring drops oldest entries FIFO");
    check_eq(all_logs[99]["message"], "msg_119", "A-24 log ring retains latest entry");
    appkit.set_dev_mode(true);
    check_ok(appkit.is_dev_mode(), "A-24 set_dev_mode toggles flag");
    appkit.set_dev_mode(false);
    appkit.clear_logs();

    // ---------- A-03 & A-25: Render dispatch performance budget (200 nodes) ----------
    appkit.reset_perf();
    let big_items = [];
    let bi2 = 0;
    while bi2 < 200 {
        big_items.push(ui.card([ui.text("Row " + string(bi2)), ui.badge("OK", "success")], {
            "key": "r_" + string(bi2)
        }));
        bi2 += 1;
    }
    let t_perf_0 = now_ms();
    let big_html = render.node_html(ui.page(big_items));
    let elapsed_perf = now_ms() - t_perf_0;
    check_ok(
        big_html.contains("data-key=\"r_0\"") and big_html.contains("data-key=\"r_199\""),
        "A-25 O(1) dispatch table renders 200-node tree completely"
    );
    check_ok(
        elapsed_perf < 1000,
        "A-03 200-node render completes within 1000ms budget (" + string(elapsed_perf) + "ms)"
    );

    // ---------- A-23: Desktop state-preserving hot-reload snapshot ----------
    let hot_path = tmp_base + "/hot_state.json";
    state.reset();
    state.set("draft", "preserve-me");
    nav.reset();
    nav.configure(["Home", "Stats"]);
    nav.push("Detail", {
        "id": "42"
    });
    check_ok(
        gui_app.save_hot_snapshot(hot_path),
        "A-23 save_hot_snapshot writes JSON snapshot"
    );
    state.reset();
    nav.reset();
    nav.configure(["Home", "Stats"]);
    check_ok(
        gui_app.restore_hot_snapshot(hot_path),
        "A-23 restore_hot_snapshot restores and removes file"
    );
    check_eq(state.get("draft"), "preserve-me", "A-23 hot snapshot preserves state");
    check_eq(nav.page_name(), "Detail", "A-23 hot snapshot preserves route");
    check_ok(not file_exists(hot_path), "A-23 hot snapshot file cleaned after restore");

    // ---------- A-05: Extended native capability bridge effects ----------
    br.drain_effects();
    check_ok(br.request_geolocation("on_geo"), "A-05 request_geolocation enqueues effect");
    check_ok(
        br.authenticate_biometrics("Unlock", "on_bio"),
        "A-05 authenticate_biometrics enqueues effect"
    );
    check_ok(br.capture_camera("on_cam", "user"), "A-05 capture_camera enqueues effect");
    check_ok(br.notify("Hi", "Body", "on_notif"), "A-05 notify enqueues effect");
    check_ok(br.pick_contact("on_contact"), "A-05 pick_contact enqueues effect");
    check_ok(br.ble_scan("180d", "on_ble"), "A-05 ble_scan enqueues effect");
    check_ok(
        br.schedule_background_task("sync", 300, "on_bg"),
        "A-05 schedule_background_task enqueues effect"
    );
    let cap_effects = br.drain_effects();
    check_eq(
        cap_effects.len(),
        7,
        "A-05 all 7 capability helpers emit structured host effects"
    );

    state.reset();
    theme.reset();
    i18n.reset();
    br.reset();
    if is_dir(tmp_base) {
        dir_remove(tmp_base);
    }

    println("");
    println("passed: " + string(passed) + "  failed: " + string(failed));
    if failed > 0 {
        return 1;
    }
    return 0;
}

/// Parse-check a source string by round-tripping through an isolated temp file.
fn check_source_snippet(src: string) -> bool {
    let sn_dir = tmp_base + "/snippet";
    dir_create(sn_dir);
    let p = sn_dir + "/_flat_check.matrix";
    let w = write_file(p, src);
    if w.is_err() {
        dir_remove(sn_dir);
        return false;
    }
    let r = exec_capture("spid3r", ["check", p], null);
    dir_remove(sn_dir);
    if r.is_err() {
        return false;
    }
    return int(r.unwrap()["code"]) == 0;
}
