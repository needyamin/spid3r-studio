// tests/flatkit.matrix
// Dedicated bundler tests for tools/FlatKit.matrix: lexer accuracy, multi-file DAGs,
// global isolation, string interpolations, raw strings, comments, and Http bundling.

import "tools/FlatKit" as flatkit;

let passed = 0;
let failed = 0;
let tmp_root = "";

fn os_temp_base() -> string {
    for k in ["TMPDIR", "TEMP", "TMP"] {
        let ev = env(k);
        if string(ev) != "none" {
            let p = string(ev.unwrap()).replace("\\", "/");
            while p.len() > 1 and p.ends_with("/") {
                p = p.slice(0, p.len() - 1);
            }
            if p != "" and is_dir(p) {
                return p;
            }
        }
    }
    if is_dir("/tmp") {
        return "/tmp";
    }
    return ".";
}

fn check_ok(cond: bool, name: string) {
    if cond {
        passed += 1;
    } else {
        failed += 1;
        println("FAIL: " + name);
    }
}

fn check_parses(src: string, tag: string) -> bool {
    let tmp = tmp_root + "/check_" + tag + ".matrix";
    if write_file(tmp, src).is_err() {
        return false;
    }
    let r = exec_capture("spid3r", ["check", tmp], null);
    if r.is_err() {
        return false;
    }
    return int(r.unwrap()["code"]) == 0;
}

fn check_strict(src: string, tag: string) -> bool {
    let tmp = tmp_root + "/check_" + tag + ".matrix";
    if write_file(tmp, src).is_err() {
        return false;
    }
    let r = exec_capture("spid3r", ["check", "--deny-warnings", tmp], null);
    if r.is_err() {
        return false;
    }
    let m = r.unwrap();
    if int(m["code"]) != 0 {
        println(
            "check_strict(" + tag + ") failed: " + string(m["stderr"]) + string(m["stdout"])
        );
        return false;
    }
    return true;
}

/// Execute a bundled flat source via `spid3r run` and return its rendered frame HTML (or "").
fn run_bundle_html(flat: string, tag: string) -> string {
    let tmp = tmp_root + "/run_" + tag + ".matrix";
    if write_file(tmp, flat).is_err() {
        return "";
    }
    let r = exec_capture("spid3r", ["run", tmp], null);
    if r.is_err() {
        return "";
    }
    let m = r.unwrap();
    if int(m["code"]) != 0 {
        println(
            "run_bundle_html(" + tag + ") exit=" + string(m["code"]) + " err=" + string(m["stderr"])
        );
        return "";
    }
    let lines = string(m["stdout"]).split("\n");
    let i = 0;
    while i + 1 < lines.len() {
        if string(lines[i]).trim() == "@@STUDIO_FRAME@@" {
            try {
                let parsed = json_parse(string(lines[i + 1]));
                if type_of(parsed) == "map" and parsed.has("html") {
                    return string(parsed["html"]);
                }
            } catch (_e) {
                return "";
            }
        }
        i += 1;
    }
    return "";
}

fn make_case_dir(base: string, name: string) -> string {
    let d = base + "/" + name;
    dir_create(d);
    return d;
}

fn main() -> int {
    tmp_root = os_temp_base() + "/appstudio_test_flatkit";
    let dir = tmp_root;
    if is_dir(dir) {
        dir_remove(dir);
    }
    dir_create(dir);
    dir_create(dir + "/pages");

    // 3-file topological dependency graph: app -> pages/B -> pages/A
    let page_a = r#"import "../studio/Components" as ui;
let local_tag = "alpha";
public fn Banner() -> map {
    return ui.badge("from_" + local_tag, "primary");
}
"#

    ;
    let page_b = r#"import "../studio/Components" as ui;
import "../studio/State" as state;
import "A" as a_mod;
let local_tag = "beta";
public fn ViewB() -> map {
    let v = state.get_or("v", 9);
    let _msg = "v={v} inner={state.get_or("k", 1)}";
    return ui.column([a_mod.Banner(), ui.text("b:" + local_tag + ":" + string(v))]);
}
"#

    ;
    let raw2_decl = "    let raw2 = r#" + "\"" + "nested raw " + r#"{import}"# + "\"" + "#;\n";
    let main_app = r#"// import "fake/comment_import" as fake;
/* fn fake_block_fn() {
   let cache = 0;
} */
import "studio/App" as appkit;
import "studio/Components" as ui;
import "studio/Http" as http;
import "pages/B" as b_mod;

let local_tag = "main";
let cache = 99;

class Worker {
    public fn run(self) -> string {
        return "worker_" + local_tag;
    }
}

fn Home() -> map {
    let w = Worker();
    let _ref = http.get_async;
    let raw1 = r"raw {import} fn dummy()";
"#

    + raw2_decl + r#"    let esc_s = "escaped \"import\" fn foo()";
    return ui.page([
        b_mod.ViewB(),
        ui.text(w.run() + ":" + string(cache) + ":" + raw1 + ":" + raw2 + ":" + esc_s),
    ]);
}

public fn studio_app() {
    return appkit.App("FlatTest", "sh.test.flatkit", "1.0.0").page("Home", Home);
}
"#

    ;

    write_file(dir + "/pages/A.matrix", page_a);
    write_file(dir + "/pages/B.matrix", page_b);
    write_file(dir + "/app.matrix", main_app);

    let flat = flatkit.bundle(dir);
    check_ok(flat != "", "flatkit bundles 3-file app");
    check_ok(
        not flat.contains("\nimport \"") and not flat.starts_with("import \""),
        "flatkit strips all top-level import directives"
    );
    check_ok(
        flat.contains("// import \"fake/comment_import\""),
        "flatkit preserves line comments"
    );
    check_ok(flat.contains("fn fake_block_fn()"), "flatkit preserves block comments");
    check_ok(
        flat.contains("mod_u_pages_A_local_tag") and flat.contains("mod_u_pages_B_local_tag") and flat.contains("mod_u_app_local_tag"),
        "flatkit isolates colliding module globals"
    );
    check_ok(
        flat.contains("mod_u_app_cache") and flat.contains("mod_Storage_cache"),
        "flatkit isolates app global from Storage cache"
    );
    check_ok(flat.contains("w.run()"), "flatkit keeps custom class .run() method intact");
    check_ok(flat.contains("pub_Http_get_async"), "flatkit bundles Http async functions");
    check_ok(
        flat.contains("pub_State_get_or"),
        "flatkit rewrites nested interpolation expressions"
    );

    // Verify topological order: A declared before B, B before main
    let idx_a = flat.index_of("pub_u_pages_A_Banner");
    let idx_b = flat.index_of("pub_u_pages_B_ViewB");
    let idx_m = flat.index_of("fn studio_app()");
    check_ok(
        idx_a >= 0 and idx_b > idx_a and idx_m > idx_b,
        "topological dependency order A -> B -> app"
    );

    check_ok(check_parses(flat, "dag3"), "3-file flatkit bundle passes spid3r check");

    let win_flat = flatkit.bundle(dir);
    check_ok(win_flat.contains("fn studio_app()"), "flatkit bundles isolated temp app path");

    // ---------- Bundle Gate Executable Corpus (A-54, A-55, A-35, A-36, A-37, A-50, A-06, A-09) ----------

    // 1. A-54 Form 1: (total) => total + 1 must return 6, not 1001
    let d_a54_1 = make_case_dir(dir, "a54_paren");
    write_file(
        d_a54_1 + "/app.matrix",
        r#"import "studio/App" as appkit;
import "studio/Components" as ui;
let total = 1000;
fn Home() -> map {
    let g = (total) => total + 1;
    return ui.page([ui.text("RES=" + string(g(5)) + ":OUT=" + string(total))]);
}
public fn studio_app() { return appkit.App("A54a", "sh.t.a54a", "1.0.0").page("Home", Home); }
"#
    );
    let f_a54_1 = flatkit.bundle(d_a54_1);
    check_ok(
        f_a54_1 != "" and check_strict(f_a54_1, "a54_1"),
        "A-54 paren arrow passes --deny-warnings"
    );
    let h_a54_1 = run_bundle_html(f_a54_1, "a54_1");
    check_ok(
        h_a54_1.contains("RES=6:OUT=1000"),
        "A-54 executed: (total) => total + 1 evaluates to 6, not 1001"
    );

    // 2. A-54 Form 2: map literal {"k": (total) => total + 1}
    let d_a54_2 = make_case_dir(dir, "a54_map");
    write_file(
        d_a54_2 + "/app.matrix",
        r#"import "studio/App" as appkit;
import "studio/Components" as ui;
let total = 1000;
fn Home() -> map {
    let m = {"k": (total) => total + 1, "g": total};
    let f = m["k"];
    return ui.page([ui.text("RES=" + string(f(5)) + ":G=" + string(m["g"]))]);
}
public fn studio_app() { return appkit.App("A54b", "sh.t.a54b", "1.0.0").page("Home", Home); }
"#
    );
    let f_a54_2 = flatkit.bundle(d_a54_2);
    check_ok(
        f_a54_2 != "" and check_strict(f_a54_2, "a54_2"),
        "A-54 map arrow passes --deny-warnings"
    );
    let h_a54_2 = run_bundle_html(f_a54_2, "a54_2");
    check_ok(
        h_a54_2.contains("RES=6:G=1000"),
        "A-54 executed: map-literal arrow evaluates to 6 and sibling key sees global 1000"
    );

    // 3. A-54 Form 3: curried (total) => (total) => total + 1
    let d_a54_3 = make_case_dir(dir, "a54_curried");
    write_file(
        d_a54_3 + "/app.matrix",
        r#"import "studio/App" as appkit;
import "studio/Components" as ui;
let total = 1000;
fn Home() -> map {
    let g = (a) => (total) => a + total + 1;
    return ui.page([ui.text("RES=" + string(g(10)(5)) + ":OUT=" + string(total))]);
}
public fn studio_app() { return appkit.App("A54c", "sh.t.a54c", "1.0.0").page("Home", Home); }
"#
    );
    let f_a54_3 = flatkit.bundle(d_a54_3);
    check_ok(
        f_a54_3 != "" and check_strict(f_a54_3, "a54_3"),
        "A-54 curried arrow passes --deny-warnings"
    );
    let h_a54_3 = run_bundle_html(f_a54_3, "a54_3");
    check_ok(
        h_a54_3.contains("RES=16:OUT=1000"),
        "A-54 executed: curried brace-less arrow evaluates to 16"
    );

    // 4. A-54 Form 4: bare single-param total => total + 1 (at top-level AND inside fn)
    let d_a54_4 = make_case_dir(dir, "a54_bare");
    write_file(
        d_a54_4 + "/app.matrix",
        r#"import "studio/App" as appkit;
import "studio/Components" as ui;
let total = 1000;
let top_fn = total => total + 2;
fn Home() -> map {
    let g = total => total + 1;
    return ui.page([ui.text("RES=" + string(g(5)) + ":TOP=" + string(top_fn(5)) + ":OUT=" + string(total))]);
}
public fn studio_app() { return appkit.App("A54d", "sh.t.a54d", "1.0.0").page("Home", Home); }
"#
    );
    let f_a54_4 = flatkit.bundle(d_a54_4);
    check_ok(
        f_a54_4 != "" and check_strict(f_a54_4, "a54_4"),
        "A-54 bare arrow passes --deny-warnings"
    );
    let h_a54_4 = run_bundle_html(f_a54_4, "a54_4");
    check_ok(
        h_a54_4.contains("RES=6:TOP=7:OUT=1000"),
        "A-54 executed: bare arrow preserves both param and module global"
    );

    // 5. A-55 Directional leak arrangement: brace-less arrow BEFORE a later function referencing module global
    let d_a55_before = make_case_dir(dir, "a55_before");
    write_file(
        d_a55_before + "/app.matrix",
        r#"import "studio/App" as appkit;
import "studio/Components" as ui;
let total = 1000;
let g = (total) => total + 1;
fn later_fn() -> int {
    return total + 1;
}
fn Home() -> map {
    return ui.page([ui.text("G=" + string(g(5)) + ":LATER=" + string(later_fn()))]);
}
public fn studio_app() { return appkit.App("A55b", "sh.t.a55b", "1.0.0").page("Home", Home); }
"#
    );
    let f_a55_b = flatkit.bundle(d_a55_before);
    check_ok(
        f_a55_b != "" and check_strict(f_a55_b, "a55_before"),
