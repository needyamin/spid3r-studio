        f_a36 != "" and check_strict(f_a36, "a36"),
        "A-36 multiple top-level let _ passes --deny-warnings"
    );
    let h_a36 = run_bundle_html(f_a36, "a36");
    check_ok(h_a36.contains("VAL=42"), "A-36 executed: multiple top-level let _ runs cleanly");

    // 8. A-37 Class field with same name as module global
    let d_a37 = make_case_dir(dir, "a37_field");
    write_file(
        d_a37 + "/app.matrix",
        r#"import "studio/App" as appkit;
import "studio/Components" as ui;
let count = 100;
class Counter {
