    return ui.page([ui.text("S1=" + string(s1) + ":S2=" + string(s2) + ":S3=" + string(s3) + ":G=" + string(total))]);
}
public fn studio_app() { return appkit.App("ForAr", "sh.t.forar", "1.0.0").page("Home", Home); }
