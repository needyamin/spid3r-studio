    write_file(
        d_h2a + "/app.matrix",
        r#"import "studio/App" as appkit;
import "studio/Components" as ui;
import "studio/Store" as store_mod;
import "studio/Errors" as errors;

fn read_store(s: store_mod.Store, k: string) -> string {
    return string(s.get(k, "none"));
}

fn CardComp(props: map) -> map {
    return ui.text("COMP=" + string(props["label"]));
}

fn Home() -> map {
    let ms = store_mod.MemoryStore();
    ms.set("who", "alice");
    let err = errors.make("E_DEMO", "oops", "test", true);
    return ui.page([
        ui.text("WHO=" + read_store(ms, "who") + ":ERR=" + err.format()),
        ui.component("CardComp", {"label": "memo-ok"}, CardComp, "card-1"),
    ]);
}
public fn studio_app() { return appkit.App("H2aApp", "sh.t.h2a", "1.0.0").page("Home", Home); }
"#
    );
    let f_h2a = flatkit.bundle(d_h2a);
    check_ok(
        f_h2a != "" and check_strict(f_h2a, "h2a_oop"),
        "H2a Store + Errors + ui.component bundle passes --deny-warnings"
    );
    let h_h2a = run_bundle_html(f_h2a, "h2a_oop");
    check_ok(
        h_h2a.contains("WHO=alice:ERR=[E_DEMO] oops (cause: test)") and h_h2a.contains("data-key=\"card-1\"") and h_h2a.contains("COMP=memo-ok"),
        "H2a executed: MemoryStore implements Store, AppError formats, ui.component renders keyed output"
    );

    // 16. A-24 & A-29: FlatKit line_map / map_line + studio/I18n bundling
    let d_lmap = make_case_dir(dir, "a24_lmap");
    write_file(
        d_lmap + "/app.matrix",
        "import \"studio/App\" as appkit;\nimport \"studio/Components\" as ui;\nimport \"studio/I18n\" as i18n;\nfn Home() -> map {\n    i18n.set_locale(\"ar\");\n    return ui.page([ui.text(\"DIR=\" + i18n.dir())]);\n}\npublic fn studio_app() {\n    return appkit.App(\"LMap\", \"sh.t.lmap\", \"1.0.0\").page(\"Home\", Home);\n}\n"
    );
    let f_lmap = flatkit.bundle(d_lmap);
    let lmap = flatkit.line_map();
    check_ok(
        f_lmap != "" and check_strict(f_lmap, "a24_lmap"),
        "A-29 app importing studio/I18n bundles and passes --deny-warnings"
    );
    check_ok(lmap.len() >= 15, "A-24 FlatKit.line_map records framework + user module ranges");
    // Locate the line containing 'DIR=' in the flat bundle and verify map_line points back to app.matrix line 6
    let flat_lines = f_lmap.split("\n");
    let found_flat_line = 0;
    let fli = 0;
    while fli < flat_lines.len() {
        if string(flat_lines[fli]).contains("\"DIR=\"") {
            found_flat_line = fli + 1;
            break;
        }
        fli += 1;
    }
    let mapped = flatkit.map_line(found_flat_line);
    check_ok(
        found_flat_line > 0 and mapped.has("file") and string(mapped["file"]).ends_with("app.matrix") and int(mapped["line"]) == 6,
        "A-24 FlatKit.map_line maps flat line back to exact app.matrix:6"
    );
    let h_lmap = run_bundle_html(f_lmap, "a24_lmap");
    check_ok(
        h_lmap.contains("DIR=rtl") and h_lmap.contains("dir=\"rtl\""),
        "A-29 bundled I18n sets RTL direction in WASM output"
    );

    // 17. Spid3r v1.5.0: multi-file enum + exhaustive match, named imports, stdlib passthrough,
    //     destructuring let, bare catch, C-style for-let, and .mt module extension
    let d_v15 = make_case_dir(dir, "spid3r_v15");
    dir_create(d_v15 + "/pages");
    write_file(
        d_v15 + "/pages/Types.mt",
        r#"public enum Role {
    Guest,
    Member(name, level),
}
public fn format_role(r) -> string {
    return match (r) {
        Role.Guest => "guest",
        Role.Member(n, lv) => "member:" + n + ":" + string(lv)
    };
}
"#
    );
    write_file(
        d_v15 + "/pages/MathUtil.matrix",
        r#"let secret_val = 42;
public fn add_nums(a: int, b: int) -> int {
    return a + b;
}
"#
    );
    write_file(
        d_v15 + "/app.matrix",
        r#"import "studio/App" as appkit;
import "studio/Components" as ui;
import "semver" as sv;
import { Role, format_role as fmt_role } from "pages/Types";
import { add_nums } from "pages/MathUtil";

let a = 999;
let b = 888;
let e = "global-e";
let i = 777;

fn Home() -> map {
    let (a, b) = (10, 20);
    let sum = add_nums(a, b);
    let caught = "ok";
    try {
        throw "boom";
    } catch e {
        caught = string(e);
    }
    let acc = 0;
    for let i = 0; i < 4; i += 1 {
        acc += i;
    }
    let r_str = fmt_role(Role.Member("Ada", 3));
    let cmp = sv.compare("1.5.0", "1.1.1");
    return ui.page([
        ui.text("SUM=" + string(sum) + "|ERR=" + caught + "|ACC=" + string(acc) + "|ROLE=" + r_str + "|CMP=" + string(cmp)),
    ]);
}
public fn studio_app() {
    return appkit.App("V15App", "sh.t.v15", "1.5.0").page("Home", Home);
}
"#
    );
    let f_v15 = flatkit.bundle(d_v15);
    check_ok(
        f_v15 != "" and check_strict(f_v15, "spid3r_v15"),
        "Spid3r v1.5.0 features (enum/match, named imports, stdlib, .mt, destructuring, bare catch, for-let) pass --deny-warnings"
    );
    let h_v15 = run_bundle_html(f_v15, "spid3r_v15");
    check_ok(
        h_v15.contains("SUM=30|ERR=boom|ACC=6|ROLE=member:Ada:3|CMP=1"),
        "Spid3r v1.5.0 executed bundle renders exact enum/match, named import, stdlib, and scoping results"
    );

    dir_remove(dir);
    println("flatkit passed: " + string(passed) + "  failed: " + string(failed));
    if failed > 0 {
        return 1;
    }
    return 0;
}
