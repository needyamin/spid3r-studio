    );
    let h_a55_b = run_bundle_html(f_a55_b, "a55_before");
    check_ok(
        h_a55_b.contains("G=6:LATER=1001"),
        "A-55 executed: arrow before function does not corrupt later function"
    );

    // 6. A-35 Module identity collision: pages/Home.matrix vs pages_Home.matrix
    let d_a35 = make_case_dir(dir, "a35_col");
    dir_create(d_a35 + "/pages");
    write_file(
        d_a35 + "/pages/Home.matrix",
        "public fn label() -> string { return \"from_dir_home\"; }\n"
    );
    write_file(
        d_a35 + "/pages_Home.matrix",
        "public fn label() -> string { return \"from_flat_home\"; }\n"
    );
    write_file(
        d_a35 + "/app.matrix",
        r#"import "studio/App" as appkit;
import "studio/Components" as ui;
import "pages/Home" as dir_h;
import "pages_Home" as flat_h;
fn Home() -> map {
    return ui.page([ui.text(dir_h.label() + "|" + flat_h.label())]);
}
public fn studio_app() { return appkit.App("A35", "sh.t.a35", "1.0.0").page("Home", Home); }
"#
    );
    let f_a35 = flatkit.bundle(d_a35);
    check_ok(
        f_a35 != "" and check_strict(f_a35, "a35"),
        "A-35 colliding module paths pass --deny-warnings"
    );
    let h_a35 = run_bundle_html(f_a35, "a35");
    check_ok(
        h_a35.contains("from_dir_home|from_flat_home"),
        "A-35 executed: pages/Home and pages_Home are both distinct and reachable"
    );

    // 7. A-36 Multiple top-level `let _` across modules
    let d_a36 = make_case_dir(dir, "a36_discard");
    write_file(
        d_a36 + "/helper.matrix",
        "let _ = 1;\npublic fn val() -> int { return 42; }\n"
