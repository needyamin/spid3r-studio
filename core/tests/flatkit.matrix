        r#"import "studio/App" as appkit;
import "studio/Components" as ui;
import "shapes/Shape" as sh;

interface Labelled {
    fn tag(self) -> string;
}

class Rect implements sh.Shape {
    public let w;
    public let h;
    fn new(w: int, h: int) { self.w = w; self.h = h; }
    public fn area(self) -> int { return self.w * self.h; }
}

class Badge implements Labelled {
    public let lbl;
    fn new(lbl: string) { self.lbl = lbl; }
    public fn tag(self) -> string { return self.lbl; }
}

fn measure(s: sh.Shape) -> int {
    return s.area();
}

fn Home() -> map {
    let r = Rect(6, 7);
    let b = Badge("ok-badge");
    return ui.page([ui.text("AREA=" + string(measure(r)) + ":TAG=" + b.tag())]);
}
public fn studio_app() { return appkit.App("A50", "sh.t.a50", "1.0.0").page("Home", Home); }
