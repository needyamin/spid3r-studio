// gui/pages/Workspace.matrix
// MVC Workspace View: 5-tier A-Z architecture explorer, KPI strip, smart recommendations,
// project switcher (workspace/ & examples/), project creator, and recovery actions.

import "studio/Components" as ui;
import "studio/State" as state;
import "studio/Router" as nav;
import "gui/Icons" as ico;
import "gui/Jobs" as jobs;
import "gui/Toolchain" as tc;
import "gui/Shell" as shell;
import "gui/models/StudioModel" as model;
import "gui/controllers/StudioController" as ctrl;

public fn select_project(path: string) {
    ctrl.switch_project(path);
}

fn on_create_app(_ev) {
    let name = string(state.get_or("new_app_name", "")).trim();
    let outdir = string(state.get_or("new_app_dir", "")).trim();
    ctrl.create_workspace_project(name, outdir);
}

fn kpi_card(label: string, val: string, sub: string) -> map {
    return ui.column([ui.text(label, "cc-kpi-label"), ui.text(val, "cc-kpi-val"), ui.text(sub, "cc-kpi-sub"),], {
        "cls": "cc-kpi"
    });
}

fn tier_card(t: map) -> map {
    let target_nav = string(t["nav"]);
    return ui.column([ui.row(
        [ui.text(string(t["title"]), "subtitle"),
        ui.flex_spacer(),
        ui.badge(string(t["count"]) + " files", "primary"),
        ]
    ), ui.text(string(t["path"]), "mono"), ui.caption(string(t["summary"])),], {
        "cls": "cc-tier-card", "onTap": (_ev) => nav.replace(target_nav)
    });
}

public fn Workspace() -> map {
    let active = string(state.get_or("active_project", "workspace/demo"));
    let info = state.get_or("proj_info", null);
    if info == null or type_of(info) != "map" {
        info = jobs.project_info(active);
    }
    let projects = state.get_list("projects");
    if projects.len() == 0 {
        projects = ["workspace/demo"];
    }
    let checks = state.get_list("env_checks");
    let recs = tc.build_recommendations(checks);
    let busy = state.get_or("job_busy", false) == true;
    let rd = state.get_or("readiness", {
        "desktop_ok": true, "web_ok": true, "ios_ok": false, "ios_missing": 0, "android_ok": false, "android_missing": 4, "total_ok": 0, "total_issues": 0
    });
    if type_of(rd) != "map" {
        rd = {
            "desktop_ok": true, "web_ok": true, "ios_ok": false, "ios_missing": 0, "android_ok": false, "android_missing": 4, "total_ok": 0, "total_issues": 0
        };
    }

    // 6 total OS targets: Windows, macOS, Linux, Web/PWA, iOS, Android
    let ready_os = 4;
    if rd["ios_ok"] == true {
        ready_os += 1;
    }
    if rd["android_ok"] == true {
        ready_os += 1;
    }

    let udid = string(state.get_or("ios_udid", ""));
    let busid = string(state.get_or("ios_busid", ""));
    let dev_val = "Host Desktop";
    let dev_sub = "Plug USB iPhone or Android";
    if udid != "" {
        dev_val = "iPhone USB";
        dev_sub = udid;
    } elif busid != "" {
        dev_val = "iPhone (" + busid + ")";
        dev_sub = string(state.get_or("ios_usb_state", "Shared")) + " — attach to WSL2";
    }

    let tsum = state.get_or("last_test_summary", null);
    let qa_val = "5 Suites";
    let qa_sub = "Click Tests to run";
    if tsum != null and type_of(tsum) == "map" {
        qa_val = string(tsum["passed"]) + " Passed";
        qa_sub = string(tsum["suites"]) + " suites, " + string(tsum["failed"]) + " failed";
    }

    let body = [];

    // 1. 4-Column KPI Strip
    body.push(ui.row([kpi_card(
        "Active Project",
        string(info["name"]),
        string(info["bundle_id"]) + "  v" + string(info["version"])
    ), kpi_card("Target OS Readiness", string(ready_os) + " / 6 OS Ready", if checks.len() == 0 {
        "Win, macOS, Linux, Web, iOS, Android"
    } else {
        string(recs.len()) + " setup item(s) in Downloads"
    }), kpi_card("Connected Devices", dev_val, dev_sub), kpi_card("Verification & QA", qa_val, qa_sub),], {
        "cls": "cc-kpis"
    }));

    // 2. 5-Tier A-Z Project Architecture Map
    let tier_nodes = [];
    for t in model.architecture_tiers() {
        tier_nodes.push(tier_card(t));
    }
    body.push(ui.card([ui.row(
        [ui.title("A–Z Architecture Separation (5 Tiers)"),
        ui.flex_spacer(),
        ui.badge("MVC Architecture Active", "success"),
        ]
    ), ui.caption(
        "Click any tier below to inspect Frameworks, Downloads, Documents, Workspace Code, or Core QA tools."
    ), ui.spacer(4), ui.row(tier_nodes, {
        "cls": "cc-tier-grid"
    }),]));

    // 3. Missing Dependency Recommendations Strip
    if checks.len() > 0 and recs.len() > 0 {
        let rec_rows = [];
        let lim = 0;
        for r in recs {
            if lim >= 3 {
                break;
            }
            let r_id = string(r["id"]);
            let act_kind = string(r["action_kind"]);
            let act_arg = string(r["action_arg"]);
            let act_lbl = string(r["action_label"]);
            let r_kids = [
            ui.column([ui.row([ui.text(string(r["name"]), "subtitle"), ui.badge(string(r["category"]), "primary"),], {
                "gap": 6
            }), ui.caption(string(r["recommendation"])),], {
                "flex": 1, "gap": 2
            }),
            ];
            if act_kind != "none" and act_lbl != "" {
                r_kids.push(ui.button(act_lbl, (_ev) => tc.run_tool_action(act_arg), "secondary", {
                    "cls": "cc-sm", "disabled": busy and act_kind == "install"
                }));
            }
            rec_rows.push(ui.row(r_kids, {
                "cls": "cc-rec-item", "key": "wrec-" + r_id
            }));
            lim += 1;
        }
        body.push(ui.card([ui.row([ui.row([ico.alert()], {
            "cls": "cc-icon-box warn"
        }), ui.column([ui.title("Recommended Downloads & SDK Setup"), ui.caption(
            string(recs.len()) + " item(s) missing or awaiting setup across iOS / Android."
        ),], {
            "flex": 1
        }), ui.button("Open Downloads & SDKs", (_ev) => nav.replace("Doctor"), "primary", {
            "cls": "cc-sm"
        }),], {
            "gap": 10
        }), ui.spacer(4), ui.column(rec_rows, {
            "gap": 6
        }),], {
            "cls": "cc-rec-banner"
        }));
    }

    // 4. 2-Column Workspace Grid (Project Card + New App & Quick Launch)
    let chips = [];
    for p in projects {
        let ps = string(p);
        chips.push(ui.chip(ps, (_ev) => select_project(ps), ps == active));
    }

    let build_badges = [];
    if info["built_web"] == true {
        build_badges.push(ui.badge("Web / PWA Built", "success"));
    }
    if info["built_desktop"] == true {
        build_badges.push(ui.badge("Desktop Exe Built", "success"));
    }
    if info["built_android"] == true {
        build_badges.push(ui.badge("Android Gradle Built", "success"));
    }
    if info["built_ipa"] == true {
        build_badges.push(ui.badge("Signed iOS .ipa", "success"));
    } elif info["built_ios"] == true {
        build_badges.push(ui.badge("iOS SwiftPM Built", "primary"));
    }
    if build_badges.len() == 0 {
        build_badges.push(ui.badge("No target builds yet", "accent"));
    }

    let vstat = model.check_vendor_update_status(active);
    if vstat["needs_update"] == true {
        build_badges.push(ui.badge("Vendor Update Available", "accent"));
    } else {
        build_badges.push(
            ui.badge("Framework v" + model.STUDIO_VERSION + " Synced", "primary")
        );
    }

    let left_card = ui.card([ui.row([ui.title("Project Workspace"), ui.flex_spacer(), ui.button("Edit Code ->", (_ev) => nav.replace("Editor"), "secondary", {
        "cls": "cc-sm"
    }), ui.button("Refresh", (_ev) => {
        state.set("projects", jobs.discover_projects());
        state.set("proj_info", jobs.project_info(active));
    }, "ghost", {
        "cls": "cc-sm"
    }),]), ui.caption(
        "Switch between projects in workspace/ or examples/, or load any project directory."
    ), ui.spacer(4), ui.row(chips, {
        "gap": 6, "wrap": true
    }), ui.spacer(6), ui.row([ui.input("Custom project path...", (_ev) => {
        state.set("custom_project_input", string(_ev["value"]));
    }, string(state.get_or("custom_project_input", active)), "text", {
        "flex": 1
    }), ui.button("Load Path", (_ev) => {
        let cp = string(state.get_or("custom_project_input", "")).trim();
        if is_dir(cp) {
            ctrl.register_custom_project(cp);
        } else {
            state.set("toast_msg", "Directory not found: " + cp);
        }
    }, "secondary"),], {
        "gap": 8
    }), ui.spacer(6), ui.row([ui.column(
        [
        ui.caption("BUNDLE IDENTIFIER"),
        ui.text(string(info["bundle_id"]), "mono"),
        ]
    ), ui.column([ui.caption("ENTRY / ASSETS"), ui.text(string(info["entry"]) + (if info["has_assets"] == true {
        "  + assets/"
    } else {
        ""
    }), "mono"),]),], {
        "cls": "cc-meta-grid"
    }), ui.spacer(6), ui.row(build_badges, {
        "gap": 6, "wrap": true
    }), ui.divider(), ui.row([ui.button("Compile & Check", (_ev) => ctrl.compile_and_diagnose_project(active), "primary", {
        "cls": "cc-sm", "disabled": busy
    }), ui.button("Auto-Recover", (_ev) => ctrl.trigger_auto_recovery(active), "secondary", {
        "cls": "cc-sm", "disabled": busy
    }), ui.button("Upgrade Runtime", (_ev) => {
        let tgt = string(state.get_or("active_project", "workspace/demo"));
        jobs.run_async("Upgrade Vendor: " + tgt, () => {
            let m = jobs.run_studio_cli(["upgrade", tgt]);
            jobs.append_exec_logs(m);
            state.set("vendor_status", model.check_vendor_update_status(tgt));
            return int(m["code"]) == 0;
        });
    }, "secondary", {
        "cls": "cc-sm", "disabled": busy
    }), ui.button("Clean Build", (_ev) => {
        let tgt = string(state.get_or("active_project", "workspace/demo"));
        jobs.run_async("Clean Build: " + tgt, () => {
            let m = jobs.run_studio_cli(["clean", tgt]);
            jobs.append_exec_logs(m);
            state.set("proj_info", jobs.project_info(tgt));
            return int(m["code"]) == 0;
        });
    }, "outline", {
        "cls": "cc-sm", "disabled": busy
    }),], {
        "gap": 6, "wrap": true
    }),]);

    let right_col = ui.column([ui.card([ui.title("Create New Project in workspace/"), ui.caption(
        "Scaffolds a new project inside workspace/<AppName> with vendored studio/ runtime and studio.json."
    ), ui.spacer(6), ui.form([ui.column([ui.input("App Name (e.g. FinancePro)", (_ev) => {
        state.set("new_app_name", string(_ev["value"]));
    }, string(state.get_or("new_app_name", "")), "text"), ui.row([ui.input("Target directory (defaults to workspace/<AppName>)", (_ev) => {
        state.set("new_app_dir", string(_ev["value"]));
    }, string(state.get_or("new_app_dir", "")), "text", {
        "flex": 1
    }), ui.button("Create Project", on_create_app, "primary", {
        "disabled": busy
    }),], {
        "gap": 8
    }),], {
        "gap": 8
    }),], on_create_app),]), ui.card([ui.row([ui.title("Quick Launch & Workflow"), ui.flex_spacer(), ui.button("All 6 Platforms ->", (_ev) => nav.replace("Platforms"), "ghost", {
        "cls": "cc-sm"
    }),]), ui.caption(
        "Run, edit, debug, or deploy " + string(info["name"]) + " across Desktop, Web, iOS, and Android."
    ), ui.spacer(6), ui.grid([ui.button(
        "Desktop Window",
        (_ev) => jobs.launch_native_preview(active),
        "primary"
    ), ui.button("Code & Debugger", (_ev) => nav.replace("Editor"), "secondary"), ui.button("Phone Wi-Fi Server", (_ev) => {
        let h = string(state.get_or("web_host", "0.0.0.0"));
        let p = string(state.get_or("web_port", "8080"));
        jobs.start_web_server(active, h, p);
        nav.replace("Platforms");
    }, "secondary"), ui.button("Install iPhone .ipa", (_ev) => {
        jobs.run_async("Install iOS .ipa: " + active, () => {
            let m = jobs.run_studio_cli(["ios", "run", active]);
            jobs.append_exec_logs(m);
            state.set("proj_info", jobs.project_info(active));
            return int(m["code"]) == 0;
        });
    }, "outline", {
        "disabled": busy
    }),], 2, 8),]),], {
        "gap": 16
    });

    body.push(ui.row([left_card, right_col], {
        "cls": "cc-2col"
    }));

    return shell.render_shell(
        "Workspace",
        "Spid3r Studio Workspace",
        "A–Z 5-Tier Architecture: Frameworks, Downloads, Documents, Workspace, and Core MVC Tools.",
        body
    );
}
