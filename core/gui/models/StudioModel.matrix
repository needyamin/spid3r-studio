}

public fn load_doc_content(path: string) -> string {
    let r = read_file(path);
    if r.is_err() {
        return "Document not found: " + path;
    }
    return string(r.unwrap());
}

public fn list_extensions() -> list {
    return plugins.core_extensions();
}
