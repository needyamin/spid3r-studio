    return [
    {
        "id": "getting-started",
        "title": "Getting Started & A–Z Architecture",
        "category": "Guide",
        "path": "documents/guides/getting-started.md",
    }
    ,
    {
        "id": "dev-workflow",
        "title": "Development Workflow & Release Guide",
        "category": "Guide",
        "path": "documents/guides/development-workflow.md",
    }
    ,
    {
        "id": "matrix-tutorial",
        "title": "Spid3r v" + SPID3R_TARGET_VER + " & .matrix Authoring Tutorial",
        "category": "Tutorial",
        "path": "documents/tutorials/matrix-language-tutorial.md",
    }
    ,
    {
        "id": "config-reference",
        "title": "studio.json & CLI Reference",
        "category": "Reference",
        "path": "documents/references/configuration-reference.md",
    }
