// gui/Icons.matrix
// Clean inline SVG vector icons for AppStudio Control Center.

import "studio/Components" as ui;

fn svg(d: string, size: int = 16) -> map {
    let sz = string(size);
    let raw = r#"<svg width=""# + sz + r#"" height=""# + sz + r#"" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">"# + d + r#"</svg>"#;
    return ui.html(raw);
}

public fn logo() -> map {
    return svg(
        r#"<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>"#,
        18
    );
}

public fn workspace() -> map {
    return svg(
        r#"<path d="M3 7a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>"#,
        16
    );
}

public fn platforms() -> map {
    return svg(
        r#"<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>"#,
        16
    );
}

public fn tests() -> map {
    return svg(
        r#"<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>"#,
