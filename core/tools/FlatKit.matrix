// tools/FlatKit.matrix
// Scope-aware single-pass wasm/mobile bundler for AppStudio.
// Walks app + framework module imports recursively, prefixes top-level
// functions/classes/interfaces/enums/globals per module while keeping class
// methods and fields intact, enforces module visibility and collision safety,
// handles brace-less arrow scopes cleanly, rewrites alias-qualified exports
// (including inside string interpolations), and appends the wasm driver.

let last_bundle_error = "";
let last_line_map = [];

/// Most recent FlatKit bundler error message, or "" on success.
public fn last_error() -> string {
    return last_bundle_error;
}

/// Line map from the most recent bundle() / bundle_entry() call (A-24).
/// Each entry has {file, mod_id, start_line, end_line}.
public fn line_map() -> list {
    let out = [];
    for item in last_line_map {
        out.push({
            "file": item["file"],
            "mod_id": item["mod_id"],
            "start_line": item["start_line"],
            "end_line": item["end_line"],
        });
    }
    return out;
}

/// Map a 1-based line number in the flattened bundle back to original {file, mod_id, line, flat_line} (A-24).
public fn map_line(flat_line: int) -> map {
    if flat_line <= 0 {
        return {
        };
    }
    for item in last_line_map {
        let s = int(item["start_line"]);
        let e = int(item["end_line"]);
        if flat_line >= s and flat_line <= e {
            return {
                "file": item["file"],
                "mod_id": item["mod_id"],
                "line": flat_line - s + 1,
                "flat_line": flat_line,
            };
        }
    }
    return {
    };
}

fn count_newlines(s: string) -> int {
    let n = 0;
    let i = 0;
    let sl = s.len();
    while i < sl {
        if s[i] == "\n" {
            n += 1;
        }
        i += 1;
    }
    return n;
}

fn norm_slash(p: string) -> string {
    let t = string(p).replace("\\", "/");
    while t.len() > 1 and t.ends_with("/") {
        t = t.slice(0, t.len() - 1);
    }
    return t;
}

fn dir_of(p: string) -> string {
    let t = norm_slash(p);
    let parts = t.split("/");
    if parts.len() <= 1 {
        if t.starts_with("/") {
            return "/";
        }
        return ".";
    }
    let last = string(parts[parts.len() - 1]);
    return t.slice(0, t.len() - last.len() - 1);
}

fn join_p(a: string, b: string) -> string {
    let ta = norm_slash(a);
    let tb = norm_slash(b);
    if ta == "" or ta == "." {
        return tb;
    }
    if ta == "/" {
        return "/" + tb;
    }
    return ta + "/" + tb;
}

/// Normalize relative segments like "pages/../lib/A.matrix".
fn clean_path(p: string) -> string {
    let t = norm_slash(p);
    let leading_slash = t.starts_with("/");
    let parts = t.split("/");
    let stack = [];
    for raw in parts {
        let seg = string(raw);
        if seg == "" or seg == "." {
            continue;
        }
        if seg == ".." and stack.len() > 0 and string(stack[stack.len() - 1]) != ".." {
            stack.pop();
            continue;
        }
        stack.push(seg);
    }
    let res = stack.join("/");
    if leading_slash {
        return "/" + res;
    }
    if res == "" {
        return ".";
    }
    return res;
}

fn basename_no_ext(p: string) -> string {
    let t = norm_slash(p);
    let parts = t.split("/");
    let f = string(parts[parts.len() - 1]);
    if f.ends_with(".matrix") {
        return f.slice(0, f.len() - 7);
    }
    if f.ends_with(".mt") {
        return f.slice(0, f.len() - 3);
    }
    return f;
}

const STDLIB_MODULES = [
"assert", "bigint", "complex", "decimal", "event", "fastcgi", "ftp",
"gen", "http", "mathx", "middleware", "mock", "multipart", "rational",
"semver", "session", "smtp", "stats", "testkit", "toml", "tz",
"unicode", "uuid", "web", "xml", "yaml",
];

fn is_stdlib_module(raw_path: string) -> bool {
    let rp = norm_slash(raw_path);
    if rp.contains("/") or rp.ends_with(".matrix") or rp.ends_with(".mt") {
        return false;
    }
    for m in STDLIB_MODULES {
        if rp == m {
            return true;
        }
    }
    return false;
}

fn sanitize_mod_id(raw: string) -> string {
    let out = "";
    let s = string(raw);
    let i = 0;
    while i < s.len() {
        let c = s[i];
        if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9") or c == "_" {
            out += c;
        } else {
            out += "_";
        }
        i += 1;
    }
    if out == "" {
        return "mod";
    }
    return out;
}

const ASCII_TABLE = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
const HEX_DIGITS = "0123456789abcdef";

/// Deterministic 8-hex-char hash of a canonical path for collision disambiguation.
fn hash_path(raw: string) -> string {
    let s = string(raw);
    let h = 216613626;
    let i = 0;
    while i < s.len() {
        let idx = ASCII_TABLE.index_of(s[i]);
        let code = if idx >= 0 {
            idx + 32
        } else {
            127 + (i % 97)
        };
        h = ((h * 131) + code) % 2147483647;
        i += 1;
    }
    let out = "";
    let v = h;
    let d = 0;
    while d < 8 {
        out = HEX_DIGITS[v % 16] + out;
        v = v / 16;
        d += 1;
    }
    return out;
}

fn read_or_fail(path: string) -> string {
    let r = read_file(path);
    if r.is_err() {
        return "";
    }
    return string(r.unwrap());
}

fn is_ident_start(c: string) -> bool {
    return (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_";
}

fn is_ident_cont(c: string) -> bool {
    return is_ident_start(c) or (c >= "0" and c <= "9");
}

fn is_digit(c: string) -> bool {
    return c >= "0" and c <= "9";
}

fn is_ws(c: string) -> bool {
    return c == " " or c == "\t" or c == "\r" or c == "\n";
}

/// Lex Spid3r source into {"kind", "text"} tokens.
public fn tokenize(src: string) -> list {
    let toks = [];
    let n = src.len();
    let i = 0;
    while i < n {
        let c = src[i];
        // whitespace
        if is_ws(c) {
            let j = i + 1;
            while j < n and is_ws(src[j]) {
                j += 1;
            }
            toks.push({
                "kind": "ws", "text": src.slice(i, j)
            });
            i = j;
            continue;
        }
        // line comment
        if c == "/" and i + 1 < n and src[i + 1] == "/" {
            let j = i + 2;
            while j < n and src[j] != "\n" {
                j += 1;
            }
            toks.push({
                "kind": "comment", "text": src.slice(i, j)
            });
            i = j;
            continue;
        }
        // block comment
        if c == "/" and i + 1 < n and src[i + 1] == "*" {
            let j = i + 2;
            while j + 1 < n and not (src[j] == "*" and src[j + 1] == "/") {
                j += 1;
            }
            if j + 1 < n {
                j += 2;
            } else {
                j = n;
            }
            toks.push({
                "kind": "comment", "text": src.slice(i, j)
            });
            i = j;
            continue;
        }
        // raw string literal: r"..." or r#"..."#
        if c == "r" and i + 1 < n and (src[i + 1] == "\"" or src[i + 1] == "#") {
            let hashes = 0;
            let k = i + 1;
            while k < n and src[k] == "#" {
                hashes += 1;
                k += 1;
            }
            if k < n and src[k] == "\"" {
                let j = k + 1;
                while j < n {
                    if src[j] == "\"" {
                        let matched = true;
                        let h = 0;
                        while h < hashes {
                            if j + 1 + h >= n or src[j + 1 + h] != "#" {
                                matched = false;
                                break;
                            }
                            h += 1;
                        }
                        if matched {
                            j = j + 1 + hashes;
                            break;
                        }
                    }
                    j += 1;
                }
                toks.push({
                    "kind": "rawstr", "text": src.slice(i, j)
                });
                i = j;
                continue;
            }
        }
        // standard string literal with escapes and same-line brace-balanced { ... } interpolation
        if c == "\"" {
            let j = i + 1;
            while j < n {
                let ch = src[j];
                if ch == "\\" and j + 1 < n {
                    j += 2;
                    continue;
                }
                if ch == "\"" {
                    j += 1;
                    break;
                }
                if ch == "{" and j + 1 < n and src[j + 1] != "\"" {
                    let k = j + 1;
                    let depth = 1;
                    let hit_eol = false;
                    while k < n and depth > 0 {
                        let ic = src[k];
                        if ic == "\n" {
                            hit_eol = true;
                            break;
                        }
                        if ic == "\\" and k + 1 < n {
                            k += 2;
                            continue;
                        }
                        if ic == "\"" {
                            k += 1;
                            while k < n and src[k] != "\n" {
                                if src[k] == "\\" and k + 1 < n {
                                    k += 2;
                                    continue;
                                }
                                if src[k] == "\"" {
                                    k += 1;
                                    break;
                                }
                                k += 1;
                            }
                            continue;
                        }
                        if ic == "{" {
                            depth += 1;
                        } elif ic == "}" {
                            depth -= 1;
                        }
                        k += 1;
                    }
                    if not hit_eol and depth == 0 {
                        j = k;
                        continue;
                    }
                }
                j += 1;
            }
            toks.push({
                "kind": "str", "text": src.slice(i, j)
            });
            i = j;
            continue;
        }
        // identifier
        if is_ident_start(c) {
            let j = i + 1;
            while j < n and is_ident_cont(src[j]) {
                j += 1;
            }
            toks.push({
                "kind": "ident", "text": src.slice(i, j)
            });
            i = j;
            continue;
        }
        // number
        if is_digit(c) {
            let j = i + 1;
            while j < n and (is_ident_cont(src[j]) or src[j] == ".") {
                j += 1;
            }
            toks.push({
                "kind": "num", "text": src.slice(i, j)
            });
            i = j;
            continue;
        }
        // two-char arrow =>
        if c == "=" and i + 1 < n and src[i + 1] == ">" {
            toks.push({
                "kind": "punct", "text": "=>"
            });
            i += 2;
            continue;
        }
        toks.push({
            "kind": "punct", "text": c
        });
        i += 1;
    }
    return toks;
}

fn next_sig(toks: list, idx: int) -> int {
    let i = idx;
    let n = toks.len();
    while i < n {
        let k = string(toks[i]["kind"]);
        if k != "ws" and k != "comment" {
            return i;
        }
        i += 1;
    }
    return -1;
}

fn unquote_str(lit: string) -> string {
    if lit.len() < 2 {
        return lit;
    }
    return lit.slice(1, lit.len() - 1);
}

/// Analyze module tokens for imports and top-level declarations (brace_depth == 0).
fn analyze_module(toks: list, mod_id: string, is_entry: bool) -> map {
    let imports = [];
    let locals = {
    };
    let exports = {
    };
    let privates = {
    };
    let n = toks.len();
    let depth = 0;
    let saw_public = false;
    let i = 0;
    while i < n {
        let tok = toks[i];
        let kind = string(tok["kind"]);
        let text = string(tok["text"]);
        if kind == "ws" or kind == "comment" {
            i += 1;
            continue;
        }
        if kind == "punct" {
            if text == "{" {
                depth += 1;
                saw_public = false;
            } elif text == "}" and depth > 0 {
                depth -= 1;
                if depth == 0 {
                    saw_public = false;
                }
            } elif depth == 0 and text == ";" {
                saw_public = false;
            }
            i += 1;
            continue;
        }
        if depth == 0 and kind == "ident" {
            if text == "public" {
                saw_public = true;
                i += 1;
                continue;
            }
            if text == "private" {
                saw_public = false;
                i += 1;
                continue;
            }
            if text == "import" {
                saw_public = false;
                let p_idx = next_sig(toks, i + 1);
                if p_idx >= 0 and string(toks[p_idx]["kind"]) == "str" {
                    let raw_path = unquote_str(string(toks[p_idx]["text"]));
                    let alias = basename_no_ext(raw_path);
                    let cur = next_sig(toks, p_idx + 1);
                    if cur >= 0 and string(toks[cur]["kind"]) == "ident" and string(toks[cur]["text"]) == "as" {
                        let a_idx = next_sig(toks, cur + 1);
                        if a_idx >= 0 and string(toks[a_idx]["kind"]) == "ident" {
                            alias = string(toks[a_idx]["text"]);
                            cur = next_sig(toks, a_idx + 1);
                        }
                    }
                    let end_idx = cur;
                    if end_idx < 0 {
                        end_idx = n - 1;
                    }
                    while end_idx < n and string(toks[end_idx]["text"]) != ";" {
                        end_idx += 1;
                    }
                    if end_idx >= n {
                        end_idx = n - 1;
                    }
                    imports.push({
                        "kind": "ns",
                        "path": raw_path,
                        "alias": alias,
                        "named": [],
                        "start": i,
                        "end": end_idx,
                    });
                    i = end_idx + 1;
                    continue;
                } elif p_idx >= 0 and string(toks[p_idx]["text"]) == "{" {
                    let named_list = [];
                    let cur = next_sig(toks, p_idx + 1);
                    while cur >= 0 and string(toks[cur]["text"]) != "}" {
                        if string(toks[cur]["kind"]) == "ident" {
                            let orig_n = string(toks[cur]["text"]);
                            let local_n = orig_n;
                            let nxt = next_sig(toks, cur + 1);
                            if nxt >= 0 and string(toks[nxt]["kind"]) == "ident" and string(toks[nxt]["text"]) == "as" {
                                let as_idx = next_sig(toks, nxt + 1);
                                if as_idx >= 0 and string(toks[as_idx]["kind"]) == "ident" {
                                    local_n = string(toks[as_idx]["text"]);
                                    cur = next_sig(toks, as_idx + 1);
                                } else {
                                    cur = nxt;
                                }
                            } else {
                                cur = nxt;
                            }
                            named_list.push({
                                "orig": orig_n, "local": local_n
                            });
                            if cur >= 0 and string(toks[cur]["text"]) == "," {
                                cur = next_sig(toks, cur + 1);
                            }
                        } else {
                            cur = next_sig(toks, cur + 1);
                        }
                    }
                    let from_idx = if cur >= 0 {
                        next_sig(toks, cur + 1)
                    } else {
                        -1
                    };
                    let raw_path = "";
                    let end_idx = cur;
                    if from_idx >= 0 and string(toks[from_idx]["kind"]) == "ident" and string(toks[from_idx]["text"]) == "from" {
                        let s_idx = next_sig(toks, from_idx + 1);
                        if s_idx >= 0 and string(toks[s_idx]["kind"]) == "str" {
                            raw_path = unquote_str(string(toks[s_idx]["text"]));
                            end_idx = next_sig(toks, s_idx + 1);
                        }
                    }
                    if end_idx < 0 {
                        end_idx = n - 1;
                    }
                    while end_idx < n and string(toks[end_idx]["text"]) != ";" {
                        end_idx += 1;
                    }
                    if end_idx >= n {
                        end_idx = n - 1;
                    }
                    if raw_path != "" {
                        imports.push({
                            "kind": "named",
                            "path": raw_path,
                            "alias": "",
                            "named": named_list,
                            "start": i,
                            "end": end_idx,
                        });
                    }
                    i = end_idx + 1;
                    continue;
                }
            } elif text == "fn" {
                let n_idx = next_sig(toks, i + 1);
                if n_idx >= 0 and string(toks[n_idx]["kind"]) == "ident" {
                    let fname = string(toks[n_idx]["text"]);
                    if not (is_entry and (fname == "studio_app" or fname == "main")) {
                        let pfx = "pub_" + mod_id + "_" + fname;
                        locals[fname] = pfx;
                        if saw_public {
                            exports[fname] = pfx;
                        } else {
                            privates[fname] = pfx;
                        }
                    }
                    saw_public = false;
                    i = n_idx + 1;
                    continue;
                }
            } elif text == "class" {
                let c_idx = next_sig(toks, i + 1);
                if c_idx >= 0 and string(toks[c_idx]["kind"]) == "ident" {
                    let cname = string(toks[c_idx]["text"]);
                    let cpfx = "cls_" + mod_id + "_" + cname;
                    locals[cname] = cpfx;
                    if saw_public {
                        exports[cname] = cpfx;
                    } else {
                        privates[cname] = cpfx;
                    }
                    saw_public = false;
                    i = c_idx + 1;
                    continue;
                }
            } elif text == "interface" {
                let if_idx = next_sig(toks, i + 1);
                if if_idx >= 0 and string(toks[if_idx]["kind"]) == "ident" {
                    let iname = string(toks[if_idx]["text"]);
                    let ipfx = "iface_" + mod_id + "_" + iname;
                    locals[iname] = ipfx;
                    if saw_public {
                        exports[iname] = ipfx;
                    } else {
                        privates[iname] = ipfx;
                    }
                    saw_public = false;
                    i = if_idx + 1;
                    continue;
                }
            } elif text == "enum" {
                let en_idx = next_sig(toks, i + 1);
                if en_idx >= 0 and string(toks[en_idx]["kind"]) == "ident" {
                    let ename = string(toks[en_idx]["text"]);
                    let epfx = "enum_" + mod_id + "_" + ename;
                    locals[ename] = epfx;
                    if saw_public {
                        exports[ename] = epfx;
                    } else {
                        privates[ename] = epfx;
                    }
                    saw_public = false;
                    i = en_idx + 1;
                    continue;
                }
            } elif text == "let" or text == "const" {
                let v_idx = next_sig(toks, i + 1);
                if v_idx >= 0 and string(toks[v_idx]["kind"]) == "ident" {
                    let vname = string(toks[v_idx]["text"]);
                    if vname != "_" {
                        let vpfx = "mod_" + mod_id + "_" + vname;
                        locals[vname] = vpfx;
                        if saw_public {
                            exports[vname] = vpfx;
                        } else {
                            privates[vname] = vpfx;
                        }
                    }
                    saw_public = false;
                    i = v_idx + 1;
                    continue;
                }
            }
        }
        i += 1;
    }
    return {
        "imports": imports,
        "locals": locals,
        "exports": exports,
        "privates": privates,
        "mod_id": mod_id,
    };
}

fn is_shadowed(scopes: list, name: string) -> bool {
    let k = scopes.len() - 1;
    while k >= 0 {
        if scopes[k].has(name) {
            return true;
        }
        k -= 1;
    }
    return false;
}

fn list_has_str(xs: list, name: string) -> bool {
    for x in xs {
        if string(x) == name {
            return true;
        }
    }
    return false;
}

fn in_class_body(class_depths: list, depth: int) -> bool {
    if class_depths.len() == 0 {
        return false;
    }
    return int(class_depths[class_depths.len() - 1]) == depth;
}

fn pop_arrow_scopes(
    scopes: list,
    arrow_expr_scopes: list,
    paren_depth: int,
    depth: int,
    bracket_depth: int
) {
    while arrow_expr_scopes.len() > 0 {
        let top = arrow_expr_scopes[arrow_expr_scopes.len() - 1];
        if int(top["paren"]) == paren_depth and int(top["brace"]) == depth and int(top["bracket"]) == bracket_depth {
            arrow_expr_scopes.pop();
            if scopes.len() > 0 {
                scopes.pop();
            }
        } else {
            break;
        }
    }
}

fn flush_deferred_lets(
    scopes: list,
    deferred_lets: list,
    paren_depth: int,
    depth: int,
    bracket_depth: int
) {
    while deferred_lets.len() > 0 {
        let top = deferred_lets[deferred_lets.len() - 1];
        if int(top["paren"]) == paren_depth and int(top["brace"]) == depth and int(top["bracket"]) == bracket_depth {
            deferred_lets.pop();
            if scopes.len() > 0 {
                scopes[scopes.len() - 1][string(top["name"])] = true;
            }
        } else {
            break;
        }
    }
}

/// Extract parameter identifiers inside (...) starting at open_idx.
fn collect_paren_params(toks: list, open_idx: int) -> list {
    let params = [];
    if open_idx < 0 or open_idx >= toks.len() or string(toks[open_idx]["text"]) != "(" {
        return params;
    }
    let pdepth = 0;
    let bdepth = 0;
    let cdepth = 0;
    let expect_param = true;
    let i = open_idx;
    let n = toks.len();
    while i < n {
        let kind = string(toks[i]["kind"]);
        let text = string(toks[i]["text"]);
        if kind == "ws" or kind == "comment" {
            i += 1;
            continue;
        }
        if text == "(" {
            pdepth += 1;
            i += 1;
            continue;
        }
        if text == ")" {
            pdepth -= 1;
            if pdepth == 0 {
                break;
            }
            i += 1;
            continue;
        }
        if text == "[" {
            bdepth += 1;
            i += 1;
            continue;
        }
        if text == "]" and bdepth > 0 {
            bdepth -= 1;
            i += 1;
            continue;
        }
        if text == "{" {
            cdepth += 1;
            i += 1;
            continue;
        }
        if text == "}" and cdepth > 0 {
            cdepth -= 1;
            i += 1;
            continue;
        }
        if pdepth == 1 and bdepth == 0 and cdepth == 0 {
            if text == "," {
                expect_param = true;
            } elif expect_param and kind == "ident" {
                if text != "self" {
                    params.push(text);
                }
                expect_param = false;
            }
        }
        i += 1;
    }
    return params;
}

/// Find matching ')' for '(' at open_idx, or -1.
fn match_paren(toks: list, open_idx: int) -> int {
    let d = 0;
    let i = open_idx;
    let n = toks.len();
    while i < n {
        let t = string(toks[i]["text"]);
        if string(toks[i]["kind"]) == "punct" {
            if t == "(" {
                d += 1;
            } elif t == ")" {
                d -= 1;
                if d == 0 {
                    return i;
                }
            }
        }
        i += 1;
    }
    return -1;
}

/// True if `idx` starts a guarded match-arm suffix `if <cond> => ...` before `{`, `}`, `;`, or `,`.
fn has_match_guard_arrow(toks: list, idx: int) -> bool {
    if idx < 0 or idx >= toks.len() or string(toks[idx]["text"]) != "if" {
        return false;
    }
    let pd = 0;
    let bd = 0;
    let i = idx + 1;
    let n = toks.len();
    while i < n {
        let k = string(toks[i]["kind"]);
        let t = string(toks[i]["text"]);
        if k == "ws" or k == "comment" {
            i += 1;
            continue;
        }
        if t == "(" {
            pd += 1;
        } elif t == ")" {
            if pd == 0 {
                return false;
            }
            pd -= 1;
        } elif t == "[" {
            bd += 1;
        } elif t == "]" {
            if bd > 0 {
                bd -= 1;
            }
        } elif pd == 0 and bd == 0 {
            if t == "=>" {
                return true;
            }
            if t == "{" or t == "}" or t == ";" or t == "," {
                return false;
            }
        }
        i += 1;
    }
    return false;
}

/// Skip optional generic type parameter list <...> starting at lt_idx, returning index after '>'.
fn skip_generics(toks: list, lt_idx: int) -> int {
    if lt_idx < 0 or lt_idx >= toks.len() or string(toks[lt_idx]["text"]) != "<" {
        return lt_idx;
    }
    let d = 0;
    let i = lt_idx;
    let n = toks.len();
    while i < n {
        let t = string(toks[i]["text"]);
        if string(toks[i]["kind"]) == "punct" {
            if t == "<" {
                d += 1;
            } elif t == ">" {
                d -= 1;
                if d == 0 {
                    return next_sig(toks, i + 1);
                }
            }
        }
        i += 1;
    }
    return lt_idx;
}

fn rewrite_str_token(
    lit: string,
    locals: map,
    alias_exports: map,
    alias_privates: map,
    named_exports: map,
    named_privates: map,
    stdlib_aliases: map,
    scopes: list,
    mod_id: string,
    errors: list
) -> string {
    if lit.len() < 2 or not lit.contains("{") {
        return lit;
    }
    let inner = lit.slice(1, lit.len() - 1);
    let out = ["\""];
    let n = inner.len();
    let i = 0;
    while i < n {
        let c = inner[i];
        if c == "\\" and i + 1 < n {
            out.push(inner.slice(i, i + 2));
            i += 2;
            continue;
        }
        if c == "{" and i + 1 < n and inner[i + 1] != "\"" {
            let j = i + 1;
            let depth = 1;
            let hit_eol = false;
            while j < n and depth > 0 {
                let ic = inner[j];
                if ic == "\n" {
                    hit_eol = true;
                    break;
                }
                if ic == "\\" and j + 1 < n {
                    j += 2;
                    continue;
                }
                if ic == "\"" {
                    j += 1;
                    while j < n and inner[j] != "\n" {
                        if inner[j] == "\\" and j + 1 < n {
                            j += 2;
                            continue;
                        }
                        if inner[j] == "\"" {
                            j += 1;
                            break;
                        }
                        j += 1;
                    }
                    continue;
                }
                if ic == "{" {
                    depth += 1;
                } elif ic == "}" {
                    depth -= 1;
                }
                j += 1;
            }
            if not hit_eol and depth == 0 {
                let expr = inner.slice(i + 1, j - 1);
                let etoks = tokenize(expr);
                let rew = emit_tokens(
                    etoks,
                    [],
                    locals,
                    alias_exports,
                    alias_privates,
                    named_exports,
                    named_privates,
                    stdlib_aliases,
                    scopes,
                    1,
                    mod_id,
                    errors
                );
                out.push("{");
                out.push(rew);
                out.push("}");
                i = j;
                continue;
            }
        }
        out.push(c);
        i += 1;
    }
    out.push("\"");
    return out.join("");
}

/// Scope-aware single-pass token rewriter (imports stripped, locals & aliases prefixed,
/// brace-less arrows, class/interface fields & methods, and visibility respected).
fn emit_tokens(
    toks: list,
    imports: list,
    locals: map,
    alias_exports: map,
    alias_privates: map,
    named_exports: map,
    named_privates: map,
    stdlib_aliases: map,
    base_scopes: list,
    start_depth: int,
    mod_id: string,
    errors: list
) -> string {
    let skip_ranges = {
    };
    for imp in imports {
        skip_ranges[string(imp["start"])] = int(imp["end"]);
    }
    let scopes = [];
    for sc in base_scopes {
        scopes.push(sc);
    }
    let arrow_expr_scopes = [];
    let deferred_lets = [];
    let class_depths = [];
    let enum_depths = [];
    let out = [];
    let depth = start_depth;
    let paren_depth = 0;
    let bracket_depth = 0;
    let prev_sig = "";
    let prev_word = "";
    let block_pending_params = [];
    let block_paren_end = -1;
    let arrow_pending_params = [];
    let arrow_paren_end = -1;
    let let_pending_params = [];
    let let_paren_end = -1;
    let loop_var_idx = -1;
    let let_decl_idx = -1;
    let in_type_hdr = false;
    let in_enum_hdr = false;
    let discard_seq = 0;
    let i = 0;
    let n = toks.len();

    while i < n {
        if skip_ranges.has(string(i)) {
            let end_i = int(skip_ranges[string(i)]);
            let j_skip = i;
            while j_skip <= end_i {
                let nl_s = count_newlines(string(toks[j_skip]["text"]));
                let k_nl = 0;
                while k_nl < nl_s {
                    out.push("\n");
                    k_nl += 1;
                }
                j_skip += 1;
            }
            i = end_i + 1;
            while i < n and string(toks[i]["kind"]) == "ws" {
                let ws_txt = string(toks[i]["text"]);
                let nl_w = count_newlines(ws_txt);
                if nl_w > 0 {
                    let k_nw = 0;
                    while k_nw < nl_w {
                        out.push("\n");
                        k_nw += 1;
                    }
                    i += 1;
                    break;
                }
                i += 1;
            }
            prev_sig = ";";
            prev_word = ";";
            continue;
        }

        let tok = toks[i];
        let kind = string(tok["kind"]);
        let text = string(tok["text"]);

        if kind == "ws" or kind == "comment" {
            out.push(text);
            i += 1;
            continue;
        }

        if kind == "rawstr" or kind == "num" {
            out.push(text);
            prev_sig = kind;
            prev_word = kind;
            i += 1;
            continue;
        }

        if kind == "str" {
            out.push(
                rewrite_str_token(
                    text,
                    locals,
                    alias_exports,
                    alias_privates,
                    named_exports,
                    named_privates,
                    stdlib_aliases,
                    scopes,
                    mod_id,
                    errors
                )
            );
            prev_sig = "str";
            prev_word = "str";
            i += 1;
            continue;
        }

        if kind == "punct" {
            if text == ";" or text == "," {
                pop_arrow_scopes(scopes, arrow_expr_scopes, paren_depth, depth, bracket_depth);
                if text == ";" {
                    flush_deferred_lets(scopes, deferred_lets, paren_depth, depth, bracket_depth);
                    if paren_depth == 0 {
                        block_pending_params = [];
                        block_paren_end = -1;
                        arrow_pending_params = [];
                        arrow_paren_end = -1;
                        let_pending_params = [];
                        let_paren_end = -1;
                        loop_var_idx = -1;
                        let_decl_idx = -1;
                    }
                }
            } elif text == "(" {
                paren_depth += 1;
                let close_i = match_paren(toks, i);
                if close_i >= 0 {
                    let after = next_sig(toks, close_i + 1);
                    if after >= 0 and (
                        string(toks[after]["text"]) == "=>" or has_match_guard_arrow(toks, after)
                    ) {
                        arrow_pending_params = collect_paren_params(toks, i);
                        arrow_paren_end = close_i;
                    }
                }
            } elif text == ")" {
                pop_arrow_scopes(scopes, arrow_expr_scopes, paren_depth, depth, bracket_depth);
                if paren_depth > 0 {
                    paren_depth -= 1;
                }
            } elif text == "[" {
                bracket_depth += 1;
            } elif text == "]" {
                pop_arrow_scopes(scopes, arrow_expr_scopes, paren_depth, depth, bracket_depth);
                if bracket_depth > 0 {
                    bracket_depth -= 1;
                }
            } elif text == "=>" {
                let nxt_after = next_sig(toks, i + 1);
                if not (nxt_after >= 0 and string(toks[nxt_after]["text"]) == "{") {
                    let asc = {
                    };
                    for pp in arrow_pending_params {
                        asc[string(pp)] = true;
                    }
                    arrow_pending_params = [];
                    arrow_paren_end = -1;
                    scopes.push(asc);
                    arrow_expr_scopes.push({
                        "paren": paren_depth, "brace": depth, "bracket": bracket_depth
                    });
                }
            } elif text == "{" {
                depth += 1;
                if in_type_hdr {
                    in_type_hdr = false;
                    block_pending_params = [];
                    block_paren_end = -1;
                    arrow_pending_params = [];
                    arrow_paren_end = -1;
                    loop_var_idx = -1;
                    class_depths.push(depth);
                    if in_enum_hdr {
                        in_enum_hdr = false;
                        enum_depths.push(depth);
                    }
                    scopes.push({
                    });
                } elif prev_sig == "=>" {
                    let asc2 = {
                    };
                    for pp in arrow_pending_params {
                        asc2[string(pp)] = true;
                    }
                    arrow_pending_params = [];
                    arrow_paren_end = -1;
                    scopes.push(asc2);
                } elif paren_depth == 0 {
                    block_paren_end = -1;
                    loop_var_idx = -1;
                    let sc = {
                    };
                    for pp in block_pending_params {
                        sc[string(pp)] = true;
                    }
                    block_pending_params = [];
                    arrow_pending_params = [];
                    arrow_paren_end = -1;
                    scopes.push(sc);
                } else {
                    scopes.push({
                    });
                }
            } elif text == "}" {
                pop_arrow_scopes(scopes, arrow_expr_scopes, paren_depth, depth, bracket_depth);
                while deferred_lets.len() > 0 and int(
                    deferred_lets[deferred_lets.len() - 1]["brace"]
                ) >= depth {
                    deferred_lets.pop();
                }
                if in_class_body(class_depths, depth) {
                    class_depths.pop();
                }
                if in_class_body(enum_depths, depth) {
                    enum_depths.pop();
                }
                if depth > 0 {
                    depth -= 1;
                }
                if scopes.len() > 0 {
                    scopes.pop();
                }
            }
            out.push(text);
            prev_sig = text;
            prev_word = text;
            i += 1;
            continue;
        }

        // identifier token
        if kind == "ident" {
            let at_class_body = in_class_body(class_depths, depth);
            let at_enum_body = in_class_body(enum_depths, depth);

            // Top-level discard `let _ = ...` -> unique `_discard_<mod>_<k>` (A-36)
            if depth == 0 and text == "_" and (prev_word == "let" or prev_word == "const") {
                discard_seq += 1;
                out.push("_discard_" + mod_id + "_" + string(discard_seq));
                prev_sig = "ident";
                prev_word = text;
                i += 1;
                continue;
            }

            // Inside enum body: keep variant identifiers unprefixed (A-51)
            if at_enum_body {
                out.push(text);
                prev_sig = "ident";
                prev_word = text;
                i += 1;
                continue;
            }

            // Inside class/interface body: keep method names and field declarations unprefixed & non-shadowing (A-37, A-50)
            if at_class_body and (prev_word == "fn" or prev_word == "let" or prev_word == "const") {
                out.push(text);
                prev_sig = "ident";
                prev_word = text;
                i += 1;
                continue;
            }

            // Bare single-param lambda `x => expr` at ANY depth (A-54, A-55)
            if prev_sig != "." {
                let nxt_ar = next_sig(toks, i + 1);
                if nxt_ar >= 0 and string(toks[nxt_ar]["text"]) == "=>" {
                    arrow_pending_params = [text];
                    arrow_paren_end = -1;
                    out.push(text);
                    prev_sig = "ident";
                    prev_word = text;
                    i += 1;
                    continue;
                }
            }

            if (text == "class" or text == "interface" or text == "enum") and depth == 0 {
                in_type_hdr = true;
                in_enum_hdr = text == "enum";
                block_pending_params = [];
                block_paren_end = -1;
                arrow_pending_params = [];
                arrow_paren_end = -1;
            } elif text == "fn" {
                block_pending_params = [];
                block_paren_end = -1;
                let n_idx = next_sig(toks, i + 1);
                if n_idx >= 0 and string(toks[n_idx]["kind"]) == "ident" {
                    let p_idx = next_sig(toks, n_idx + 1);
                    if p_idx >= 0 and string(toks[p_idx]["text"]) == "<" {
                        p_idx = skip_generics(toks, p_idx);
                    }
                    if p_idx >= 0 and string(toks[p_idx]["text"]) == "(" {
                        let c_idx = match_paren(toks, p_idx);
                        if c_idx > block_paren_end {
                            block_paren_end = c_idx;
                        }
                        for pp in collect_paren_params(toks, p_idx) {
                            block_pending_params.push(pp);
                        }
                    }
                }
            } elif at_class_body and text == "new" {
                let p_idx = next_sig(toks, i + 1);
                if p_idx >= 0 and string(toks[p_idx]["text"]) == "(" {
                    block_pending_params = [];
                    block_paren_end = -1;
                    let c_idx = match_paren(toks, p_idx);
                    if c_idx > block_paren_end {
                        block_paren_end = c_idx;
                    }
                    for pp in collect_paren_params(toks, p_idx) {
                        block_pending_params.push(pp);
                    }
                }
            }

            // Shadow variable capture inside function/block bodies (NOT class field declarations)
            if depth >= 1 and scopes.len() > 0 and not at_class_body {
                if text == "let" or text == "const" {
                    let v_idx = next_sig(toks, i + 1);
                    if v_idx >= 0 and string(toks[v_idx]["kind"]) == "ident" {
                        let vname = string(toks[v_idx]["text"]);
                        let_decl_idx = v_idx;
                        if vname != "_" {
                            deferred_lets.push({
                                "name": vname,
                                "paren": paren_depth,
                                "brace": depth,
                                "bracket": bracket_depth,
                            });
                        }
                    } elif v_idx >= 0 and string(toks[v_idx]["text"]) == "(" {
                        let c_let = match_paren(toks, v_idx);
                        let_pending_params = collect_paren_params(toks, v_idx);
                        let_paren_end = c_let;
                        for lp in let_pending_params {
                            let lps = string(lp);
                            if lps != "_" {
                                deferred_lets.push({
                                    "name": lps,
                                    "paren": paren_depth,
                                    "brace": depth,
                                    "bracket": bracket_depth,
                                });
                            }
                        }
                    }
                } elif text == "for" {
                    let nxt = next_sig(toks, i + 1);
                    if nxt >= 0 {
                        if string(toks[nxt]["kind"]) == "ident" and string(toks[nxt]["text"]) == "let" {
                            let nxt2 = next_sig(toks, nxt + 1);
                            if nxt2 >= 0 and string(toks[nxt2]["kind"]) == "ident" {
                                let lvar2 = string(toks[nxt2]["text"]);
                                if lvar2 != "_" {
                                    block_pending_params.push(lvar2);
                                }
                                loop_var_idx = nxt2;
                            }
                        } elif string(toks[nxt]["kind"]) == "ident" {
                            let lvar = string(toks[nxt]["text"]);
                            if lvar != "_" {
                                block_pending_params.push(lvar);
                            }
                            loop_var_idx = nxt;
                        } elif string(toks[nxt]["text"]) == "(" {
                            let c_for = match_paren(toks, nxt);
                            if c_for > block_paren_end {
                                block_paren_end = c_for;
                            }
                            for lp in collect_paren_params(toks, nxt) {
                                if string(lp) != "_" {
                                    block_pending_params.push(lp);
                                }
                            }
                        }
                    }
                } elif text == "catch" {
                    let nxt = next_sig(toks, i + 1);
                    if nxt >= 0 and string(toks[nxt]["text"]) == "(" {
                        let c_cat = match_paren(toks, nxt);
                        if c_cat > block_paren_end {
                            block_paren_end = c_cat;
                        }
                        for cp in collect_paren_params(toks, nxt) {
                            if string(cp) != "_" {
                                block_pending_params.push(cp);
                            }
                        }
                    } elif nxt >= 0 and string(toks[nxt]["kind"]) == "ident" {
                        let cvar = string(toks[nxt]["text"]);
                        if cvar != "_" {
                            block_pending_params.push(cvar);
                        }
                        loop_var_idx = nxt;
                    }
                }
            }

            // Keep single loop variable or local let/const declaration name unprefixed
            if i == loop_var_idx {
                loop_var_idx = -1;
                out.push(text);
                prev_sig = "ident";
                prev_word = text;
                i += 1;
                continue;
            }
            if i == let_decl_idx {
                let_decl_idx = -1;
                out.push(text);
                prev_sig = "ident";
                prev_word = text;
                i += 1;
                continue;
            }

            // Keep parameter declarations in fn/lambda/for/catch/destructuring signatures unprefixed
            let in_block_param = i <= block_paren_end and (prev_sig == "(" or prev_sig == ",") and list_has_str(block_pending_params, text);
            let in_arrow_param = i <= arrow_paren_end and (prev_sig == "(" or prev_sig == ",") and list_has_str(arrow_pending_params, text);
            let in_let_param = i <= let_paren_end and (prev_sig == "(" or prev_sig == ",") and list_has_str(let_pending_params, text);
            if in_block_param or in_arrow_param or in_let_param {
                out.push(text);
                prev_sig = "ident";
                prev_word = text;
                i += 1;
                continue;
            }

            // Named argument label `fn(arg: val)` — keep label unprefixed
            if paren_depth > 0 and prev_sig != "." {
                let col_idx = next_sig(toks, i + 1);
                if col_idx >= 0 and string(toks[col_idx]["text"]) == ":" {
                    out.push(text);
                    prev_sig = "ident";
                    prev_word = text;
                    i += 1;
                    continue;
                }
            }

            // Stdlib alias qualification `sv.compare` -> `__std_semver.compare`
            if prev_sig != "." and not is_shadowed(scopes, text) and stdlib_aliases.has(text) {
                let sd_idx = next_sig(toks, i + 1);
                if sd_idx >= 0 and string(toks[sd_idx]["text"]) == "." {
                    out.push(string(stdlib_aliases[text]));
                    prev_sig = "ident";
                    prev_word = text;
                    i += 1;
                    continue;
                }
            }

            // Check alias.member qualification & enforce module visibility (A-06)
            if prev_sig != "." and not is_shadowed(scopes, text) and (
                alias_exports.has(text) or alias_privates.has(text)
            ) {
                let d_idx = next_sig(toks, i + 1);
                if d_idx >= 0 and string(toks[d_idx]["text"]) == "." {
                    let m_idx = next_sig(toks, d_idx + 1);
                    if m_idx >= 0 and string(toks[m_idx]["kind"]) == "ident" {
                        let member = string(toks[m_idx]["text"]);
                        if alias_exports.has(text) and alias_exports[text].has(member) {
                            out.push(string(alias_exports[text][member]));
                            prev_sig = "ident";
                            prev_word = member;
                            i = m_idx + 1;
                            continue;
                        }
                        if alias_privates.has(text) and alias_privates[text].has(member) {
                            errors.push(
                                "module '" + mod_id + "' cannot access private symbol '" + member + "' of alias '" + text + "'"
                            );
                        }
                    }
                }
            }

            // Named imports `import { a, b as c } from "mod"`
            if prev_sig != "." and not is_shadowed(scopes, text) {
                if named_exports.has(text) {
                    out.push(string(named_exports[text]));
                    prev_sig = "ident";
                    prev_word = text;
                    i += 1;
                    continue;
                }
                if named_privates.has(text) {
                    errors.push(
                        "module '" + mod_id + "' cannot access private symbol '" + text + "'"
                    );
                }
            }

            // Rewrite module-local top-level symbol if not preceded by '.' and not shadowed
            if prev_sig != "." and locals.has(text) and not is_shadowed(scopes, text) {
                out.push(string(locals[text]));
                prev_sig = "ident";
                prev_word = text;
                i += 1;
                continue;
            }

            out.push(text);
            prev_sig = "ident";
            prev_word = text;
            i += 1;
            continue;
        }

        out.push(text);
        prev_sig = kind;
        prev_word = text;
        i += 1;
    }

    return out.join("");
}

const DRIVER_SRC = "public fn __studio_dispatch(ev_json: string) -> int {\n    let app = studio_app();\n    return app.wasm_run(ev_json);\n}\n\n// @@STUDIO_MAIN_START@@\nfn main() -> int {\n    return __studio_dispatch(string(STUDIO_EVENT_JSON));\n}\n";

fn find_framework_dir(ad: string) -> string {
    let vend = ad + "/vendor/studio";
    if is_dir(vend) {
        return vend;
    }
    let env_home = env("APPSTUDIO_HOME");
    if string(env_home) != "none" {
        let hfw = norm_slash(string(env_home.unwrap())) + "/frameworks/studio";
        if is_dir(hfw) {
            return hfw;
        }
    }
    for cand in ["./frameworks/studio", "../frameworks/studio", "../../frameworks/studio"] {
        if is_dir(cand) {
            return cand;
        }
    }
    return "./frameworks/studio";
}

fn rel_mod_id(ad: string, file_path: string, used_mod_ids: map) -> string {
    let prefix = ad + "/";
    let rel = file_path;
    if rel.starts_with(prefix) {
        rel = rel.slice(prefix.len(), rel.len());
    }
    if rel.ends_with(".matrix") {
        rel = rel.slice(0, rel.len() - 7);
    } elif rel.ends_with(".mt") {
        rel = rel.slice(0, rel.len() - 3);
    }
    let base = "u_" + sanitize_mod_id(rel);
    if not used_mod_ids.has(base) or string(used_mod_ids[base]) == file_path {
        used_mod_ids[base] = file_path;
        return base;
    }
    let h = hash_path(rel);
    let cand = base + "_" + h;
    let seq = 2;
    while used_mod_ids.has(cand) and string(used_mod_ids[cand]) != file_path {
        cand = base + "_" + h + "_" + string(seq);
        seq += 1;
    }
    used_mod_ids[cand] = file_path;
    return cand;
}

fn resolve_user_import(ad: string, cur_file: string, raw_path: string) -> string {
    let rp = norm_slash(raw_path);
    let cands = [];
    if rp.ends_with(".matrix") or rp.ends_with(".mt") {
        cands.push(rp);
    } else {
        cands.push(rp + ".matrix");
        cands.push(rp + ".mt");
    }
    for cand in cands {
        let c1 = clean_path(join_p(dir_of(cur_file), cand));
        if file_exists(c1) {
            return c1;
        }
        let c2 = clean_path(join_p(ad, cand));
        if file_exists(c2) {
            return c2;
        }
    }
    return "";
}

fn walk_user_module(
    ad: string,
    file_path: string,
    is_entry: bool,
    fw_exports: map,
    fw_privates: map,
    stdlib_used: map,
    visiting: map,
    visited: map,
    mod_map: map,
    used_mod_ids: map,
    user_order: list
) -> bool {
    let cp = clean_path(file_path);
    if visited.has(cp) {
        return true;
    }
    if visiting.has(cp) {
        last_bundle_error = "circular import detected involving " + cp;
        return false;
    }
    visiting[cp] = true;

    let src = read_or_fail(cp);
    if src == "" {
        last_bundle_error = "cannot read module file: " + cp;
        return false;
    }
    let mod_id = rel_mod_id(ad, cp, used_mod_ids);
    let toks = tokenize(src);
    let analysis = analyze_module(toks, mod_id, is_entry);
    let resolved_aliases = {
    };
    let resolved_privates = {
    };
    let resolved_named = {
    };
    let resolved_named_priv = {
    };
    let resolved_stdlib = {
    };

    for imp in analysis["imports"] {
        let rp = norm_slash(string(imp["path"]));
        let ikind = if imp.has("kind") {
            string(imp["kind"])
        } else {
            "ns"
        };
        let alias = string(imp["alias"]);
        let target = basename_no_ext(rp);
        let is_fw = (
            rp.starts_with("studio/") or rp.starts_with("vendor/studio/") or rp.contains("/studio/")
        ) and fw_exports.has(target);
        if is_fw {
            if ikind == "named" {
                for ni in imp["named"] {
                    let orig_n = string(ni["orig"]);
                    let local_n = string(ni["local"]);
                    if fw_exports[target].has(orig_n) {
                        resolved_named[local_n] = fw_exports[target][orig_n];
                    } elif fw_privates.has(target) and fw_privates[target].has(orig_n) {
                        resolved_named_priv[local_n] = true;
                    }
                }
            } else {
                resolved_aliases[alias] = fw_exports[target];
                if fw_privates.has(target) {
                    resolved_privates[alias] = fw_privates[target];
                }
            }
        } else {
            let dep_path = resolve_user_import(ad, cp, rp);
            if dep_path != "" {
                let ok = walk_user_module(
                    ad,
                    dep_path,
                    false,
                    fw_exports,
                    fw_privates,
                    stdlib_used,
                    visiting,
                    visited,
                    mod_map,
                    used_mod_ids,
                    user_order
                );
                if not ok {
                    return false;
                }
                if mod_map.has(dep_path) {
                    let dep_ex = mod_map[dep_path]["analysis"]["exports"];
                    let dep_pr = mod_map[dep_path]["analysis"]["privates"];
                    if ikind == "named" {
                        for ni in imp["named"] {
                            let orig_n = string(ni["orig"]);
                            let local_n = string(ni["local"]);
                            if dep_ex.has(orig_n) {
                                resolved_named[local_n] = dep_ex[orig_n];
                            } elif dep_pr.has(orig_n) {
                                resolved_named_priv[local_n] = true;
                            }
                        }
                    } else {
                        resolved_aliases[alias] = dep_ex;
                        resolved_privates[alias] = dep_pr;
                    }
                }
            } elif is_stdlib_module(rp) {
                let std_alias = "__std_" + rp;
                stdlib_used[rp] = std_alias;
                if ikind == "named" {
                    for ni in imp["named"] {
                        let orig_n = string(ni["orig"]);
                        let local_n = string(ni["local"]);
                        resolved_named[local_n] = std_alias + "." + orig_n;
                    }
                } else {
                    resolved_stdlib[alias] = std_alias;
                }
            }
        }
    }

    mod_map[cp] = {
        "file": cp,
        "toks": toks,
        "analysis": analysis,
        "aliases": resolved_aliases,
        "privates": resolved_privates,
        "named": resolved_named,
        "named_priv": resolved_named_priv,
        "stdlib": resolved_stdlib,
    };
    visited[cp] = true;
    visiting.remove(cp);
    user_order.push(cp);
    return true;
}

fn check_symbol_uniqueness(all_analyses: list) -> string {
    let seen = {
    };
    for an in all_analyses {
        let mid = string(an["mod_id"]);
        let locs = an["locals"];
        for (orig, mangled) in locs {
            let ms = string(mangled);
            if seen.has(ms) {
                return "duplicate mangled symbol '" + ms + "' (from '" + string(orig) + "' in " + mid + " and " + string(seen[ms]) + ")";
            }
            seen[ms] = mid;
        }
    }
    return "";
}

fn resolve_bundle_entry(ad: string, explicit_entry: string) -> string {
    if explicit_entry != "" {
        let ep = clean_path(explicit_entry);
        if file_exists(ep) {
            return ep;
        }
        let ep2 = clean_path(join_p(ad, explicit_entry));
        if file_exists(ep2) {
            return ep2;
        }
        last_bundle_error = "entry file not found: " + explicit_entry;
        return "";
    }
    let app_p = clean_path(join_p(ad, "app.matrix"));
    if file_exists(app_p) {
        return app_p;
    }
    let app_mt = clean_path(join_p(ad, "app.mt"));
    if file_exists(app_mt) {
        return app_mt;
    }
    let manifest_entry = "";
    let mf_r = read_file(clean_path(join_p(ad, "studio.json")));
    if mf_r.is_ok() {
        try {
            let mf = json_parse(string(mf_r.unwrap()).trim());
            if type_of(mf) == "map" and mf.has("entry") {
                manifest_entry = string(mf["entry"]).trim();
                if manifest_entry != "" {
                    let cand = clean_path(join_p(ad, manifest_entry));
                    if file_exists(cand) {
                        return cand;
                    }
                }
            }
        } catch (_e) {
            let _ = _e;
        }
    }
    let main_p = clean_path(join_p(ad, "main.matrix"));
    if file_exists(main_p) {
        return main_p;
    }
    let main_mt = clean_path(join_p(ad, "main.mt"));
    if file_exists(main_mt) {
        return main_mt;
    }
    if manifest_entry != "" {
        last_bundle_error = "missing app entry file in " + ad + " (studio.json entry '" + manifest_entry + "' and app.matrix not found)";
    } else {
        last_bundle_error = "missing app entry file in " + ad + " (expected app.matrix)";
    }
    return "";
}

/// Flatten the app at appdir with an explicit entry file (or "" to auto-resolve).
/// Returns "" on failure and populates last_error().
public fn bundle_entry(appdir: string, entry_file: string = "") -> string {
    last_bundle_error = "";
    last_line_map = [];
    let ad = norm_slash(appdir);
    let fw = find_framework_dir(ad);
    let fw_order = [
    "Util", "Errors", "Store", "Theme", "State", "Storage", "Router",
    "I18n", "Bridge", "Components", "CSS", "Render", "ClientJS", "App", "Http",
    ];

    // Pass 1: load, lex, and analyze all framework modules
    let fw_toks = {
    };
    let fw_analysis = {
    };
    let fw_exports = {
    };
    let fw_privates = {
    };
    let all_analyses = [];
    for name in fw_order {
        let fpath = fw + "/" + name + ".matrix";
        let src = read_or_fail(fpath);
        if src == "" {
            last_bundle_error = "missing framework module: " + fpath;
            return "";
        }
        let toks = tokenize(src);
        let an = analyze_module(toks, name, false);
        fw_toks[name] = toks;
        fw_analysis[name] = an;
        fw_exports[name] = an["exports"];
        fw_privates[name] = an["privates"];
        all_analyses.push(an);
    }

    // Pass 2: walk user module dependency graph starting from resolved entry
    let entry_path = resolve_bundle_entry(ad, entry_file);
    if entry_path == "" {
        return "";
    }
    let visiting = {
    };
    let visited = {
    };
    let mod_map = {
    };
    let used_mod_ids = {
    };
    let stdlib_used = {
    };
    let user_order = [];
    if not walk_user_module(
        ad,
        entry_path,
        true,
        fw_exports,
        fw_privates,
        stdlib_used,
        visiting,
        visited,
        mod_map,
        used_mod_ids,
        user_order
    ) {
        return "";
    }

    for upath in user_order {
        all_analyses.push(mod_map[upath]["analysis"]);
    }
    let uniq_err = check_symbol_uniqueness(all_analyses);
    if uniq_err != "" {
        last_bundle_error = uniq_err;
        return "";
    }

    // Pass 3: emit flattened output in a single scope-aware pass per module
    // Spid3r grammar requires all top-level `import` statements to precede declarations.
    let chunks = [
    "// AppStudio flat bundle (generated by FlatKit — do not edit)\n",
    "// The host substitutes the sentinel envelope line below per eval.\n",
    ];
    if stdlib_used.len() > 0 {
        let std_names = [];
        for (sn, _sa) in stdlib_used {
            std_names.push(string(sn));
        }
        std_names.sort();
        for sn in std_names {
            chunks.push("import \"" + sn + "\" as " + string(stdlib_used[sn]) + ";\n");
        }
    }
    chunks.push("\nlet STUDIO_EVENT_JSON = \"\";\n\n");
    let cur_line = 1;
    for hc in chunks {
        cur_line += count_newlines(string(hc));
    }
    let emit_errors = [];

    for name in fw_order {
        let an = fw_analysis[name];
        let aliases = {
        };
        let aprivs = {
        };
        for imp in an["imports"] {
            let target = basename_no_ext(string(imp["path"]));
            let alias = string(imp["alias"]);
            if fw_exports.has(target) {
                aliases[alias] = fw_exports[target];
                aprivs[alias] = fw_privates[target];
            }
        }
        let emitted = emit_tokens(fw_toks[name], an["imports"], an["locals"], aliases, aprivs, {
        }, {
        }, {
        }, [], 0, name, emit_errors);
        let start_l = cur_line;
        let end_l = start_l + count_newlines(emitted);
        last_line_map.push({
            "file": "studio/" + name + ".matrix",
            "mod_id": name,
            "start_line": start_l,
            "end_line": end_l,
        });
        chunks.push(emitted);
        chunks.push("\n\n");
        cur_line = end_l + 2;
    }

    for upath in user_order {
        let rec = mod_map[upath];
        let uan = rec["analysis"];
        let u_emitted = emit_tokens(
            rec["toks"],
            uan["imports"],
            uan["locals"],
            rec["aliases"],
            rec["privates"],
            rec["named"],
            rec["named_priv"],
            rec["stdlib"],
            [],
            0,
            string(uan["mod_id"]),
            emit_errors
        );
        let u_start = cur_line;
        let u_end = u_start + count_newlines(u_emitted);
        last_line_map.push({
            "file": upath,
            "mod_id": string(uan["mod_id"]),
            "start_line": u_start,
            "end_line": u_end,
        });
        chunks.push(u_emitted);
        chunks.push("\n\n");
        cur_line = u_end + 2;
    }

    if emit_errors.len() > 0 {
        last_bundle_error = emit_errors.join("; ");
        return "";
    }

    chunks.push(DRIVER_SRC);
    return chunks.join("");
}

/// Flatten the app at appdir into one source (framework + user module graph + driver).
/// Returns "" on failure and populates last_error().
public fn bundle(appdir: string) -> string {
    return bundle_entry(appdir, "");
}
